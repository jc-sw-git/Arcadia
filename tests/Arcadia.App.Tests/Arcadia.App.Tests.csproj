<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are programs of their own. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.5" />
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3 as a test sets it up, shared with the unit tests of the gamepad source. -->
    <Compile Include="..\Arcadia.Core.Tests\FakeSdlGamepads.cs" Link="FakeSdlGamepads.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeVirtualXboxPads.cs" Link="FakeVirtualXboxPads.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeEmulationGuardian.cs" Link="FakeEmulationGuardian.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeSteamControllerHold.cs" Link="FakeSteamControllerHold.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeSisrPc.cs" Link="FakeSisrPc.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeElevatedPan.cs" Link="FakeElevatedPan.cs" />
    <!-- Steam's appinfo.vdf as the Steam fixture writes it (#141). -->
    <Compile Include="..\Arcadia.Core.Tests\AppInfoFile.cs" Link="Fixtures\AppInfoFile.cs" />
    <Compile Include="..\Arcadia.Core.Tests\PackageInfoFile.cs" Link="Fixtures\PackageInfoFile.cs" />
    <!-- Steam's web API for the Steam account (#83). -->
    <Compile Include="..\Arcadia.Core.Tests\FakeSteamWeb.cs" Link="Fixtures\FakeSteamWeb.cs" />
    <!-- Steam's image server and made-up images for the artwork (#487). -->
    <Compile Include="..\Arcadia.Core.Tests\Artwork\FakeImageServer.cs" Link="Fixtures\FakeImageServer.cs" />
    <Compile Include="..\Arcadia.Core.Tests\Artwork\FakeSteamGridDb.cs" Link="Fixtures\FakeSteamGridDb.cs" />
    <Compile Include="..\Arcadia.Core.Tests\Artwork\TestImages.cs" Link="Fixtures\TestImages.cs" />
    <Compile Include="..\Arcadia.Core.Tests\Metadata\FakeStore.cs" Link="Fixtures\FakeStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arcadia.App\Arcadia.App.csproj" />
  </ItemGroup>

</Project>
