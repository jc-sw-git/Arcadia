<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:Arcadia.App"
        xmlns:ctl="using:Arcadia.App.Controls"
        x:Class="Arcadia.App.Views.MouseModeOverlay"
        Title="{x:Static app:AppTexts.MouseModeWindowTitle}"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        Focusable="False">

  <!-- Feedback for Back + Start and for View held (#64), over everything on the primary monitor. It never takes the focus or a click. -->
  <Panel IsHitTestVisible="False">
    <ctl:ScreenEdgeFill x:Name="Edge" />
    <Border x:Name="Label" Classes="mouseModeLabel" IsVisible="False">
      <TextBlock x:Name="LabelText" />
    </Border>
    <!-- View held: the box announces the way back, its frame fills over the hold time. -->
    <Panel x:Name="ReturnBox" Classes="returnBox" IsVisible="False">
      <Border Classes="mouseModeLabel">
        <TextBlock Text="{x:Static app:AppTexts.BackToArcadia}" />
      </Border>
      <ctl:ScreenEdgeFill x:Name="ReturnEdge" Classes="returnEdge" />
    </Panel>
  </Panel>
</Window>
