<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Arcadia.Launchers.Abstractions\Arcadia.Launchers.Abstractions.csproj" />
    <ProjectReference Include="..\Arcadia.Platform\Arcadia.Platform.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Arcadia.Core.Tests" />
    <InternalsVisibleTo Include="Arcadia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Steam's store tags by id, in German (#493): the names appinfo.vdf's tag ids need, without a request. -->
    <EmbeddedResource Include="Steam\steam-tags-german.json" LogicalName="Arcadia.Launchers.Steam.steam-tags-german.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <HasUiTexts>true</HasUiTexts>
    <!-- Required by the LibraryImport source generator (process paths, foreground window). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
