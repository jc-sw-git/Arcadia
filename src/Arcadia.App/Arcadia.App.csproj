<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The installed program is "Arcadia.exe"; namespaces stay Arcadia.App. -->
    <AssemblyName>Arcadia</AssemblyName>
    <ApplicationIcon>Assets\arcadia.ico</ApplicationIcon>
    <!-- Required by the LibraryImport source generator (user32 calls). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The acceptance tests point the log at a folder of their own (AppLog.Directory). -->
    <InternalsVisibleTo Include="Arcadia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPL-3.0: the licence and third-party notices ship with every build and installer. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcadia.Core\Arcadia.Core.csproj" />
    <ProjectReference Include="..\Arcadia.Launchers\Arcadia.Launchers.csproj" />
    <ProjectReference Include="..\Arcadia.Input\Arcadia.Input.csproj" />
    <ProjectReference Include="..\Arcadia.ControllerSupport\Arcadia.ControllerSupport.csproj" />
  </ItemGroup>
</Project>
