<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The installed program is "Arcadia.exe"; namespaces stay Arcadia.App. -->
    <AssemblyName>Arcadia</AssemblyName>
    <ApplicationIcon>Assets\arcadia.ico</ApplicationIcon>
    <!-- Required by the LibraryImport source generator (user32 calls). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The acceptance tests point the log at a folder of their own (AppLog.Directory). -->
    <InternalsVisibleTo Include="Arcadia.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- GPL-3.0: the licence and third-party notices ship with every build and installer. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <!-- Keep in step with the vpk tool in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <!--
    A Debug build on Windows gets Pan\Pan.exe beside Arcadia.dll, as the installer ships it (tools/release/Pack.ps1),
    so "Treiber installieren" works from the IDE: a single-file, framework-dependent Pan (not AOT, that takes minutes).
    Skipped when nothing of Pan changed; ArcadiaSkipPan=true skips it altogether.
  -->
  <ItemGroup>
    <PanSource Include="..\Arcadia.Pan\**\*.cs;..\Arcadia.Pan\*.csproj;..\Arcadia.Pan.Core\**\*.cs;..\Arcadia.Pan.Core\*.csproj" Exclude="..\Arcadia.Pan\obj\**;..\Arcadia.Pan\bin\**;..\Arcadia.Pan.Core\obj\**;..\Arcadia.Pan.Core\bin\**" />
  </ItemGroup>
  <Target Name="PublishPanForDebug" AfterTargets="Build" Inputs="@(PanSource)" Outputs="$(OutDir)Pan\Pan.exe"
          Condition="'$(Configuration)' == 'Debug' and $([MSBuild]::IsOSPlatform('Windows')) and '$(DesignTimeBuild)' != 'true' and '$(ArcadiaSkipPan)' != 'true'">
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\Arcadia.Pan\Arcadia.Pan.csproj&quot; -c Release -r win-x64 --self-contained false -p:PublishAot=false -p:PublishSingleFile=true -o &quot;$(OutDir)Pan&quot; -nologo -v q" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Arcadia.Core\Arcadia.Core.csproj" />
    <ProjectReference Include="..\Arcadia.Launchers\Arcadia.Launchers.csproj" />
    <ProjectReference Include="..\Arcadia.Input\Arcadia.Input.csproj" />
    <ProjectReference Include="..\Arcadia.ControllerSupport\Arcadia.ControllerSupport.csproj" />
  </ItemGroup>
</Project>
