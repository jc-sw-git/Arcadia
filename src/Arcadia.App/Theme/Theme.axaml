  <!-- Values: a radio per line ("Installiert") or a checkbox in the grid ("Typ"); greyed out without hits, still choosable. -->
  <Style Selector="Button.filterOption, Button.filterValue">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
