<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcadia.App.ViewModels"
        xmlns:ctl="using:Arcadia.App.Controls"
        xmlns:views="using:Arcadia.App.Views"
        x:Class="Arcadia.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Arcadia"
        Icon="/Assets/arcadia.ico"
        Width="1600" Height="900"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">

  <!-- The Big Picture layout is designed for 1920×1080 and scaled to the window. -->
  <Viewbox Stretch="Uniform">
    <Grid Width="1920" Height="1080" RowDefinitions="104,72,*,72" Background="{StaticResource Bg}">

      <!-- Header: logo, launcher tabs, status -->
      <Grid Grid.Row="0" Margin="80,0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="24">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Path Data="M4 30V16a13 13 0 0 1 26 0v14 M11 30v-8h12v8" Stroke="{StaticResource Accent}" StrokeThickness="3"
                StrokeLineCap="Round" StrokeJoin="Round" Width="34" Height="34" />
          <TextBlock Text="ARCADIA" FontSize="24" FontWeight="ExtraBold" LetterSpacing="1.4" VerticalAlignment="Center" />
        </StackPanel>

        <Grid Grid.Column="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalAlignment="Center">
          <Button Classes="plain glyphButton" Content="LB" Command="{Binding PreviousTabCommand}" ToolTip.Tip="Vorheriger Launcher (Q)" />
          <Panel Grid.Column="1">
            <ScrollViewer Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Name="TabList" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LauncherTabViewModel">
                    <Button Classes="plain tab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{Binding TileBrush}" ClipToBounds="True">
                          <TextBlock Text="{Binding Monogram}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <Border IsVisible="{Binding IsSelected}" Background="{StaticResource Bg}" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Count}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
                        </Border>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Shown only when tabs continue beyond the visible area. -->
            <Border Name="TabEdgeLeft" IsVisible="False" Width="96" HorizontalAlignment="Left" IsHitTestVisible="True" Background="{StaticResource TabEdgeLeft}">
              <Button Name="TabScrollLeft" Classes="plain" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Left"
                      Background="{StaticResource SurfaceRaised}" ToolTip.Tip="Weitere Launcher links">
                <Path Data="M15 5l-7 7 7 7" Stroke="{StaticResource TextStrong}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="None" />
              </Button>
            </Border>
            <Border Name="TabEdgeRight" IsVisible="False" Width="96" HorizontalAlignment="Right" Background="{StaticResource TabEdgeRight}">
              <Button Name="TabScrollRight" Classes="plain" Width="40" Height="40" CornerRadius="20" HorizontalAlignment="Right"
                      Background="{StaticResource SurfaceRaised}" ToolTip.Tip="Weitere Launcher rechts">
                <Path Data="M9 5l7 7-7 7" Stroke="{StaticResource TextStrong}" StrokeThickness="2.5" StrokeLineCap="Round" StrokeJoin="Round" Width="20" Height="20" Stretch="None" />
              </Button>
            </Border>
          </Panel>
          <Button Grid.Column="2" Classes="plain glyphButton" Content="RB" Command="{Binding NextTabCommand}" ToolTip.Tip="Nächster Launcher (E)" />
        </Grid>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Status.IsControllerStarting}" VerticalAlignment="Center"
                      ToolTip.Tip="SISR startet und richtet den Steam Controller als Xbox-360-Controller ein">
            <Path Classes="spinner" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
            <TextBlock Text="Controller wird eingerichtet …" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasControllerWarning}" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding Status.ControllerWarningText}">
            <Path Data="M12 3.5L2.5 20h19z M12 10v4.5 M12 17.2v.3" Stroke="{StaticResource Warning}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="None" />
          </Button>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasSisrUpdate}" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Neue SISR-Version verfügbar">
            <Path Data="M20 12a8 8 0 1 1 -2.3 -5.6 M20 4v4.5h-4.5" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="None" />
          </Button>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasArcadiaUpdate}" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="{Binding Status.ArcadiaUpdateText}">
            <Panel Width="24" Height="24">
              <Path Data="M20 12a8 8 0 1 1 -2.3 -5.6 M20 4v4.5h-4.5" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="24" Height="24" Stretch="None" />
              <!-- The dot tells Arcadia's own update apart from SISR's. -->
              <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Stroke="{StaticResource Bg}" StrokeThickness="2"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
            </Panel>
          </Button>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Einstellungen (F2)">
            <Path Data="M4 7h10 M18 7h2 M4 17h4 M12 17h8 M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
                  Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" />
          </Button>
          <TextBlock Text="{Binding Status.Date}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status.Clock}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Toolbar: current tab and view options -->
      <Grid Grid.Row="1" Margin="80,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsLibraryShown}">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTab.Name, FallbackValue=''}" FontSize="34" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CountText}" FontSize="18" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Classes="plain toolbar" Command="{Binding OpenViewOptionsCommand}" IsVisible="{Binding SelectedTab, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Border Classes="glyph round"><TextBlock Text="Y" /></Border>
            <TextBlock Text="{Binding ViewSummary}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Detail page: path back, position in the list and the sort order -->
      <Grid Grid.Row="1" Margin="80,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsDetailOpen}">
        <Button Classes="plain" HorizontalAlignment="Left" Command="{Binding CloseDetailCommand}" ToolTip.Tip="Zurück zur Bibliothek (Esc)">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <Border Classes="glyph round"><TextBlock Text="B" /></Border>
            <TextBlock Classes="crumb" Text="Bibliothek" />
            <TextBlock Classes="crumb separator" Text="/" />
            <TextBlock Classes="crumb" Text="{Binding Detail.TabName, FallbackValue=''}" />
            <TextBlock Classes="crumb separator" Text="/" />
            <TextBlock Classes="crumb current" Text="{Binding Detail.Current.Tile.Title, FallbackValue=''}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
          <TextBlock Text="{Binding Detail.PositionText, FallbackValue=''}" FontSize="17" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <Button Classes="plain toolbar" Command="{Binding OpenViewOptionsCommand}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Border Classes="glyph round"><TextBlock Text="Y" /></Border>
              <TextBlock Text="{Binding Detail.SortLabel, FallbackValue=''}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Panel Grid.Row="2" IsVisible="{Binding IsDetailOpen}">
        <views:GameDetailView DataContext="{Binding Detail}" />
      </Panel>

      <!-- Body: preview panel and cover grid -->
      <Grid Grid.Row="2" ColumnDefinitions="400,*" Margin="80,0,0,0" ColumnSpacing="40" IsVisible="{Binding IsLibraryShown}">

        <Border Classes="preview" Classes.holding="{Binding FocusedGame.IsHolding, FallbackValue=False}" Background="{StaticResource Surface}" CornerRadius="16" ClipToBounds="True" Margin="0,18,0,16"
                IsVisible="{Binding FocusedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Panel>
            <Grid RowDefinitions="180,*" DataContext="{Binding FocusedGame}" x:DataType="vm:GameTileViewModel">
              <Panel Background="{Binding CoverBrush}">
                <TextBlock Text="{Binding Monogram}" FontSize="140" FontWeight="ExtraBold" Foreground="{Binding AccentBrush}" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0" />
                <Border Classes="shade" CornerRadius="0" IsVisible="{Binding !IsInstalled}" />
                <Border Classes="installBadge" IsVisible="{Binding ShowInstallBadge}" CornerRadius="16" Height="32" Padding="10,0,14,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="M7 17a4 4 0 0 1-.6-7.95A6 6 0 0 1 17.8 8.5 4 4 0 0 1 17 16.9M12 11v9M9 17l3 3 3-3" Stroke="{StaticResource TextSoft}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Nicht installiert" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Panel>
              <DockPanel Grid.Row="1" Margin="24,22,24,24">
                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Button Classes="plain primary" HorizontalAlignment="Stretch" Command="{Binding ActivateCommand}" IsEnabled="{Binding CanActivate}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Classes="glyph round dark"><TextBlock Text="A" /></Border>
                        <TextBlock Text="{Binding PrimaryActionText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                    <Button Grid.Column="1" Classes="plain secondary" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).OpenMenuCommand}"
                            ToolTip.Tip="Weitere Aktionen (⧉ oder Rechtsklick auf ein Cover)">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Classes="glyph"><TextBlock Text="⧉" /></Border>
                        <TextBlock Text="Optionen" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </Grid>
                  <TextBlock IsVisible="{Binding UpdateAvailable}" Classes="actionHint">
                    <Run Text="{Binding LauncherName}" /><Run Text=" installiert das Update ggf. vor dem Start" />
                  </TextBlock>
                  <TextBlock IsVisible="{Binding ShowInstallBadge}" Classes="actionHint">
                    <Run Text="Die Installation wird in " /><Run Text="{Binding LauncherName}" /><Run Text=" geöffnet" />
                  </TextBlock>
                  <TextBlock IsVisible="{Binding ShowLauncherControlsHint}" Classes="actionHint">
                    <Run Text="Pausieren und Abbrechen in " /><Run Text="{Binding LauncherName}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Spacing="20">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="ExtraBold" TextWrapping="Wrap" />
                    <!-- A status, not a control: plain text, no pill that could pass for a button. -->
                    <StackPanel IsVisible="{Binding UpdateAvailable}" Orientation="Horizontal" Spacing="8">
                      <Path Data="M21 12a9 9 0 0 0-15-6.7L3 8M3 3v5h5M3 12a9 9 0 0 0 15 6.7l3-2.7M21 21v-5h-5" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="Update verfügbar" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding IsInstallActive}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Path Classes="spinner" IsVisible="{Binding IsInstallSpinning}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <Path IsVisible="{Binding IsInstallQueued}" Data="M6 3h12M6 21h12M8 3v3.5l4 5.5-4 5.5v3.5M16 3v3.5l-4 5.5 4 5.5v3.5" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <Path IsVisible="{Binding IsInstallPaused}" Data="M9 6v12M15 6v12" Stroke="{StaticResource Warning}" StrokeThickness="2.8" StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding InstallStatusText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Classes="install large" Classes.paused="{Binding IsInstallPaused}" Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="18" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="label" Text="ZULETZT GESPIELT" />
                      <TextBlock Classes="value" Text="{Binding LastPlayedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Classes="label" Text="SPIELZEIT" />
                      <TextBlock Classes="value" Text="{Binding PlaytimeText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="3">
                      <TextBlock Classes="label" Text="INSTALLATIONSGRÖSSE" />
                      <TextBlock Classes="value" Text="{Binding SizeText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                      <TextBlock Classes="label" Text="LAUNCHER" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{Binding LauncherBrush}">
                          <TextBlock Text="{Binding LauncherMonogram}" FontSize="11" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Classes="value" Text="{Binding LauncherName}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                      <TextBlock Classes="label" Text="SPEICHERORT" />
                      <TextBlock Text="{Binding LocationText}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).ShowControllerSupport}">
                    <TextBlock Classes="label" Text="STEAM CONTROLLER" />
                    <!-- A plain value, not a dropdown: the mouse click switches it; the controller gets it with #10. -->
                    <Button Classes="plain modeValue" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CycleControllerSupportCommand}"
                            ToolTip.Tip="Klicken wechselt zwischen „Xbox 360 Controller (SISR)“ und „Steam Input“">
                      <TextBlock Classes="value" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext).FocusedControllerSupportText}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Grid>
            <!-- Fills while A is held; full opens the detail page. -->
            <ctl:HoldRing />
          </Panel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,64">
          <ScrollViewer Name="GridScroller" VerticalScrollBarVisibility="Auto" Padding="6,8,70,8">
            <ItemsControl Name="GameGrid" ItemsSource="{Binding PageGames}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameTileViewModel">
                  <Button Classes="plain tile" Classes.focused="{Binding IsFocused}" Command="{Binding FocusCommand}"
                          Background="{Binding CoverBrush}" Height="215" ToolTip.Tip="{Binding Title}">
                    <Panel>
                      <Border Classes="shade" IsVisible="{Binding !IsInstalled}" />
                      <Grid RowDefinitions="*,Auto" Margin="12">
                        <TextBlock Text="{Binding Monogram}" FontSize="56" FontWeight="ExtraBold" Foreground="{Binding AccentBrush}" Classes.dim="{Binding !IsInstalled}" />
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Border Classes="installBadge" IsVisible="{Binding ShowInstallBadge}" Width="30" Height="30" CornerRadius="15"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Nicht installiert – A installiert">
                        <Path Data="M7 17a4 4 0 0 1-.6-7.95A6 6 0 0 1 17.8 8.5 4 4 0 0 1 17 16.9M12 11v9M9 17l3 3 3-3" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                      </Border>
                      <Border Classes="installBadge" IsVisible="{Binding UpdateAvailable}" Width="30" Height="30" CornerRadius="15"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Update verfügbar">
                        <Path Data="M21 12a9 9 0 0 0-15-6.7L3 8M3 3v5h5M3 12a9 9 0 0 0 15 6.7l3-2.7M21 21v-5h-5" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                      </Border>
                      <Border Classes="installBadge" IsVisible="{Binding IsInstallActive}" Height="30" CornerRadius="15" Padding="8,0,11,0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding InstallStatusText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="spinner" IsVisible="{Binding IsInstallSpinning}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                          <Path IsVisible="{Binding IsInstallQueued}" Data="M6 3h12M6 21h12M8 3v3.5l4 5.5-4 5.5v3.5M16 3v3.5l-4 5.5 4 5.5v3.5" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                          <Path IsVisible="{Binding IsInstallPaused}" Data="M9 6v12M15 6v12" Stroke="{StaticResource Warning}" StrokeThickness="2.8" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding InstallShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <ProgressBar Classes="install" Classes.paused="{Binding IsInstallPaused}" IsVisible="{Binding IsInstallActive}"
                                   Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}"
                                   VerticalAlignment="Bottom" Margin="0" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Covers cut off at an edge fade out there, but only where the grid can still scroll
               that way (#102). Shown from MainWindow.axaml.cs; the scroll bar stays uncovered. They reach
               2 px past the grid: at a scaled window size the grid's clip and the fade's edge round to
               different pixels, which left a line of unfaded covers. -->
          <Border Name="GridFadeTop" Classes="listFade" VerticalAlignment="Top" Margin="0,-2,64,0" Background="{StaticResource ListFadeTop}" />
          <Border Name="GridFadeBottom" Classes="listFade" VerticalAlignment="Bottom" Margin="0,0,64,-2" Background="{StaticResource ListFadeBottom}" />

          <Panel Grid.Row="1" Margin="0,0,80,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Classes="plain glyphButton" Content="LT" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Vorherige Seite (Bild ↑ oder Umschalt+←)" />
              <ItemsControl ItemsSource="{Binding PageButtons}" Margin="10,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PageButtonViewModel">
                    <Panel>
                      <TextBlock IsVisible="{Binding IsEllipsis}" Text="…" Width="28" TextAlignment="Center" FontWeight="Bold"
                                 Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                      <Button IsVisible="{Binding IsPage}" Classes="plain page" Classes.current="{Binding IsCurrent}"
                              Content="{Binding Label}" Command="{Binding GoCommand}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="plain glyphButton" Content="RT" Command="{Binding NextPageCommand}" ToolTip.Tip="Nächste Seite (Bild ↓ oder Umschalt+→)" />
            </StackPanel>
            <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextMuted}" />
          </Panel>
        </Grid>

        <!-- Loading / empty states -->
        <TextBlock Grid.ColumnSpan="2" IsVisible="{Binding IsLoading}" Text="Bibliothek wird geladen …" FontSize="22"
                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <StackPanel Grid.ColumnSpan="2" IsVisible="{Binding IsEmpty}" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
          <TextBlock Text="Keine Spiele gefunden" FontSize="30" FontWeight="ExtraBold" HorizontalAlignment="Center" />
          <TextBlock Text="Arcadia hat keinen unterstützten Launcher mit installierten Spielen gefunden. Zum Ausprobieren: Arcadia mit --demo starten."
                     FontSize="18" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Footer: button hints -->
      <Border Grid.Row="3" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="80,0">
        <Panel>
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsDetailOpen}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
            <TextBlock Classes="hint" Text="Aktion wählen" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="A" /></Border>
            <TextBlock Classes="hint" Text="Auswählen" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="Y" /></Border>
            <TextBlock Classes="hint" Text="Ansicht" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="LB" /></Border>
            <Border Classes="glyph"><TextBlock Text="RB" /></Border>
            <TextBlock Classes="hint" Text="Launcher" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="LT" /></Border>
            <Border Classes="glyph"><TextBlock Text="RT" /></Border>
            <TextBlock Classes="hint" Text="Spiel" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="B" /></Border>
            <TextBlock Classes="hint" Text="Zurück" />
          </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsLibraryShown}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="A" /></Border>
            <TextBlock Classes="hint" Text="{Binding FocusedGame.PrimaryActionText, FallbackValue='Spielen'}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="A" /></Border>
            <TextBlock Classes="hint" Text="halten: Details" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="⧉" /></Border>
            <TextBlock Classes="hint" Text="Optionen" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph round"><TextBlock Text="Y" /></Border>
            <TextBlock Classes="hint" Text="Ansicht" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="LB" /></Border>
            <Border Classes="glyph"><TextBlock Text="RB" /></Border>
            <TextBlock Classes="hint" Text="Launcher" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="LT" /></Border>
            <Border Classes="glyph"><TextBlock Text="RT" /></Border>
            <TextBlock Classes="hint" Text="Seite" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="glyph"><TextBlock Text="≡" /></Border>
            <TextBlock Classes="hint" Text="Einstellungen" />
          </StackPanel>
        </StackPanel>
        </Panel>
      </Border>

      <!-- Toast -->
      <Border Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding Toast.IsVisible}" Background="{StaticResource SurfaceRaised}" CornerRadius="14"
              Padding="24,14" Margin="0,0,0,96" HorizontalAlignment="Center" VerticalAlignment="Bottom" BoxShadow="{StaticResource ToastShadow}">
        <TextBlock Text="{Binding Toast.Text}" FontSize="18" FontWeight="SemiBold" />
      </Border>

      <!-- "Ansicht" dialog -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsViewOptionsOpen}">
        <Button Classes="plain" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseViewOptionsCommand}" />
        <Border Width="820" Background="{StaticResource Surface}" CornerRadius="20" Padding="56,48,56,36"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{StaticResource DialogShadow}">
          <StackPanel Spacing="40" DataContext="{Binding ViewOptions}" x:DataType="vm:ViewOptionsViewModel">
            <StackPanel Spacing="8">
              <TextBlock Text="Ansicht" FontSize="34" FontWeight="ExtraBold" />
              <TextBlock FontSize="17" Foreground="{StaticResource TextMuted}"
                         Text="Sortierung und Einträge pro Seite, gültig für alle Launcher" />
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="SORTIEREN NACH" FontSize="14" />
              <ItemsControl ItemsSource="{Binding SortRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SortRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                      <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="{StaticResource Bg}" CornerRadius="26" Padding="4">
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionViewModel">
                              <Button Classes="plain segment" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                                      Content="{Binding Label}" Command="{Binding ApplyCommand}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="EINTRÄGE PRO SEITE" FontSize="14" />
              <ItemsControl ItemsSource="{Binding PageSizeOptions}" Margin="-6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionViewModel">
                    <Button Classes="plain size" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                            Content="{Binding Label}" Command="{Binding ApplyCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PageSizeNote}" FontSize="16" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
              <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
                  <TextBlock Classes="hint" Text="Wechseln" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                  <TextBlock Classes="hint" Text="Auswählen" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                  <TextBlock Classes="hint" Text="Schließen" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Context menu of the focused game, anchored next to its cover (placed in MainWindow.axaml.cs). -->
      <Panel Name="GameMenuLayer" Grid.RowSpan="4" IsVisible="{Binding IsGameMenuOpen}">
        <Button Classes="plain" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseMenuCommand}" />
        <Border Name="GameMenuPanel" Width="420" Background="{StaticResource Surface}" CornerRadius="16" Padding="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" BoxShadow="{StaticResource DialogShadow}">
          <StackPanel Spacing="2" DataContext="{Binding GameMenu}" x:DataType="vm:GameMenuViewModel">
            <TextBlock Classes="label" Text="{Binding Title}" FontSize="14" Margin="16,10,16,12" TextTrimming="CharacterEllipsis" />
            <ItemsControl ItemsSource="{Binding Actions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameActionViewModel">
                  <StackPanel>
                    <Border IsVisible="{Binding StartsGroup}" Height="1" Background="{StaticResource Line}" Margin="8,6" />
                    <Button Classes="plain menuItem" Classes.focused="{Binding IsFocused}" Classes.danger="{Binding IsDanger}" IsEnabled="{Binding IsEnabled}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).InvokeMenuActionCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="24,*" ColumnSpacing="14">
                        <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="24" Height="24" Stretch="None" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" Margin="8,10,8,2">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                <TextBlock Classes="hint" Text="Auswählen" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                <TextBlock Classes="hint" Text="Schließen" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Asks before an action that can't be undone from Arcadia (uninstalling). -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsConfirmationOpen}">
        <Button Classes="plain" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CancelConfirmationCommand}" />
        <Border Width="680" Background="{StaticResource Surface}" CornerRadius="20" Padding="48,40,48,32"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{StaticResource DialogShadow}">
          <StackPanel Spacing="28" DataContext="{Binding Confirmation}" x:DataType="vm:ConfirmationViewModel">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="ExtraBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="plain action danger" Classes.focused="{Binding IsConfirmFocused}" Content="{Binding ConfirmLabel}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).ConfirmCommand}" />
              <Button Classes="plain action" Classes.focused="{Binding IsCancelFocused}" Content="Abbrechen"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).CancelConfirmationCommand}" />
            </StackPanel>
            <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
              <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
                  <TextBlock Classes="hint" Text="Wechseln" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                  <TextBlock Classes="hint" Text="Auswählen" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                  <TextBlock Classes="hint" Text="Abbrechen" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Settings dialog -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsSettingsOpen}">
        <Button Classes="plain" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseSettingsCommand}" />
        <Border Width="1040" MaxHeight="1000" Background="{StaticResource Surface}" CornerRadius="20" Padding="56,40,56,32"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{StaticResource DialogShadow}">
          <!-- The button hints stay visible below the scrolling content. -->
          <DockPanel>
          <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,24,0,0" Margin="0,24,0,0">
            <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
                <TextBlock Classes="hint" Text="Wechseln" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                <TextBlock Classes="hint" Text="Auswählen" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                <TextBlock Classes="hint" Text="Schließen" />
              </StackPanel>
            </StackPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
          <!-- While Steam or SISR starts, the dialog takes no clicks (the controller is blocked in the view model). -->
          <StackPanel Spacing="32" DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" IsHitTestVisible="{Binding !IsWorking}">
            <StackPanel Spacing="8">
              <TextBlock Text="Einstellungen" FontSize="34" FontWeight="ExtraBold" />
              <TextBlock Text="Weitere Bereiche aus den Entwürfen folgen." FontSize="17" Foreground="{StaticResource TextMuted}" />
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="CONTROLLER" FontSize="14" />
              <Border Background="{StaticResource SurfaceSunken}" CornerRadius="16" Padding="8">
                <StackPanel Spacing="4">
                  <Button Classes="plain settingRow" Classes.focused="{Binding ToggleItem.IsFocused}" Classes.unavailable="{Binding IsUnavailable}"
                          Command="{Binding ToggleCommand}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Steam Controller als Xbox 360 Gamepad verwenden" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="Mit dieser Einstellung wird der Steam Controller als Xbox 360 Gamepad behandelt. Das ist nützlich, wenn du den Steam Controller auch in Spielen außerhalb von Steam (oder in Arcadia) benutzen möchtest, da er dort sonst im „Desktop-Modus“ läuft. Dies ist eine Besonderheit des Steam Controllers."
                                   FontSize="15" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                        <TextBlock IsVisible="{Binding IsUnavailable}" Text="{Binding UnavailableText}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource Warning}" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="switch" Classes.on="{Binding IsEnabled}" Classes.locked="{Binding IsWorking}" IsVisible="{Binding !ShowInstall}" VerticalAlignment="Center">
                        <Ellipse />
                      </Border>
                      <!-- Not a button of its own: the whole row is the button, so A on the row installs. -->
                      <Border Grid.Column="1" Classes="rowAction" Classes.locked="{Binding IsWorking}" IsVisible="{Binding ShowInstall}" VerticalAlignment="Center">
                        <TextBlock Text="SISR installieren" />
                      </Border>
                    </Grid>
                  </Button>

                  <!-- Everything below depends on the switch above, so it stays in the same box. -->
                  <StackPanel Spacing="16" Margin="20,8,20,16">
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding ShowStatus}">
                      <Path Classes="spinner" IsVisible="{Binding IsInTransition}" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <!-- No local Fill: it would override the "active" style. -->
                      <Ellipse Classes="statusDot" Classes.active="{Binding IsHealthy}" Width="10" Height="10" VerticalAlignment="Center"
                               IsVisible="{Binding ShowStatusDot}" />
                      <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsBusy}">
                      <Path Classes="spinner" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <TextBlock Text="{Binding BusyText}" FontSize="15" Foreground="{StaticResource AccentSoft}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding ErrorText, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding ErrorText}"
                               FontSize="15" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding VersionText}" FontSize="15" Foreground="{StaticResource TextSoft}" />
                        <TextBlock Text="{Binding UpdateText}" IsVisible="{Binding HasUpdate}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource AccentSoft}" />
                      </StackPanel>
                      <Button Grid.Column="1" Classes="plain action primaryAction" Classes.focused="{Binding UpdateItem.IsFocused}"
                              IsVisible="{Binding HasUpdate}" IsEnabled="{Binding !IsBusy}" Command="{Binding UpdateCommand}" Content="Aktualisieren" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Issues}" IsVisible="{Binding HasIssues}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HealthIssueViewModel">
                          <Border Background="{StaticResource SurfaceHover}" CornerRadius="12" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                              <!-- No local Stroke: a local value would override the error style. -->
                              <Path Classes="issueIcon" Classes.error="{Binding IsError}" Data="M12 3.5L2.5 20h19z M12 10v4.5 M12 17.2v.3" StrokeThickness="2"
                                    StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" Stretch="None" VerticalAlignment="Top" />
                              <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                              </StackPanel>
                              <Button Grid.Column="2" Classes="plain action" Classes.focused="{Binding IsFocused}" IsVisible="{Binding HasFix}"
                                      Command="{Binding FixCommand}" Content="{Binding FixLabel}" VerticalAlignment="Center" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="8">
                      <TextBlock Classes="label" Text="SO FUNKTIONIERT ES" />
                      <TextBlock Classes="bullet" Text="Ist diese Option aktiv (und ein Steam Controller verbunden), kann in Arcadia pro Spiel zwischen zwei Modi für den Steam Controller gewechselt werden:" />
                      <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,4">
                        <Border Classes="modeCard">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Xbox 360 Controller (SISR)" FontSize="16" FontWeight="Bold" />
                            <TextBlock Classes="bullet" Text="Arcadia behandelt den Steam Controller für dieses Spiel wie einen Xbox 360 Controller." />
                            <TextBlock Classes="modeDefault" Text="Vorauswahl für Spiele außerhalb von Steam" />
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Classes="modeCard">
                          <StackPanel Spacing="4">
                            <TextBlock Text="Steam Input" FontSize="16" FontWeight="Bold" />
                            <TextBlock Classes="bullet" Text="Das Standardverhalten des Steam Controllers. Empfohlen für Steam-Spiele oder wenn du außerhalb von Steam den Desktop-Modus nutzen möchtest; der Controller simuliert dann Maus und Tastatur." />
                            <TextBlock Classes="modeDefault" Text="Vorauswahl für Spiele aus Steam" />
                          </StackPanel>
                        </Border>
                      </Grid>
                      <TextBlock Classes="bullet" Text="Dafür wird die Drittanbieter-Software SISR benötigt und bei Bedarf automatisch installiert. Arcadia startet SISR unsichtbar im Hintergrund." />
                    </StackPanel>
                    <StackPanel Spacing="8">
                      <TextBlock Classes="label" Text="NACHTEILE" />
                      <TextBlock Classes="bullet" Text="• Steam muss im Hintergrund laufen, und Steams lokale Debug-Schnittstelle (CEF) muss aktiv sein." />
                      <TextBlock Classes="bullet" Text="• Benötigt den usbip-Treiber. Die Installation fragt einmalig nach Administratorrechten." />
                      <TextBlock Classes="bullet" Text="• SISR ist laut seinem Entwickler noch experimentell; Abstürze sind möglich. Arcadia startet SISR dann automatisch neu." />
                      <TextBlock Classes="bullet" Text="• Steht ein Steam-Spiel auf „Xbox 360 Controller (SISR)“, kommen Eingaben doppelt an." />
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                               Text="SISR von Peter Repukat (Alia5) · GPL-3.0 · github.com/Alia5/SISR" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="ÜBER ARCADIA" FontSize="14" />
              <Border Classes="settingsSection" Background="{StaticResource SurfaceSunken}" CornerRadius="16" Padding="28,20">
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ArcadiaVersionText}" FontSize="20" FontWeight="Bold" />
                      <TextBlock Text="{Binding ArcadiaUpdateText}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                      <Button Classes="plain action" Classes.focused="{Binding CheckUpdatesItem.IsFocused}"
                              IsVisible="{Binding CanSearchForUpdates}" IsEnabled="{Binding IsCheckIdle}"
                              Command="{Binding CheckUpdatesCommand}" Content="{Binding CheckButtonText}" />
                      <Button Classes="plain action primaryAction" Classes.focused="{Binding ArcadiaUpdateItem.IsFocused}"
                              IsVisible="{Binding HasArcadiaUpdate}"
                              Command="{Binding ArcadiaUpdateCommand}" Content="Jetzt aktualisieren" />
                    </StackPanel>
                  </Grid>

                  <TextBlock IsVisible="{Binding ArcadiaUpdateError, Converter={x:Static ObjectConverters.IsNotNull}}" Text="{Binding ArcadiaUpdateError}"
                             FontSize="15" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />

                  <!-- Changelog: only the versions between the running and the newest one. -->
                  <StackPanel Spacing="10" IsVisible="{Binding HasChangelog}">
                    <TextBlock Classes="label" Text="WAS IST NEU" />
                    <Border Background="{StaticResource ChangelogSurface}" BorderBrush="{StaticResource ChangelogBorder}" BorderThickness="1" CornerRadius="14" MaxHeight="320">
                      <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
                        <ItemsControl ItemsSource="{Binding Changelog}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Spacing="20" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChangelogEntryViewModel">
                              <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                  <Border Background="{StaticResource VersionPill}" CornerRadius="10" Padding="10,3">
                                    <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSoft}" />
                                  </Border>
                                  <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Changes}">
                                  <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                      <StackPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                  </ItemsControl.ItemsPanel>
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,0,0,0">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,8,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" FontSize="15" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </ScrollViewer>
                    </Border>
                  </StackPanel>

                  <TextBlock FontSize="13" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Text="{Binding SourceText}" />
                </StackPanel>
              </Border>
            </StackPanel>

          </StackPanel>
          </ScrollViewer>
          </DockPanel>
        </Border>

        <!-- Prompt over the settings before "SISR installieren" goes on; the settings stay dimmed behind it. -->
        <Panel DataContext="{Binding Settings}" x:DataType="vm:SettingsViewModel" IsVisible="{Binding IsPromptOpen, FallbackValue=False}">
          <Button Classes="plain" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                  Command="{Binding ClosePromptCommand}" />
          <Border Classes="prompt" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="28">
              <StackPanel Orientation="Horizontal" Spacing="18">
                <Border Classes="promptIcon" Classes.warning="{Binding IsWarningPrompt}">
                  <Panel>
                    <TextBlock Text="!" IsVisible="{Binding IsWarningPrompt}" />
                    <TextBlock Text="?" IsVisible="{Binding IsQuestionPrompt}" />
                  </Panel>
                </Border>
                <TextBlock Text="Steam-Spiel läuft" IsVisible="{Binding IsGamePrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                <TextBlock Text="Steam beenden?" IsVisible="{Binding IsSteamStopPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SteamStartFailedTitle}" IsVisible="{Binding IsSteamStartFailedPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                <TextBlock Text="Steam-Eintrag für SISR anlegen?" IsVisible="{Binding IsMarkerPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding IsGamePrompt}">
                <Border Classes="promptGame">
                  <TextBlock FontSize="20" TextWrapping="Wrap">
                    <Run Text="{Binding RunningGame}" FontWeight="ExtraBold" />
                    <Run Text=" läuft gerade über Steam." />
                  </TextBlock>
                </Border>
                <TextBlock Classes="promptBody" Text="Für die Installation muss Steam beendet und neu gestartet werden. Beende zuerst das Spiel und versuche es dann erneut." />
              </StackPanel>
              <StackPanel Spacing="14" IsVisible="{Binding IsSteamStopPrompt}">
                <TextBlock Classes="promptBody" Text="Für die Installation muss Steam beendet werden. Arcadia startet Steam danach wieder im Hintergrund." />
                <TextBlock Classes="promptBody" Text="Danach werden SISR und der usbip-Treiber installiert. Windows fragt dabei einmal nach Administratorrechten." />
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding IsSteamStartFailedPrompt}">
                <TextBlock Classes="promptBody" Text="{Binding SteamStartFailedText}" />
                <TextBlock Classes="promptBody" Text="{Binding SteamStartFailedHint}" />
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding IsMarkerPrompt}">
                <TextBlock Classes="promptBody" Text="SISR braucht in Steam einen Eintrag „SISR Marker“ als Nicht-Steam-Spiel. Er erscheint in der Steam-Bibliothek des Kontos. Ohne ihn lässt sich die Funktion nicht nutzen." />
                <TextBlock Classes="promptBody" Text="Auf diesem PC gibt es mehrere Steam-Konten. Für welche soll der Eintrag angelegt werden? Mit anderen Konten bleibt die Funktion aus, bis der Eintrag dort angelegt ist." />
                <ItemsControl ItemsSource="{Binding MarkerAccounts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MarkerAccountViewModel">
                      <Button Classes="plain settingRow" Classes.focused="{Binding IsFocused}" Classes.done="{Binding HasMarker}"
                              Command="{Binding ToggleCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                          <Border Classes="checkbox" Classes.on="{Binding IsChecked}">
                            <TextBlock Text="✓" IsVisible="{Binding IsChecked}" />
                          </Border>
                          <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Classes="hint" Text="bereits eingerichtet" IsVisible="{Binding HasMarker}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsMarkerPrompt}">
                <Button Classes="plain action primaryAction" Classes.focused="{Binding ConfirmMarkerAccountsItem.IsFocused}"
                        Command="{Binding ConfirmMarkerAccountsCommand}" IsEnabled="{Binding CanConfirmMarkerAccounts}" Content="Weiter" />
                <Button Classes="plain action" Classes.focused="{Binding CancelMarkerAccountsItem.IsFocused}"
                        Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsGamePrompt}">
                <Button Classes="plain action primaryAction" Classes.focused="{Binding RetryInstallItem.IsFocused}"
                        Command="{Binding RetryInstallCommand}" Content="Erneut versuchen" />
                <Button Classes="plain action" Classes.focused="{Binding CloseGamePromptItem.IsFocused}"
                        Command="{Binding ClosePromptCommand}" Content="Schließen" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSteamStopPrompt}">
                <Button Classes="plain action primaryAction" Classes.focused="{Binding ConfirmSteamStopItem.IsFocused}"
                        Command="{Binding ConfirmSteamStopCommand}" Content="Steam beenden und installieren" />
                <Button Classes="plain action" Classes.focused="{Binding CancelSteamStopItem.IsFocused}"
                        Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSteamStartFailedPrompt}">
                <Button Classes="plain action primaryAction" Classes.focused="{Binding RetrySteamStartItem.IsFocused}"
                        Command="{Binding RetrySteamStartCommand}" Content="{Binding SteamStartFailedAction}" />
                <Button Classes="plain action" Classes.focused="{Binding CancelSteamStartItem.IsFocused}"
                        Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
              </StackPanel>

              <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                    <TextBlock Classes="hint" Text="Auswählen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                    <TextBlock Classes="hint" Text="{Binding PromptBackText}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Panel>
      </Panel>
    </Grid>
  </Viewbox>

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style Selector="Ellipse.statusDot">
      <Setter Property="Fill" Value="{StaticResource TextFaint}" />
    </Style>
    <Style Selector="Ellipse.statusDot.active">
      <Setter Property="Fill" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="Path.issueIcon">
      <Setter Property="Stroke" Value="{StaticResource Warning}" />
    </Style>
    <Style Selector="Path.issueIcon.error">
      <Setter Property="Stroke" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="TextBlock.bullet">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.modeDefault">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.crumb">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.crumb.separator">
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>
    <Style Selector="TextBlock.crumb.current">
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
</Window>
