<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:Arcadia.App.Controls"
        xmlns:search="using:Arcadia.App.Search"
        xmlns:vm="using:Arcadia.App.ViewModels"
        xmlns:views="using:Arcadia.App.Views">

  <!-- Colors from the Big Picture designs. -->
  <Styles.Resources>
    <!-- Every text in Figtree (#24); Inter for the symbols Figtree lacks. Both embedded (ArcadiaFonts). -->
    <FontFamily x:Key="ContentControlThemeFontFamily">fonts:Figtree#Figtree, fonts:Inter#Inter</FontFamily>
    <Color x:Key="BgColor">#0B0F14</Color>
    <SolidColorBrush x:Key="Bg" Color="#0B0F14" />
    <Color x:Key="SurfaceColor">#151B23</Color>
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceRaised" Color="#1E2630" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="#0F141A" />
    <!-- "Was ist neu" in the settings: a card a shade lighter than its section, with a version pill. -->
    <SolidColorBrush x:Key="ChangelogSurface" Color="#141B23" />
    <SolidColorBrush x:Key="ChangelogBorder" Color="#243040" />
    <SolidColorBrush x:Key="VersionPill" Color="#1F3A5C" />
    <!-- Prompt over the settings ("Steam-Spiel läuft", "Steam beenden?"): icon disc and the highlighted game. -->
    <SolidColorBrush x:Key="PromptBorder" Color="#2E3A48" />
    <SolidColorBrush x:Key="PromptIcon" Color="#1F3A5C" />
    <SolidColorBrush x:Key="PromptIconWarning" Color="#4A3418" />
    <SolidColorBrush x:Key="PromptGame" Color="#1F2833" />
    <!-- The firmware warnings of Pan's dialogs and its settings row (#242): a dark red box. -->
    <SolidColorBrush x:Key="DangerSurface" Color="#2A1618" />
    <SolidColorBrush x:Key="DangerBorder" Color="#5A2A2D" />
    <SolidColorBrush x:Key="Line" Color="#2A3440" />
    <!-- The line between the rows of a settings group: full in the middle, gone 10 % before the box's edges (owner,
         2026-10-23). -->
    <LinearGradientBrush x:Key="GroupDivider" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0.1" Color="#002A3440" />
      <GradientStop Offset="0.5" Color="#FF34404E" />
      <GradientStop Offset="0.9" Color="#002A3440" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LineStrong" Color="#3A4552" />
    <SolidColorBrush x:Key="Text" Color="#E8EDF2" />
    <SolidColorBrush x:Key="TextStrong" Color="#F2F5F8" />
    <SolidColorBrush x:Key="TextSoft" Color="#C5CED7" />
    <SolidColorBrush x:Key="TextMuted" Color="#9AA7B4" />
    <SolidColorBrush x:Key="TextFaint" Color="#5A6878" />
    <SolidColorBrush x:Key="Accent" Color="#3B9EFF" />
    <SolidColorBrush x:Key="AccentHover" Color="#5AAEFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#8CC6FF" />
    <SolidColorBrush x:Key="OnAccent" Color="#06101C" />
    <!-- Status message levels: information (blue i), warning (yellow triangle), error (red X, Danger). -->
    <SolidColorBrush x:Key="Info" Color="#5AAEFF" />
    <SolidColorBrush x:Key="Warning" Color="#F5B868" />
    <!-- Text on a warning-coloured surface, e.g. the count of games waiting for a choice (#491). -->
    <SolidColorBrush x:Key="OnWarning" Color="#1A1206" />
    <SolidColorBrush x:Key="Success" Color="#6FD99A" />
    <!-- A running game (#95): the badge on its cover, the preview's line and the detail page's chip. -->
    <SolidColorBrush x:Key="Running" Color="#6FD99A" />
    <SolidColorBrush x:Key="OnRunning" Color="#06140C" />
    <SolidColorBrush x:Key="Danger" Color="#FF9A8F" />
    <SolidColorBrush x:Key="SurfaceHover" Color="#1A212B" />
    <SolidColorBrush x:Key="SurfaceDisabled" Color="#11161D" />
    <SolidColorBrush x:Key="TextDisabled" Color="#4A5563" />
    <!-- Backdrop behind dialogs, and the shade over covers of games that aren't installed. -->
    <SolidColorBrush x:Key="Scrim" Color="#C705080C" />
    <SolidColorBrush x:Key="CoverShade" Color="#B80B0F14" />
    <SolidColorBrush x:Key="ProgressTrack" Color="#33FFFFFF" />

    <!-- The kinds of library entries and "installiert" (#141): line icons on a 24 × 24 grid, stroked with round caps by
         ctl:LineIcon, which also fills "<key>Fill". Own drawings, from the designs (T141Icons). -->
    <StreamGeometry x:Key="IconTypeGame">M6.5 6.5h11a4.5 4.5 0 0 1 4.4 3.6l1 5.2a2.8 2.8 0 0 1-4.9 2.4L15.5 15h-7L6 17.7a2.8 2.8 0 0 1-4.9-2.4l1-5.2A4.5 4.5 0 0 1 6.5 6.5zM7 9.5v4M5 11.5h4</StreamGeometry>
    <StreamGeometry x:Key="IconTypeGameFill">M15.1 10.4a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0zM17.4 12.7a1.2 1.2 0 1 0 2.4 0a1.2 1.2 0 1 0-2.4 0z</StreamGeometry>
    <StreamGeometry x:Key="IconInstalled">M5 13.5h14a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2zM7.5 7l3 3 6-6</StreamGeometry>
    <StreamGeometry x:Key="IconInstalledFill">M16.4 17a1.1 1.1 0 1 0 2.2 0a1.1 1.1 0 1 0-2.2 0z</StreamGeometry>
    <StreamGeometry x:Key="IconTypeSoftware">M10.20 4.21L10.52 1.50L13.48 1.50L13.80 4.21A8 8 0 0 1 16.24 5.22L18.38 3.53L20.47 5.62L18.78 7.76A8 8 0 0 1 19.79 10.20L22.50 10.52L22.50 13.48L19.79 13.80A8 8 0 0 1 18.78 16.24L20.47 18.38L18.38 20.47L16.24 18.78A8 8 0 0 1 13.80 19.79L13.48 22.50L10.52 22.50L10.20 19.79A8 8 0 0 1 7.76 18.78L5.62 20.47L3.53 18.38L5.22 16.24A8 8 0 0 1 4.21 13.80L1.50 13.48L1.50 10.52L4.21 10.20A8 8 0 0 1 5.22 7.76L3.53 5.62L5.62 3.53L7.76 5.22A8 8 0 0 1 10.20 4.21ZM9.4 9.6L7.4 12l2 2.4M12.9 9l-1.8 6M14.6 9.6l2 2.4-2 2.4</StreamGeometry>
    <StreamGeometry x:Key="IconReset">M4 12a8 8 0 1 0 2.3 -5.6M4 4v4.5h4.5</StreamGeometry>
    <StreamGeometry x:Key="IconTypeTool">M10.52 11.22L3.37 18.37A1.6 1.6 0 0 0 5.63 20.63L12.78 13.48A5 5 0 0 0 19.52 6.88L17.26 9.14L14.86 6.74L17.12 4.48A5 5 0 0 0 10.52 11.22Z</StreamGeometry>
    <StreamGeometry x:Key="IconTypeSoundtrack">M14 16.4V4c2.4.6 5 2 5 5.4</StreamGeometry>
    <StreamGeometry x:Key="IconTypeSoundtrackFill">M7.6 16.4a3.2 3.2 0 1 0 6.4 0a3.2 3.2 0 1 0-6.4 0z</StreamGeometry>

    <!-- The edge fade (ctl:EdgeFade, #237): how opaque it is from the edge (0) inwards (1); only the alpha counts, the
         colour is the surface it fades into. A cosine curve, so neither end of the fade shows an edge. -->
    <GradientStops x:Key="EdgeFadeCurve">
      <GradientStop Offset="0" Color="#FF000000" />
      <GradientStop Offset="0.125" Color="#F5000000" />
      <GradientStop Offset="0.25" Color="#DA000000" />
      <GradientStop Offset="0.375" Color="#B0000000" />
      <GradientStop Offset="0.5" Color="#80000000" />
      <GradientStop Offset="0.625" Color="#4F000000" />
      <GradientStop Offset="0.75" Color="#25000000" />
      <GradientStop Offset="0.875" Color="#0A000000" />
      <GradientStop Offset="1" Color="#00000000" />
    </GradientStops>
    <!-- The tab strips': solid for almost half, so a cut-off tab's text is gone before the fade starts. -->
    <GradientStops x:Key="EdgeFadeCurveTabs">
      <GradientStop Offset="0.45" Color="#FF000000" />
      <GradientStop Offset="1" Color="#00000000" />
    </GradientStops>

    <!-- Detail page (#499): the panel with rail and rows lies semi-transparent on the game's artwork; the scrims keep the
         text on the artwork readable over a bright and a dark image. -->
    <SolidColorBrush x:Key="DetailSurface" Color="#F2121820" />
    <!-- What lists in a modal on DetailSurface fade into at their edges (#506: "Warten auf deine Auswahl"). -->
    <Color x:Key="ModalSurfaceColor">#121820</Color>
    <Color x:Key="DetailInfoBoxColor">#0F141A</Color>
    <SolidColorBrush x:Key="DetailChip" Color="#1FF2F5F8" />
    <SolidColorBrush x:Key="DetailAction" Color="#1AF2F5F8" />
    <SolidColorBrush x:Key="DetailActionHover" Color="#2EF2F5F8" />
    <!-- The buttons beside "Spielen" stand on the artwork: darker, so they read over a bright image. -->
    <SolidColorBrush x:Key="DetailActionOnArt" Color="#990B0F14" />
    <SolidColorBrush x:Key="DetailActionOnArtHover" Color="#CC1E2630" />
    <SolidColorBrush x:Key="DetailRailIconOpen" Color="#1F3A5C" />
    <LinearGradientBrush x:Key="DetailScrimSide" StartPoint="0%,0%" EndPoint="100%,0%">
      <GradientStop Offset="0" Color="#D10B0F14" />
      <GradientStop Offset="0.45" Color="#800B0F14" />
      <GradientStop Offset="1" Color="#260B0F14" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DetailScrimTop" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#E60B0F14" />
      <GradientStop Offset="1" Color="#000B0F14" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DetailScrimBottom" StartPoint="0%,100%" EndPoint="0%,0%">
      <GradientStop Offset="0" Color="#FF0B0F14" />
      <GradientStop Offset="0.25" Color="#FF0B0F14" />
      <GradientStop Offset="1" Color="#000B0F14" />
    </LinearGradientBrush>

    <!-- Focus rings and shadows. -->
    <BoxShadows x:Key="FocusRing">0 0 0 3 #F2F5F8</BoxShadows>
    <!-- Shadows paint in order: the drop shadow first, so it doesn't darken the ring's lower edge. -->
    <BoxShadows x:Key="FocusRingLifted">0 18 40 0 #A6000000, 0 0 0 3 #F2F5F8</BoxShadows>
    <BoxShadows x:Key="HoverRing">0 0 0 2 #5A6878</BoxShadows>
    <!-- Menu entries sit edge to edge, so their focus ring is drawn inside. -->
    <BoxShadows x:Key="FocusRingInset">inset 0 0 0 2 #F2F5F8</BoxShadows>
    <!-- Fills around the preview while A is held; full means the detail page opens. -->
    <SolidColorBrush x:Key="HoldRing" Color="#3B9EFF" />
    <BoxShadows x:Key="ToastShadow">0 20 50 0 #8C000000</BoxShadows>
    <!-- Detail page: buttons on the page's surface get a gap between button and ring. -->
    <BoxShadows x:Key="FocusRingGap">0 0 0 7 #F2F5F8, 0 0 0 4 #121820</BoxShadows>
    <BoxShadows x:Key="DetailShadow">0 30 80 0 #73000000</BoxShadows>
    <BoxShadows x:Key="CoverShadow">0 24 50 0 #80000000</BoxShadows>
    <BoxShadows x:Key="DialogShadow">0 40 100 0 #99000000</BoxShadows>
    <!-- Button and key glyphs: a darker lower edge, like a key cap (owner, 2026-10-21). -->
    <BoxShadows x:Key="GlyphEdge">inset 0 -2 0 0 #1B222B</BoxShadows>
    <BoxShadows x:Key="GlyphEdgeDark">inset 0 -2 0 0 #99000000</BoxShadows>
    <BoxShadows x:Key="GlyphButtonEdge">inset 0 -2 0 0 #141A21</BoxShadows>
    <!-- Button symbols drawn as icons (#215, PadGlyph): PlayStation's shapes and the PS5's Create and Options, in a 16 × 16 box,
         stroked like the glyphs' letters. Vectors, not font characters: fonts draw ✕ ○ □ △ in different sizes. -->
    <StreamGeometry x:Key="PadIconCross">M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5</StreamGeometry>
    <StreamGeometry x:Key="PadIconCircle">M2.5,8 A5.5,5.5 0 1 1 13.5,8 A5.5,5.5 0 1 1 2.5,8 Z</StreamGeometry>
    <StreamGeometry x:Key="PadIconSquare">M3,3 H13 V13 H3 Z</StreamGeometry>
    <!-- Nearly as tall as wide, so it fills its box like the circle and doesn't look smaller. -->
    <StreamGeometry x:Key="PadIconTriangle">M8,1.5 L14.5,13.5 H1.5 Z</StreamGeometry>
    <StreamGeometry x:Key="PadIconCreate">M3,9 V3 M6,10 L10.5,5.5 M7,13 H13</StreamGeometry>
    <StreamGeometry x:Key="PadIconOptions">M3,4 H13 M3,8 H13 M3,12 H13</StreamGeometry>
    <!-- Xbox's View (⧉, #24): two squares, the back one peeking out at the top left, as printed on the pad. Its Menu (≡)
         is PadIconOptions. Neither Figtree nor Inter has these characters. -->
    <StreamGeometry x:Key="PadIconView">M13.5,6 H6 V13.5 H13.5 Z M10,6 V2.5 H2.5 V10 H6</StreamGeometry>
    <!-- The on-screen keyboard's tab key (↹, #24), in the same 16 × 16 box and stroke as the button icons. -->
    <StreamGeometry x:Key="KeyIconTab">M1.5,5 H11.5 M8.5,2 L11.5,5 L8.5,8 M14.5,2 V8 M14.5,11 H4.5 M7.5,8 L4.5,11 L7.5,14 M1.5,8 V14</StreamGeometry>
    <!-- Dividers between groups in the header. -->
    <SolidColorBrush x:Key="Divider" Color="#2A3440" />

    <!-- Search (#12). -->
    <SolidColorBrush x:Key="KeyboardSurface" Color="#11161D" />
    <!-- The pictures of the search's empty states (ContentControl.searchEmpty). -->
    <!-- Fades out along a cosine curve, so the glow has no visible rim. -->
    <RadialGradientBrush x:Key="EmptyStateGlow">
      <GradientStop Offset="0" Color="#263B9EFF" />
      <GradientStop Offset="0.25" Color="#203B9EFF" />
      <GradientStop Offset="0.5" Color="#133B9EFF" />
      <GradientStop Offset="0.75" Color="#063B9EFF" />
      <GradientStop Offset="1" Color="#003B9EFF" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="EmptyStateCard" Color="#1E2630" />
    <SolidColorBrush x:Key="EmptyStateCardLine" Color="#3A4552" />
    <SolidColorBrush x:Key="EmptyStateCardBadge" Color="#3B9EFF" />
    <SolidColorBrush x:Key="EmptyStateLens" Color="#151B23" />
    <SolidColorBrush x:Key="EmptyStateLensRim" Color="#3B9EFF" />
    <SolidColorBrush x:Key="EmptyStateMiss" Color="#9AA7B4" />
    <SolidColorBrush x:Key="EmptyStateSparkle" Color="#8CC6FF" />
    <BoxShadows x:Key="SearchFieldRing">0 0 0 3 #3B9EFF</BoxShadows>
    <!-- The launcher settings (#136): a lifted launcher, the note above its info, the lines of facts. -->
    <BoxShadows x:Key="LiftedRing">0 0 0 3 #3B9EFF, 0 22 44 0 #99000000</BoxShadows>
    <SolidColorBrush x:Key="NoteSurface" Color="#2A2113" />
    <SolidColorBrush x:Key="NoteText" Color="#F5D6A8" />
    <SolidColorBrush x:Key="InfoNoteSurface" Color="#13212F" />
    <SolidColorBrush x:Key="InfoNoteText" Color="#BFDDFF" />
    <!-- One box per value in an info box (#506): the current value's box in the accent's hue, with a frame. -->
    <SolidColorBrush x:Key="ValueBoxSurface" Color="#1E2630" />
    <SolidColorBrush x:Key="ValueBoxCurrentSurface" Color="#152A40" />
    <SolidColorBrush x:Key="ValueBoxCurrentBorder" Color="#3B9EFF" />
    <SolidColorBrush x:Key="FactLine" Color="#1A212B" />
    <!-- Sets the launcher badge off from any cover colour. -->
    <BoxShadows x:Key="LauncherBadgeRing">0 0 0 2 #990B0F14</BoxShadows>
    <!-- The ground of a launcher's logo or picture on a cover (#138). -->
    <SolidColorBrush x:Key="LauncherBadgePlate" Color="#E60B0F14" />
    <BoxShadows x:Key="LayoutMenuShadow">0 24 60 0 #99000000, 0 0 0 1 #2A3440</BoxShadows>

    <!-- The mouse mode's on-screen keyboard (#110): keys with a darker lower edge like real ones (owner, 2026-10-22). -->
    <BoxShadows x:Key="KeyCapEdge">inset 0 -3 0 0 #0F141A</BoxShadows>
    <BoxShadows x:Key="KeyCapEdgeFocused">inset 0 -3 0 0 #0F141A, 0 0 0 3 #F2F5F8</BoxShadows>
  </Styles.Resources>

  <!-- A button that draws only what we give it; the Fluent hover/press visuals don't fit the design. -->
  <Style Selector="Button.plain">
    <!-- Fluent's Button clips to its bounds, which cuts off focus rings drawn as an outer BoxShadow. -->
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Chrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.plain:disabled">
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- Controller glyphs (A, B, LB, …). -->
  <Style Selector="Border.glyph">
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,0" />
  </Style>
  <Style Selector="Border.glyph">
    <Setter Property="BoxShadow" Value="{StaticResource GlyphEdge}" />
  </Style>
  <Style Selector="Border.glyph.round">
    <Setter Property="Width" Value="28" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <!-- Keyboard keys and mouse buttons are square, controller buttons round (owner, 2026-10-21). -->
  <Style Selector="Border.glyph.kbd, .keys Border.glyph">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Border.glyph.dark">
    <Setter Property="Background" Value="{StaticResource OnAccent}" />
    <Setter Property="BoxShadow" Value="{StaticResource GlyphEdgeDark}" />
  </Style>
  <!-- A hint with nothing to show for the input in use (KeyHint). -->
  <Style Selector="ctl|KeyHint.noKeys">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Background" Value="{StaticResource Divider}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.glyph > TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A symbol drawn as an icon (PadGlyph, #215): as tall as a capital letter of the glyph, monochrome like the letters. -->
  <Style Selector="Border.glyph > Path">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Round button with a glyph (LB/RB, LT/RT). -->
  <Style Selector="Button.glyphButton">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Height" Value="36" />
    <Setter Property="MinWidth" Value="52" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="Button.glyphButton.keycap /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource GlyphButtonEdge}" />
  </Style>
  <Style Selector="Button.glyphButton.kbd">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.glyphButton:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>

  <!-- Launcher tabs. -->
  <Style Selector="Button.tab">
    <Setter Property="Height" Value="48" />
    <Setter Property="Padding" Value="12,0,20,0" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.tab:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.tab.selected">
    <Setter Property="Background" Value="{StaticResource TextStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Bg}" />
  </Style>

  <!-- Item lists clip to their bounds as well, and a focused item's ring reaches beyond them. -->
  <Style Selector="ItemsControl">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <!-- Cover tiles. -->
  <Style Selector="Button.tile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.tile:pointerover /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource HoverRing}" />
  </Style>
  <Style Selector="Button.tile.focused">
    <Setter Property="RenderTransform" Value="scale(1.07)" />
    <Setter Property="ZIndex" Value="2" />
  </Style>
  <Style Selector="Button.tile.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingLifted}" />
  </Style>

  <!-- Holding A: a ring along the inner edge of the preview panel fills while the hold runs
       (GameActions.HoldTime - HoldFeedbackDelay = 0.8 s). It fills a little faster, so it is seen
       full before the detail page opens. -->
  <Style Selector="ctl|HoldRing">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Stroke" Value="{StaticResource HoldRing}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <!-- Mouse mode (#64): the screen's edge fills while Back + Start are held, flashes when the mode switches. -->
  <Style Selector="ctl|ScreenEdgeFill">
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
    <Setter Property="StrokeThickness" Value="8" />
  </Style>
  <!-- No FillMode="Forward": Avalonia kept the forwarded Opacity 0 after the class went, so the edge stayed
       invisible after the first switch. The overlay hides the edge itself once the flash is over. -->
  <Style Selector="ctl|ScreenEdgeFill.flash">
    <Style.Animations>
      <Animation Duration="0:0:0.5">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="22%">
          <Setter Property="Opacity" Value="0.3" />
        </KeyFrame>
        <KeyFrame Cue="45%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
        <KeyFrame Cue="90%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- "Mausmodus an/aus" at the top centre of the screen. -->
  <Style Selector="Border.mouseModeLabel">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BoxShadow" Value="{StaticResource ToastShadow}" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="36,18" />
    <Setter Property="Margin" Value="0,56,0,0" />
    <Setter Property="MaxWidth" Value="1100" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <!-- The box for View held (#64): the label's place, with a frame that fills along its rounded edge. -->
  <Style Selector="Panel.returnBox">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,56,0,0" />
  </Style>
  <Style Selector="Panel.returnBox > Border.mouseModeLabel">
    <Setter Property="Margin" Value="0" />
  </Style>
  <Style Selector="ctl|ScreenEdgeFill.returnEdge">
    <Setter Property="StrokeThickness" Value="4" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>
  <Style Selector="Border.mouseModeLabel > TextBlock">
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <!-- A notice during a View hold: below the "Zurück zu Arcadia" box, inside the overlay's label area. -->
  <Style Selector="Border.mouseModeLabel.belowReturnBox">
    <Setter Property="Margin" Value="0,148,0,0" />
  </Style>
  <!-- A notice over a game (#243, Pan): a sentence or two, smaller than "Mausmodus an". -->
  <Style Selector="Border.mouseModeLabel.notice > TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.preview.holding ctl|HoldRing">
    <Setter Property="IsVisible" Value="True" />
    <Style.Animations>
      <Animation Duration="0:0:0.75" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Progress" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Progress" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- Owned but not installed: the cover is shaded, the title stays readable. -->
  <Style Selector="Border.shade">
    <Setter Property="Background" Value="{StaticResource CoverShade}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <!-- Hints below the detail page's main button; they wrap and push the content above upwards. -->
  <Style Selector="TextBlock.actionHint">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.installBadge">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- The kind of an entry that is no game (#141): a rounded square above the title (round badges top right are states). -->
  <Style Selector="Border.typeBadge">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.typeBadge > ctl|LineIcon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <!-- The count line beside the tab's name and on a launcher's page (#141). -->
  <Style Selector="views|CountLineView">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="views|CountLineView StackPanel.countLine">
    <Setter Property="Spacing" Value="14" />
  </Style>
  <Style Selector="views|CountLineView StackPanel.countPart">
    <Setter Property="Spacing" Value="7" />
  </Style>
  <Style Selector="views|CountLineView StackPanel.countInstalled">
    <Setter Property="Spacing" Value="4" />
  </Style>
  <Style Selector="views|CountLineView TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="views|CountLineView TextBlock.countTotal">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="views|CountLineView ctl|LineIcon.countType">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="views|CountLineView ctl|LineIcon.countInstalled">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Shorter than the header's divider (owner, 2026-10-26). -->
  <!-- ")" has a wide left bearing; pulled in, both sides of the installed icon look alike. -->
  <Style Selector="views|CountLineView TextBlock.countClose">
    <Setter Property="Margin" Value="-2,0,0,0" />
  </Style>
  <Style Selector="views|CountLineView Border.countDivider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="{StaticResource Divider}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- In a settings row's subtitle and the info panel's facts. -->
  <Style Selector="views|CountLineView.small">
    <Setter Property="FontSize" Value="14" />
  </Style>
  <Style Selector="views|CountLineView.small StackPanel.countLine">
    <Setter Property="Spacing" Value="10" />
  </Style>
  <Style Selector="views|CountLineView.small StackPanel.countPart">
    <Setter Property="Spacing" Value="5" />
  </Style>
  <Style Selector="views|CountLineView.small StackPanel.countInstalled">
    <Setter Property="Spacing" Value="3" />
  </Style>
  <Style Selector="views|CountLineView.small ctl|LineIcon.countType">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
  </Style>
  <Style Selector="views|CountLineView.small ctl|LineIcon.countInstalled">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>
  <Style Selector="views|CountLineView.small Border.countDivider">
    <Setter Property="Height" Value="18" />
  </Style>

  <!-- Installation progress: a thin bar along the cover's bottom edge, a taller one in the preview. -->
  <Style Selector="ProgressBar.install">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="5" />
    <Setter Property="Height" Value="5" />
    <Setter Property="CornerRadius" Value="0,0,8,8" />
    <Setter Property="Background" Value="{StaticResource ProgressTrack}" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ProgressBar.install.large">
    <Setter Property="MinHeight" Value="8" />
    <Setter Property="Height" Value="8" />
    <Setter Property="CornerRadius" Value="4" />
  </Style>
  <Style Selector="ProgressBar.install.paused">
    <Setter Property="Foreground" Value="{StaticResource Warning}" />
  </Style>

  <!-- Pagination. -->
  <Style Selector="Button.page">
    <Setter Property="MinWidth" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.page:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.page.current">
    <Setter Property="Background" Value="{StaticResource TextStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Bg}" />
  </Style>

  <!-- Toolbar and preview buttons. -->
  <Style Selector="Button.toolbar">
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="10,0,20,0" />
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.toolbar:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="30" />
    <!-- Keeps the label clear of the rounded ends, also when it shrinks to fit. -->
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
  </Style>
  <!-- "Installieren" while the launcher can't install (#83: Steam runs with another account): greyed like a disabled action. -->
  <Style Selector="Button.primary.blocked">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <!-- Below the primary button in the preview, e.g. "⧉ Optionen". -->
  <Style Selector="Button.secondary">
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.secondary:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>

  <!-- Options in the "Ansicht" dialog. -->
  <Style Selector="Button.segment">
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.size">
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Margin" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <!-- The search's launchers in the same dialog: names, not numbers. -->
  <Style Selector="Button.size.launcher">
    <Setter Property="Height" Value="56" />
    <Setter Property="FontSize" Value="17" />
  </Style>
  <Style Selector="Button.size:disabled">
    <Setter Property="Background" Value="{StaticResource SurfaceDisabled}" />
    <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
  </Style>
  <Style Selector="Button.segment:pointerover, Button.size:pointerover">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Button.segment.selected, Button.size.selected">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.segment.focused /template/ Border#Chrome, Button.size.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>

  <!-- Settings rows and switches. -->
  <Style Selector="Button.settingRow">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style Selector="Button.settingRow:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
  </Style>
  <Style Selector="Button.settingRow.focused /template/ Border#Chrome, Button.action.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Button.action">
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Button.action:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.action.primaryAction">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <!-- Greyed out, e.g. "Nach Updates suchen" while a check runs. -->
  <Style Selector="Button.action:disabled, Button.action.primaryAction:disabled">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.action.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>

  <!-- Buttons that act only when held (#242, Pan's dialogs and its settings row): the fill runs over the hold time and
       the button acts once it is full; letting go earlier empties it. Each fill needs its own <ScaleTransform ScaleX="0" />. -->
  <Style Selector="Button.hold">
    <Setter Property="Height" Value="56" />
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{StaticResource PromptBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.hold TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="26,0" />
  </Style>
  <Style Selector="Button.hold.small">
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <!-- The answer that is safe to give, light as the focused tab. -->
  <Style Selector="Button.hold.light">
    <Setter Property="Background" Value="{StaticResource TextStrong}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="Button.hold.raised">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <!-- Shown, but it can't act yet (Steam still tries the update). -->
  <Style Selector="Button.hold.locked">
    <Setter Property="Background" Value="{StaticResource SurfaceDisabled}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.hold.holding">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.hold.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingGap}" />
  </Style>
  <Style Selector=".hold Border.holdClip">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="CornerRadius" Value="28" />
  </Style>
  <Style Selector="Button.hold.small Border.holdClip">
    <Setter Property="CornerRadius" Value="24" />
  </Style>
  <Style Selector="Border.holdPill Border.holdClip">
    <Setter Property="CornerRadius" Value="23" />
  </Style>
  <Style Selector=".hold Border.holdFill">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="RenderTransformOrigin" Value="0%,50%" />
  </Style>
  <Style Selector="Button.hold.light Border.holdFill">
    <Setter Property="Background" Value="{StaticResource TextSoft}" />
  </Style>
  <!-- Let go: the fill empties at once. A finished fill animation keeps its value, so ending it doesn't reset it (owner's test of #214). -->
  <Style Selector=".hold:not(.holding) Border.holdFill">
    <Style.Animations>
      <Animation Duration="0:0:0.001" FillMode="Forward">
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="0" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=".hold.holding.one Border.holdFill">
    <Style.Animations>
      <Animation Duration="0:0:1" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector=".hold.holding.three Border.holdFill">
    <Style.Animations>
      <Animation Duration="0:0:3" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleX" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleX" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The pill of a settings row held with [A] ("Steam Controller und Puck übernehmen"): stays dark when focused, so the fill shows. -->
  <Style Selector="Border.holdPill">
    <Setter Property="Width" Value="250" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <Style Selector="Border.holdPill TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.holdPill.holding TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Border.dangerBox">
    <Setter Property="Background" Value="{StaticResource DangerSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="22,16" />
  </Style>
  <Style Selector="Border.dangerBox.strong">
    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="Padding" Value="22,20" />
  </Style>
  <Style Selector="Border.panStatus">
    <Setter Property="Background" Value="{StaticResource SurfaceDisabled}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChangelogBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="22,18" />
  </Style>
  <Style Selector="Border.foundChip">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{StaticResource SurfaceDisabled}" />
    <Setter Property="BorderBrush" Value="{StaticResource ChangelogBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Buttons on the detail page (#499): "Spielen" and the buttons beside it on the artwork. -->
  <Style Selector="Button.detailAction">
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="30" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{StaticResource DetailActionOnArt}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.detailAction:pointerover">
    <Setter Property="Background" Value="{StaticResource DetailActionOnArtHover}" />
  </Style>
  <Style Selector="Button.detailAction.primary">
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="Padding" Value="18,0,34,0" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="Button.detailAction.primary:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
  </Style>
  <Style Selector="Button.detailAction:disabled">
    <Setter Property="Background" Value="{StaticResource DetailActionOnArt}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.detailAction.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingGap}" />
  </Style>
  <Style Selector="Border.detailChip">
    <Setter Property="Background" Value="{StaticResource DetailChip}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,6,14,6" />
  </Style>
  <Style Selector="Border.detailChip.running">
    <Setter Property="Background" Value="{StaticResource Running}" />
    <Setter Property="Padding" Value="10,6,14,6" />
  </Style>
  <Style Selector="Border.detailStat">
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="24,20" />
  </Style>
  <!-- The quiet note beside the buttons: text with an icon, no surface, no border, never focused. -->
  <Style Selector="Path.detailNoteIcon">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The rail of areas: each with its icon, name and value line; the open one lighter, the focused one ringed. -->
  <Style Selector="Button.detailRail">
    <Setter Property="MinHeight" Value="62" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.detailRail:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
  </Style>
  <Style Selector="Button.detailRail.open">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.detailRail.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Border.railIcon">
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <Style Selector="Button.detailRail.open Border.railIcon">
    <Setter Property="Background" Value="{StaticResource DetailRailIconOpen}" />
  </Style>
  <Style Selector="Border.railIcon Path">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.detailRail.open Border.railIcon Path">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="TextBlock.railValue">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Button.detailRail.open TextBlock.railValue">
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <!-- An area's rows (pattern "Leiste" like the settings): a greyed row keeps the focus but reads as off. -->
  <Style Selector="Button.detailRow">
    <Setter Property="MinHeight" Value="72" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20,10" />
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.detailRow.focused">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.detailRow.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="TextBlock.rowTitle">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Button.detailRow.danger TextBlock.rowTitle">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="TextBlock.rowSubtitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.rowValue">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.detailRow.greyed TextBlock.rowTitle">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.detailRow.greyed TextBlock.rowValue">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.detailRow.greyed TextBlock.rowSubtitle">
    <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
  </Style>
  <Style Selector="Border.detailInfoBox">
    <Setter Property="Width" Value="336" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <!-- A value row's chip on the detail page (#506): the settings' value pill, lighter while the row has the focus. -->
  <Style Selector="Button.detailRow.focused Border.valuePill">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="Button.detailRow.focused Button.valueArrow">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.detailRow.focused Button.valueArrow Path">
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Button.detailRow.greyed Border.valuePill">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <!-- One box per value of a value row in an info box (#506), the current one highlighted; same everywhere. -->
  <!-- A greyed-out row's boxes read as off, like the row. -->
  <Style Selector="views|ValueBoxesView.dimmed">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="Border.valueBox">
    <Setter Property="Background" Value="{StaticResource ValueBoxSurface}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style Selector="Border.valueBox.current">
    <Setter Property="Background" Value="{StaticResource ValueBoxCurrentSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource ValueBoxCurrentBorder}" />
  </Style>
  <Style Selector="TextBlock.valueBoxTitle">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.valueBox.current TextBlock.valueBoxTitle">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="TextBlock.valueBoxText">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Border.valueBox.current TextBlock.valueBoxText">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>

  <!-- The edge fade's defaults (#237); each place sets only what differs. Click-through: clicks and the wheel reach the
       content under it. -->
  <Style Selector="ctl|EdgeFade">
    <Setter Property="FadeColor" Value="{StaticResource BgColor}" />
    <Setter Property="Curve" Value="{StaticResource EdgeFadeCurve}" />
    <Setter Property="Overlap" Value="2" />
    <Setter Property="Duration" Value="0:0:0.2" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- LT/RT beside the search's hits. -->
  <Style Selector="Button.carouselNav">
    <Setter Property="Height" Value="48" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.carouselNav.kbd">
    <Setter Property="CornerRadius" Value="10" />
  </Style>

  <!-- Search and settings in the header: the key that opens them beside their symbol (#127). -->
  <Style Selector="Button.headerChip">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="8,0,14,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.headerChip:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <!-- The tab strip's dividers keep their gap while hidden, so the strip doesn't move when they appear. -->
  <Style Selector="Border.tabDivider">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Border.tabDivider.shown">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Entries of a game's context menu. -->
  <Style Selector="Button.menuItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="MinHeight" Value="52" />
    <Setter Property="Padding" Value="16,12" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.menuItem:pointerover, Button.menuItem.focused">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.menuItem.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingInset}" />
  </Style>
  <Style Selector="Button.menuItem Path.icon">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.menuItem.danger">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Button.menuItem.danger Path.icon">
    <Setter Property="Stroke" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Button.menuItem:disabled">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.menuItem:disabled Path.icon">
    <Setter Property="Stroke" Value="{StaticResource TextDisabled}" />
  </Style>
  <Style Selector="Button.menuItem TextBlock.note">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.menuItem:disabled TextBlock.note">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.menuItem.broken">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.menuItem.broken Path.icon">
    <Setter Property="Stroke" Value="{StaticResource TextDisabled}" />
  </Style>

  <!-- The settings page (#15, pattern "Leiste"): a column of rows, each with its value on the right, and the info panel. -->
  <!-- No fixed height: Uniform puts a flat icon (the controller) at the top of a square box, above the text's middle. -->
  <Style Selector="Path.tabIcon">
    <Setter Property="Width" Value="22" />
    <Setter Property="MaxHeight" Value="22" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.settingsGroup">
    <Setter Property="Margin" Value="18,18,0,6" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LetterSpacing" Value="1.5" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <!-- A group of settings in a box of its own; each row is a piece of it, the first and last round it off, a line
       parts the rows (owner, 2026-10-22). The padding around each row leaves room for its focus ring, which the next
       piece would otherwise paint over. -->
  <Style Selector="Border.groupBox">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource GroupDivider}" />
    <!-- The box shows through where the line fades out. -->
    <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
    <!-- The line tops every piece but the first; each piece reaches 1 px under the one above, so the scaled layout
         leaves no seam between them. -->
    <Setter Property="BorderThickness" Value="0,2,0,0" />
    <Setter Property="Margin" Value="0,-1,0,0" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
  <Style Selector="Border.groupBox.first">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="8,8,8,5" />
    <Setter Property="CornerRadius" Value="20,20,0,0" />
  </Style>
  <Style Selector="Border.groupBox.last">
    <Setter Property="Padding" Value="8,5,8,8" />
    <Setter Property="CornerRadius" Value="0,0,20,20" />
  </Style>
  <Style Selector="Border.groupBox.first.last">
    <Setter Property="Padding" Value="8" />
    <Setter Property="CornerRadius" Value="20" />
  </Style>
  <!-- A setting that depends on the one above it stands in below it (owner, 2026-10-22). -->
  <Style Selector="Button.settingRow.indent">
    <Setter Property="Margin" Value="36,0,0,0" />
  </Style>
  <Style Selector="Button.settingRow.indentTwice">
    <Setter Property="Margin" Value="72,0,0,0" />
  </Style>
  <Style Selector="Button.settingRow.pageRow">
    <Setter Property="MinHeight" Value="74" />
    <Setter Property="Padding" Value="18,12,22,12" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>
  <Style Selector="Button.settingRow.pageRow.focused">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Border.infoPanel">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <!-- A box in the info panel below the description, e.g. "Status" (owner, 2026-10-22); a frame only, so mode cards
       inside keep their own background. -->
  <Style Selector="Border.infoSection">
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="22,18" />
  </Style>
  <!-- "Letzte Meldungen" (#433): one entry per line, divided by a rule; the kind as a chip. -->
  <Style Selector="Border.messageEntry">
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="4,12" />
  </Style>
  <Style Selector="TextBlock.messageTime">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.messageText">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A toast ("Meldung") filled, a status message outlined. -->
  <Style Selector="Border.kindChip">
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.kindChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="Border.kindChip.toast">
    <Setter Property="Background" Value="{StaticResource InfoNoteSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource InfoNoteSurface}" />
  </Style>
  <Style Selector="Border.kindChip.toast TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InfoNoteText}" />
  </Style>
  <!-- "Behoben 10:38": a status message that went, marked on its own entry. -->
  <Style Selector="Border.endChip">
    <Setter Property="BorderBrush" Value="{StaticResource Success}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.endChip TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource Success}" />
  </Style>
  <!-- "×37": the repeats of an error held back by its throttling (#399). -->
  <Style Selector="Border.repeatChip">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.repeatChip TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="TextBlock.infoText">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="LineHeight" Value="27" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Ellipse.infoBullet">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Margin" Value="0,11,0,0" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Fill" Value="{StaticResource Accent}" />
  </Style>
  <!-- A switch or a choice: ◀ value ▶, the arrows for the mouse, ◀ ▶ on the D-pad for the controller. -->
  <Style Selector="Border.valuePill">
    <Setter Property="Width" Value="250" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.valuePill">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="Border.valuePill.locked">
    <Setter Property="Opacity" Value="0.35" />
  </Style>
  <!-- The whole switch is a target, not just its arrows (owner, 2026-10-22); the arrows lie on top of it. -->
  <Style Selector="Button.valueToggle">
    <Setter Property="Margin" Value="-8,0" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.valueArrow">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.valueArrow Path">
    <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="Button.settingRow.focused Button.valueArrow, Button.valueArrow:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.settingRow.focused Button.valueArrow Path, Button.valueArrow:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Button.valueArrow:disabled">
    <Setter Property="Opacity" Value="0.3" />
  </Style>
  <!-- As wide as the chevron itself (7 × 14): a square box left it off-centre in its button (owner, 2026-10-22). -->
  <Style Selector="Path.chevronLeft, Path.chevronRight">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.chevronLeft">
    <Setter Property="Data" Value="M15 5l-7 7 7 7" />
  </Style>
  <Style Selector="Path.chevronRight">
    <Setter Property="Data" Value="M9 5l7 7-7 7" />
  </Style>
  <Style Selector="TextBlock.valueText">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.valuePill TextBlock.valueText.on">
    <Setter Property="Foreground" Value="{StaticResource Success}" />
  </Style>
  <!-- A count beside a row's title that asks for the player (#491: games waiting for a choice). -->
  <Style Selector="Border.rowBadge">
    <Setter Property="MinWidth" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Warning}" />
  </Style>
  <Style Selector="Border.rowBadge > TextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource OnWarning}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- An action on the right of a row ("Erneut versuchen ›"): a pill as wide as the value chips, so the rows' right edge
       stays one column; it fills with the accent while its row has the focus, like a button about to be pressed
       (owner, 2026-10-22). The whole row is the button. -->
  <Style Selector="Border.rowGo">
    <Setter Property="Width" Value="250" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="Padding" Value="22,0,18,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <!-- Only the label: a button glyph inside the pill keeps its own look. -->
  <Style Selector="Border.rowGo > Grid > TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.rowGo Path">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.rowGo.primary > Grid > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Border.rowGo.primary Path">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.rowGo">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.rowGo > Grid > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.rowGo Path">
    <Setter Property="Stroke" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Border.rowGo.disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <!-- Focused but not now (e.g. a log that doesn't exist, #433): no accent, A does nothing there. -->
  <Style Selector="Button.settingRow.focused Border.rowGo.disabled">
    <Setter Property="Background" Value="{StaticResource SurfaceDisabled}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.rowGo.disabled > Grid > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.rowGo.disabled Path">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.rowValue">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <!-- A text row (#137): the value in a field with a pencil; while it is written, a caret and the accent's frame. -->
  <Style Selector="Border.textField">
    <Setter Property="Width" Value="250" />
    <Setter Property="Height" Value="46" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.settingRow.focused Border.textField">
    <Setter Property="Background" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="Border.textField.editing">
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.textField.editing.problem">
    <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Border.textField TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.fieldText">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="TextBlock.fieldPrefix">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.fieldCaret">
    <Setter Property="Width" Value="2" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Margin" Value="1,0" />
    <Setter Property="CornerRadius" Value="1" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.pencil">
    <Setter Property="Data" Value="M4 20h4L19 9l-4-4L4 16z" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.rowProblem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A launcher's page (#137): the launchers beside it, turned to with LT/RT or a click. -->
  <Style Selector="Button.neighbour">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="16" />
  </Style>
  <Style Selector="Button.neighbour:pointerover /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource HoverRing}" />
  </Style>
  <Style Selector="ctl|LauncherLogo.neighbourLogo">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Opacity" Value="0.7" />
  </Style>
  <!-- Something to type in the info panel, e.g. "/steam hollow" (#137). -->
  <Style Selector="Border.infoExample">
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="TextBlock.exampleSample">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="TextBlock.exampleEffect">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Not available on this PC (no Windows, no Steam): the setting row stays readable but greyed out. -->
  <Style Selector="Button.settingRow.unavailable">
    <Setter Property="Opacity" Value="0.55" />
  </Style>
  <!-- An action shown inside a setting row, e.g. "Installieren"; the row itself is the button. -->
  <Style Selector="Border.rowAction">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="20,0" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.rowAction > TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.modeCard">
    <Setter Property="Background" Value="{StaticResource SurfaceHover}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16,12" />
  </Style>
  <Style Selector="Border.prompt">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="BorderBrush" Value="{StaticResource PromptBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="44,36,44,28" />
    <Setter Property="BoxShadow" Value="{StaticResource DialogShadow}" />
  </Style>
  <!-- ✕ in a dialog's top right corner, shown while mouse or keyboard is in use (the controller closes with B). -->
  <Style Selector="Button.dialogClose">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.dialogClose:pointerover">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.dialogClose Path">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.dialogClose:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Border.promptIcon">
    <Setter Property="Width" Value="52" />
    <Setter Property="Height" Value="52" />
    <Setter Property="CornerRadius" Value="26" />
    <Setter Property="Background" Value="{StaticResource PromptIcon}" />
  </Style>
  <Style Selector="Border.promptIcon TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.promptIcon.warning">
    <Setter Property="Background" Value="{StaticResource PromptIconWarning}" />
  </Style>
  <Style Selector="Border.promptIcon.warning TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Warning}" />
  </Style>
  <Style Selector="Border.promptGame">
    <Setter Property="Background" Value="{StaticResource PromptGame}" />
    <Setter Property="BorderBrush" Value="{StaticResource Warning}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="20,16" />
  </Style>
  <!-- "Treiber werden installiert" (#413, designs T413Dialog). -->
  <Style Selector="Border.promptIcon.failed">
    <Setter Property="Background" Value="{StaticResource DangerSurface}" />
  </Style>
  <Style Selector="Border.promptIcon.failed TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Border.usbHint">
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{StaticResource PromptBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="22,16" />
  </Style>
  <Style Selector="ProgressBar.installRun">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource ProgressTrack}" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <!-- A row's progress on the settings page, e.g. the artwork search (#489). -->
  <Style Selector="ProgressBar.rowProgress">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{StaticResource ProgressTrack}" />
    <Setter Property="Foreground" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ProgressBar.installRun.failed">
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="TextBlock.installCount">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.installStep">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Border.installStep.running">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Border.installStep.failed">
    <Setter Property="Background" Value="{StaticResource DangerSurface}" />
  </Style>
  <Style Selector="Border.installStep TextBlock.stepTitle">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.installStep.running TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.installStep.pending TextBlock.stepTitle">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.installStep.failed TextBlock.stepTitle">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Path.stepDone, Path.stepFailed">
    <Setter Property="StrokeThickness" Value="2.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
  </Style>
  <Style Selector="Path.stepDone">
    <Setter Property="Stroke" Value="{StaticResource Success}" />
  </Style>
  <Style Selector="Path.stepFailed">
    <Setter Property="Stroke" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Ellipse.stepPending">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.installError">
    <Setter Property="Background" Value="{StaticResource DangerSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="22,16" />
  </Style>
  <!-- "Controller zuordnen" (#238 D3a, designs T238Modal). -->
  <Style Selector="Path.layoutsIcon">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="StrokeThickness" Value="1.9" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.valuePill.layoutPill">
    <Setter Property="Width" Value="340" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
  </Style>
  <Style Selector="TextBlock.rowSubtitle">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.valueText.notTakenOver">
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="TextBlock.valueText.locked">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Path.lockIcon">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
    <Setter Property="StrokeThickness" Value="2.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="TextBlock.layoutLockNote">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,8,0,4" />
  </Style>
  <Style Selector="TextBlock.layoutsHint">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.promptBody">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A value that a click changes, shown as plain text rather than as a dropdown. -->
  <Style Selector="Button.modeValue">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- The Steam Controller mode while Pan's emulation doesn't run (#242): greyed out, the triangle beside it. -->
  <Style Selector="Button.modeValue.broken TextBlock.value">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.switch">
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="32" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="Border.switch.on">
    <Setter Property="Background" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Border.switch > Ellipse">
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Fill" Value="{StaticResource TextStrong}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.switch.on > Ellipse">
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <!-- A value from 1 to 9 in a setting row (mouse mode): arrows for the mouse, D-pad left/right for the controller. -->
  <Style Selector="Button.stepperArrow">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.stepperArrow:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.stepperArrow:disabled">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <Style Selector="TextBlock.stepperValue">
    <Setter Property="MinWidth" Value="130" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Locked while Steam, Pan or VIIPER start or stop: the switch keeps its position but can't be flipped. -->
  <Style Selector="Border.switch.locked, Border.rowAction.locked">
    <Setter Property="Opacity" Value="0.35" />
  </Style>

  <!-- Loading spinner: an open circle that keeps turning. -->
  <Style Selector="Path.spinner">
    <Setter Property="Data" Value="M12 3a9 9 0 1 1 -9 9" />
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
    <Setter Property="StrokeThickness" Value="2.5" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <!-- Each spinner needs its own <RotateTransform /> as RenderTransform; its angle is animated. -->
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The large one around a countdown (#326). -->
  <Style Selector="Path.spinner.large">
    <Setter Property="Data" Value="M100 8a92 92 0 1 1 -92 92" />
    <Setter Property="StrokeThickness" Value="6" />
    <Setter Property="Width" Value="200" />
    <Setter Property="Height" Value="200" />
  </Style>

  <!-- The layout is 1920×1080, scaled to the window; a window of another shape leaves bars beside or above and below it
       in the window's background. Bands that run from edge to edge reach into those bars, so they don't end in the middle
       of the window: the search's keyboard (bleed), its legend (bleedDown), and the search's background and the dimming
       behind dialogs, which cover what's beneath them in the bars too (bleedAll). -->
  <Style Selector=":is(Control).bleed">
    <Setter Property="Margin" Value="-1920,0" />
  </Style>
  <Style Selector="Border.bleedDown">
    <Setter Property="Margin" Value="-1920,0,-1920,-1080" />
  </Style>
  <Style Selector=":is(Control).bleedAll">
    <Setter Property="Margin" Value="-1920,-1080" />
  </Style>

  <!-- Scrollbars that match the theme: thin, rounded, dark. -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{StaticResource Line}" />
    <Setter Property="CornerRadius" Value="5" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb:pointerover">
    <Setter Property="Background" Value="{StaticResource LineStrong}" />
  </Style>

  <!-- Search (#12): launcher chips. -->
  <Style Selector="Button.chip">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <!-- A thin line between groups: after "Alle Launcher", before the sort button when the chips come close. -->
  <Style Selector="Border.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Border.divider.unneeded">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="Button.chip.all">
    <Setter Property="Padding" Value="18,0" />
  </Style>
  <Style Selector="Button.chip:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.chip.on">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Button.chip.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Button.chip ctl|LauncherLogo.chipLogo">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Button.chip.on ctl|LauncherLogo.chipLogo">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <!-- Search hits: a cover with the launcher's badge, the launcher's name below. -->
  <Style Selector="Button.resultTile">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.resultTile:pointerover /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource HoverRing}" />
  </Style>
  <Style Selector="Button.resultTile.focused">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
    <Setter Property="ZIndex" Value="2" />
  </Style>
  <Style Selector="Button.resultTile.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingLifted}" />
  </Style>
  <Style Selector="Border.launcherBadge">
    <Setter Property="BoxShadow" Value="{StaticResource LauncherBadgeRing}" />
  </Style>
  <Style Selector="ctl|LauncherLogo.onCover">
    <Setter Property="Plate" Value="{StaticResource LauncherBadgePlate}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <!-- Holding A on a hit fills a ring along the cover's edge, as around the library's preview. -->
  <Style Selector="Button.resultTile ctl|HoldRing">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.resultTile.holding ctl|HoldRing">
    <Setter Property="IsVisible" Value="True" />
    <Style.Animations>
      <Animation Duration="0:0:0.75" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="Progress" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Progress" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- The hits slide when the window moves (MainWindow.axaml.cs); in the grid they wrap after seven. -->
  <Style Selector="ItemsControl.hits">
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ItemsControl.hits.grid">
    <Setter Property="Width" Value="1450" />
  </Style>
  <Style Selector="Button.turnHits">
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.turnHits Path.chevron">
    <Setter Property="Stroke" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Border.stickHint">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="8,6,16,6" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- The on-screen keyboard slides in from below and back; the tab on its top edge moves with it. -->
  <Style Selector="ctl|RevealPanel.keyboardDrawer">
    <Setter Property="Reveal" Value="0" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Reveal" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ctl|RevealPanel.keyboardDrawer.out">
    <Setter Property="Reveal" Value="1" />
  </Style>
  <Style Selector="Button.keyboardTab">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="18,0" />
    <Setter Property="CornerRadius" Value="14,14,0,0" />
    <Setter Property="Background" Value="{StaticResource KeyboardSurface}" />
  </Style>
  <Style Selector="Button.keyboardTab Path">
    <Setter Property="Stroke" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.keyboardTab:pointerover Path">
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
  </Style>

  <!-- The search's empty states: a picture and the text below it. A theme may replace this template as a whole. -->
  <Style Selector="ContentControl.searchEmpty">
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="search:SearchEmptyState">
        <!-- The glow stays inside the panel: anything sticking out would be cut off with a hard edge. -->
        <Panel Width="640">
          <Ellipse Width="640" Height="360" VerticalAlignment="Top" Fill="{StaticResource EmptyStateGlow}" IsHitTestVisible="False" />
          <StackPanel Spacing="20" Margin="0,40,0,0">
            <!-- Nothing typed yet: three covers under a lens. -->
            <Canvas Width="320" Height="150" IsVisible="{Binding !IsNoHits}">
              <Border Canvas.Left="86" Canvas.Top="30" Width="76" Height="100" CornerRadius="10" Background="{StaticResource EmptyStateCard}"
                      BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="1.5" RenderTransform="rotate(-14deg)" />
              <Border Canvas.Left="158" Canvas.Top="30" Width="76" Height="100" CornerRadius="10" Background="{StaticResource EmptyStateCard}"
                      BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="1.5" RenderTransform="rotate(14deg)" />
              <Border Canvas.Left="122" Canvas.Top="16" Width="76" Height="100" CornerRadius="10" Background="{StaticResource EmptyStateCard}"
                      BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="1.5">
                <Panel Margin="10">
                  <Border Width="16" Height="16" CornerRadius="4" Background="{StaticResource EmptyStateCardBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                  <StackPanel Spacing="6" VerticalAlignment="Bottom">
                    <Border Width="44" Height="6" CornerRadius="3" Background="{StaticResource EmptyStateCardLine}" HorizontalAlignment="Left" />
                    <Border Width="30" Height="6" CornerRadius="3" Background="{StaticResource EmptyStateCardLine}" HorizontalAlignment="Left" />
                  </StackPanel>
                </Panel>
              </Border>
              <Line StartPoint="230,112" EndPoint="252,134" Stroke="{StaticResource EmptyStateLensRim}" StrokeThickness="10" StrokeLineCap="Round" />
              <Ellipse Canvas.Left="176" Canvas.Top="60" Width="64" Height="64" Fill="{StaticResource EmptyStateLens}" Stroke="{StaticResource EmptyStateLensRim}" StrokeThickness="7" />
              <Path Data="M64 34l3 7 7 3-7 3-3 7-3-7-7-3 7-3z M266 22l2 5 5 2-5 2-2 5-2-5-5-2 5-2z M250 70l1.5 3.5 3.5 1.5-3.5 1.5-1.5 3.5-1.5-3.5-3.5-1.5 3.5-1.5z"
                    Fill="{StaticResource EmptyStateSparkle}" />
            </Canvas>
            <!-- Nothing found: empty frames, and a cross in the lens. -->
            <Canvas Width="320" Height="150" IsVisible="{Binding IsNoHits}">
              <Border Canvas.Left="86" Canvas.Top="30" Width="76" Height="100" CornerRadius="10" BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="1.5"
                      RenderTransform="rotate(-14deg)" Opacity="0.6" />
              <Border Canvas.Left="158" Canvas.Top="30" Width="76" Height="100" CornerRadius="10" BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="1.5"
                      RenderTransform="rotate(14deg)" Opacity="0.6" />
              <Rectangle Canvas.Left="122" Canvas.Top="16" Width="76" Height="100" RadiusX="10" RadiusY="10" Fill="{StaticResource EmptyStateCard}"
                         Stroke="{StaticResource EmptyStateCardLine}" StrokeThickness="1.5" StrokeDashArray="4,3" />
              <Line StartPoint="230,112" EndPoint="252,134" Stroke="{StaticResource EmptyStateMiss}" StrokeThickness="10" StrokeLineCap="Round" />
              <Ellipse Canvas.Left="176" Canvas.Top="60" Width="64" Height="64" Fill="{StaticResource EmptyStateLens}" Stroke="{StaticResource EmptyStateMiss}" StrokeThickness="7" />
              <Path Data="M199 83l18 18 M217 83l-18 18" Stroke="{StaticResource EmptyStateMiss}" StrokeThickness="4" StrokeLineCap="Round" />
            </Canvas>
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextStrong}" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Text}" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" HorizontalAlignment="Center" />
            </StackPanel>
          </StackPanel>
        </Panel>
      </DataTemplate>
    </Setter>
  </Style>

  <!-- A button inside a line of text (ButtonTextBlock), e.g. "⧉ + ≡ gedrückt halten". -->
  <Style Selector="Border.glyph.inline">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="Margin" Value="1,0" />
  </Style>
  <Style Selector="Border.glyph.inline.round">
    <Setter Property="Width" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.glyph.inline > TextBlock">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Border.glyph.inline > Path, Border.glyph.small > Path">
    <Setter Property="Width" Value="9" />
    <Setter Property="Height" Value="9" />
    <Setter Property="StrokeThickness" Value="1.8" />
  </Style>
  <Style Selector="Border.glyph.small">
    <Setter Property="MinWidth" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Padding" Value="6,0" />
  </Style>
  <Style Selector="Border.glyph.small.round">
    <Setter Property="Width" Value="22" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Border.glyph.small > TextBlock">
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!-- The on-screen keyboard (#110): its window over other programs in the mouse mode, and its keys there and in the search. -->
  <Style Selector="Border.mouseModeKeyboard">
    <Setter Property="Background" Value="{StaticResource KeyboardSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="TextElement.Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Border.mouseModeKeyboardLegend">
    <Setter Property="BorderBrush" Value="{StaticResource Line}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0,12,0,0" />
    <Setter Property="Margin" Value="0,16,0,0" />
  </Style>
  <Style Selector="TextBlock.keyboardHint">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.boardKey">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>
  <!-- The tall ISO Enter draws its edge and ring on its shape instead. -->
  <Style Selector="Button.boardKey:not(.tallEnter) /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource KeyCapEdge}" />
  </Style>
  <Style Selector="Button.boardKey.focused:not(.tallEnter) /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource KeyCapEdgeFocused}" />
  </Style>
  <Style Selector="Button.boardKey:pointerover, Button.boardKey.focused">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <!-- Shift or AltGr on. -->
  <Style Selector="Button.boardKey.on">
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
  </Style>
  <Style Selector="Button.boardKey.on:pointerover, Button.boardKey.on.focused">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
  </Style>
  <!-- AltGr for a layout without that level (US). -->
  <Style Selector="Button.boardKey.unavailable">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <!-- Caps lock: empty and darker; nothing reacts to it. -->
  <Style Selector="Button.boardKey.blank, Button.boardKey.blank:pointerover">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.boardKey TextBlock.keyHint">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Button.boardKey TextBlock.keySymbol">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.boardKey TextBlock.keyText">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.boardKey Path.keyIcon">
    <Setter Property="Stroke" Value="{StaticResource Text}" />
  </Style>
  <!-- ↹ at the size of the other keys' symbols (keySymbol, 19 px), stroked like the button icons. -->
  <Style Selector="Button.boardKey Path.keyIcon.tab">
    <Setter Property="Width" Value="17" />
    <Setter Property="Height" Value="17" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.boardKey Rectangle.keyIconBar">
    <Setter Property="Fill" Value="{StaticResource Text}" />
    <Setter Property="RadiusX" Value="0.8" />
    <Setter Property="RadiusY" Value="0.8" />
  </Style>
  <!-- The tall ISO Enter is drawn by its shape alone: no background, so only the L takes clicks. -->
  <Style Selector="Button.boardKey.tallEnter, Button.boardKey.tallEnter:pointerover, Button.boardKey.tallEnter.focused">
    <Setter Property="Background" Value="{x:Null}" />
  </Style>
  <Style Selector="Button.boardKey Path.enterFace">
    <Setter Property="Fill" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.boardKey:pointerover Path.enterFace, Button.boardKey.focused Path.enterFace">
    <Setter Property="Fill" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.boardKey Border.enterEdge">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BoxShadow" Value="{StaticResource KeyCapEdge}" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.boardKey Path.enterRing">
    <Setter Property="Stroke" Value="{StaticResource TextStrong}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Button.boardKey.focused Path.enterRing">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="Border.keyboardLayoutMenu">
    <Setter Property="Width" Value="380" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="BoxShadow" Value="{StaticResource LayoutMenuShadow}" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <!-- The keyboard's layout menu (R3). Low enough for all five to fit within the keys' height: the mouse mode's window
       is only as large as the keyboard. -->
  <Style Selector="Button.layoutItem">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
  </Style>
  <Style Selector="Button.layoutItem:pointerover, Button.layoutItem.selected, Button.layoutItem.focused">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.layoutItem.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRingInset}" />
  </Style>
  <!-- The launcher settings (#136). A launcher's row: its tab key, logo, name and state; dimmed while inactive. -->
  <Style Selector="Border.tabKey">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BoxShadow" Value="{StaticResource KeyCapEdge}" />
  </Style>
  <Style Selector="Border.tabKey > TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A launcher's logo (#138): its own logo takes the text colour around it, the letter on the tile is always light. -->
  <Style Selector="ctl|LauncherLogo">
    <Setter Property="MonogramBrush" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="ctl|LauncherLogo.missing">
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="ctl|LauncherLogo.launcherLogo">
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Panel.launcherInactive > ctl|LauncherLogo.launcherLogo, StackPanel.launcherInactive > TextBlock.launcherName">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TextBlock.launcherStatus">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.launcherStatus.warning">
    <Setter Property="Foreground" Value="{StaticResource Warning}" />
  </Style>
  <Style Selector="TextBlock.launcherStatus.info">
    <Setter Property="Foreground" Value="{StaticResource Info}" />
  </Style>
  <Style Selector="Path.statusIcon.small">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Stretch" Value="Uniform" />
  </Style>
  <Style Selector="TextBlock.valueText.missing">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>
  <!-- Not moved aside: the list's edge would cut off the ring (owner, 2026-10-22). -->
  <Style Selector="Button.settingRow.lifted">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Button.settingRow.lifted /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource LiftedRing}" />
  </Style>

  <!-- The first start's "Fertig" (#139): ≡ ends the question from any row, so it is always drawn ready, the width of the
       info panel. -->
  <Style Selector="Button.finish">
    <Setter Property="Height" Value="64" />
    <Setter Property="CornerRadius" Value="32" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
    <Setter Property="FontSize" Value="20" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Button.finish:pointerover">
    <Setter Property="Background" Value="{StaticResource AccentHover}" />
  </Style>
  <Style Selector="Button.finish:disabled">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
  </Style>

  <!-- Its info panel: a note, the tab strip in miniature, the launcher's head and lines of facts. -->
  <Style Selector="Border.infoNote">
    <Setter Property="Background" Value="{StaticResource NoteSurface}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18,16" />
  </Style>
  <Style Selector="Border.infoNote TextBlock.noteText">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="23" />
    <Setter Property="Foreground" Value="{StaticResource NoteText}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- A note in its level's colour (owner, 2026-10-24): amber a warning, blue information. -->
  <Style Selector="Border.infoNote.info">
    <Setter Property="Background" Value="{StaticResource InfoNoteSurface}" />
  </Style>
  <Style Selector="Border.infoNote.info TextBlock.noteText">
    <Setter Property="Foreground" Value="{StaticResource InfoNoteText}" />
  </Style>
  <Style Selector="Border.infoNote.bold TextBlock.noteText">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.infoNote TextBlock.noteTitle">
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  <Style Selector="Border.miniTabs">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.miniTab">
    <Setter Property="Height" Value="38" />
    <Setter Property="CornerRadius" Value="19" />
    <Setter Property="Padding" Value="8,0,14,0" />
  </Style>
  <Style Selector="Border.miniTab TextBlock.miniTabName">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.miniTab.highlighted">
    <Setter Property="BoxShadow" Value="{StaticResource SearchFieldRing}" />
  </Style>
  <Style Selector="TextBlock.launcherState">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.launcherState.active">
    <Setter Property="Foreground" Value="{StaticResource Success}" />
  </Style>
  <Style Selector="Border.infoFact">
    <Setter Property="BorderBrush" Value="{StaticResource FactLine}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="MinHeight" Value="44" />
  </Style>
  <Style Selector="Border.infoFact TextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.infoFact TextBlock.factLabel">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.infoFact TextBlock.factValue">
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="Border.infoFact TextBlock.factValue.muted">
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.infoFact TextBlock.factValue.good">
    <Setter Property="Foreground" Value="{StaticResource Success}" />
  </Style>

  <!-- An active launcher's tab without games, or of a launcher no longer found (#136): a picture in the style of the
       search's empty state. -->
  <Style Selector="ContentControl.tabEmpty">
    <Setter Property="ContentTemplate">
      <DataTemplate x:DataType="vm:EmptyTabViewModel">
        <Panel Width="200" Height="140">
          <!-- No games: two covers and a dashed one to come. -->
          <Canvas IsVisible="{Binding HasNoGames}">
            <Border Canvas.Left="34" Canvas.Top="22" Width="62" Height="88" CornerRadius="10" Background="{StaticResource EmptyStateCard}"
                    BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="3" RenderTransform="rotate(-10deg)" />
            <Border Canvas.Left="104" Canvas.Top="22" Width="62" Height="88" CornerRadius="10" Background="{StaticResource EmptyStateCard}"
                    BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="3" RenderTransform="rotate(10deg)" />
            <Rectangle Canvas.Left="69" Canvas.Top="14" Width="62" Height="96" RadiusX="10" RadiusY="10" Fill="{StaticResource EmptyStateLens}"
                       Stroke="{StaticResource EmptyStateCardBadge}" StrokeThickness="3" StrokeDashArray="2.6,2.3" />
            <Path Data="M92 62h16 M100 54v16" Stroke="{StaticResource EmptyStateSparkle}" StrokeThickness="3" StrokeLineCap="Round" />
            <Path Data="M28 18l3 7 7 3-7 3-3 7-3-7-7-3 7-3z M176 104l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" Fill="{StaticResource EmptyStateSparkle}" />
          </Canvas>
          <!-- No launcher active: a tab strip with dashed tabs still to fill, one about to be switched on. -->
          <Canvas IsVisible="{Binding HasNoLauncher}">
            <Rectangle Canvas.Left="6" Canvas.Top="52" Width="54" Height="34" RadiusX="17" RadiusY="17" Fill="{StaticResource EmptyStateCard}"
                       Stroke="{StaticResource EmptyStateCardLine}" StrokeThickness="3" StrokeDashArray="2.6,2.3" />
            <Rectangle Canvas.Left="140" Canvas.Top="52" Width="54" Height="34" RadiusX="17" RadiusY="17" Fill="{StaticResource EmptyStateCard}"
                       Stroke="{StaticResource EmptyStateCardLine}" StrokeThickness="3" StrokeDashArray="2.6,2.3" />
            <Border Canvas.Left="64" Canvas.Top="44" Width="72" Height="50" CornerRadius="25" Background="{StaticResource EmptyStateLens}"
                    BorderBrush="{StaticResource EmptyStateCardBadge}" BorderThickness="3" />
            <Path Data="M92 69h16 M100 61v16" Stroke="{StaticResource EmptyStateSparkle}" StrokeThickness="3.5" StrokeLineCap="Round" />
            <Path Data="M34 20l3 7 7 3-7 3-3 7-3-7-7-3 7-3z M170 104l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" Fill="{StaticResource EmptyStateSparkle}" />
          </Canvas>
          <!-- Not found: the launcher's logo with a question mark. -->
          <Canvas IsVisible="{Binding IsMissing}">
            <Border Canvas.Left="62" Canvas.Top="20" Width="76" Height="76" CornerRadius="18" Background="{StaticResource EmptyStateCard}"
                    BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="3">
              <ctl:LauncherLogo Classes="missing" Badge="{Binding Badge}" Width="40" Height="40" />
            </Border>
            <Ellipse Canvas.Left="108" Canvas.Top="72" Width="48" Height="48" Fill="{StaticResource EmptyStateLens}" Stroke="{StaticResource EmptyStateLensRim}" StrokeThickness="4" />
            <Path Data="M126 88a7 7 0 1 1 9 7c-2 1-3 2-3 4" Stroke="{StaticResource EmptyStateSparkle}" StrokeThickness="3.5" StrokeLineCap="Round" />
            <Ellipse Canvas.Left="129.6" Canvas.Top="103.6" Width="4.8" Height="4.8" Fill="{StaticResource EmptyStateSparkle}" />
            <Path Data="M40 30l3 7 7 3-7 3-3 7-3-7-7-3 7-3z" Fill="{StaticResource EmptyStateSparkle}" />
          </Canvas>
          <!-- Scan failed (#369): the launcher's logo with an exclamation mark. -->
          <Canvas IsVisible="{Binding IsScanFailed}">
            <Border Canvas.Left="62" Canvas.Top="20" Width="76" Height="76" CornerRadius="18" Background="{StaticResource EmptyStateCard}"
                    BorderBrush="{StaticResource EmptyStateCardLine}" BorderThickness="3">
              <ctl:LauncherLogo Badge="{Binding Badge}" Width="40" Height="40" />
            </Border>
            <Ellipse Canvas.Left="108" Canvas.Top="72" Width="48" Height="48" Fill="{StaticResource EmptyStateLens}" Stroke="{StaticResource EmptyStateLensRim}" StrokeThickness="4" />
            <Path Data="M132 84v11" Stroke="{StaticResource EmptyStateSparkle}" StrokeThickness="3.5" StrokeLineCap="Round" />
            <Ellipse Canvas.Left="129.6" Canvas.Top="101.6" Width="4.8" Height="4.8" Fill="{StaticResource EmptyStateSparkle}" />
          </Canvas>
        </Panel>
      </DataTemplate>
    </Setter>
  </Style>

  <!-- The status messages (#166, designs T166Library/T166Modal/T166Empty/T166Bausteine). -->
  <Style Selector="Button.headerChip.statusChip">
    <Setter Property="Padding" Value="8,0,10,0" />
  </Style>
  <!-- The update symbol: in the header chip and on an entry's disc; the dot marks it as Arcadia's own update. -->
  <Style Selector="Path.updateIcon">
    <Setter Property="Data" Value="M20 12a8 8 0 1 1 -2.3 -5.6 M20 4v4.5h-4.5" />
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Ellipse.updateDot">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Fill" Value="{StaticResource Accent}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Ellipse.updateDot.chipDot">
    <Setter Property="Stroke" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Margin" Value="0,2,2,0" />
  </Style>
  <Style Selector="Button.headerChip:pointerover Ellipse.updateDot.chipDot">
    <Setter Property="Stroke" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Ellipse.updateDot.discDot">
    <Setter Property="Stroke" Value="{StaticResource PromptIcon}" />
    <Setter Property="Margin" Value="0,-2,-2,0" />
  </Style>
  <Style Selector="Path.statusModalIcon">
    <Setter Property="Data" Value="M3 12h4l2.5-6 5 12 2.5-6h4" />
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.statusCount">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Left of the ✕, which mouse and keyboard show in the corner. -->
  <Style Selector="TextBlock.statusCount.besideClose">
    <Setter Property="Margin" Value="0,0,56,0" />
  </Style>
  <Style Selector="Border.statusEntry">
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="18,16" />
    <Setter Property="MinHeight" Value="76" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.statusEntry.focused">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <!-- The level in a tinted disc, so it shows by its outline also without colour. -->
  <Style Selector="Border.levelDisc">
    <Setter Property="Width" Value="48" />
    <Setter Property="Height" Value="48" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.levelDisc.error">
    <Setter Property="Background" Value="{StaticResource DangerSurface}" />
  </Style>
  <Style Selector="Border.levelDisc.warning">
    <Setter Property="Background" Value="{StaticResource PromptIconWarning}" />
  </Style>
  <Style Selector="Border.levelDisc.update">
    <Setter Property="Background" Value="{StaticResource PromptIcon}" />
  </Style>
  <Style Selector="Border.levelDisc.info">
    <Setter Property="Background" Value="{StaticResource InfoNoteSurface}" />
  </Style>
  <Style Selector="Path.levelIcon">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.statusTitle">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style Selector="TextBlock.statusSince">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
    <Setter Property="Margin" Value="0,0,0,2" />
  </Style>
  <Style Selector="TextBlock.statusShort">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- An entry's buttons; the chosen one of the focused entry is filled like a chosen tab, the fix stays blue otherwise. -->
  <Style Selector="Button.statusButton">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.statusButton.fix">
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Button.statusButton:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <Style Selector="Button.statusButton.focused, Button.statusButton.focused:pointerover">
    <Setter Property="Background" Value="{StaticResource TextStrong}" />
    <Setter Property="Foreground" Value="{StaticResource Bg}" />
  </Style>
  <Style Selector="TextBlock.statusOrder">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="StackPanel.statusEmpty">
    <Setter Property="Spacing" Value="26" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,8,0,22" />
  </Style>
  <Style Selector="StackPanel.statusEmpty TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.emptyLead">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.emptyHeadline">
    <Setter Property="FontSize" Value="40" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="TextBlock.emptyPraise">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="Canvas.confetti Path.popper">
    <Setter Property="Fill" Value="{StaticResource Warning}" />
  </Style>
  <Style Selector="Canvas.confetti Path.popperStripe">
    <Setter Property="Stroke" Value="{StaticResource Surface}" />
    <Setter Property="StrokeThickness" Value="5" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Canvas.confetti Path.streamer">
    <Setter Property="StrokeThickness" Value="4" />
    <Setter Property="StrokeLineCap" Value="Round" />
  </Style>
  <Style Selector="Canvas.confetti Path.streamer.soft">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Canvas.confetti Path.streamer.danger">
    <Setter Property="Stroke" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Canvas.confetti Path.streamer.success">
    <Setter Property="Stroke" Value="{StaticResource Success}" />
  </Style>
  <Style Selector="Canvas.confetti Path.streamer.accent">
    <Setter Property="Stroke" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Canvas.confetti Ellipse.checkDisc">
    <Setter Property="Fill" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Stroke" Value="{StaticResource Success}" />
    <Setter Property="StrokeThickness" Value="5" />
  </Style>
  <Style Selector="Canvas.confetti Path.checkMark">
    <Setter Property="Stroke" Value="{StaticResource Success}" />
    <Setter Property="StrokeThickness" Value="12" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
  </Style>
  <Style Selector="Canvas.confetti :is(Shape).flake.soft">
    <Setter Property="Fill" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Canvas.confetti :is(Shape).flake.danger">
    <Setter Property="Fill" Value="{StaticResource Danger}" />
  </Style>
  <Style Selector="Canvas.confetti :is(Shape).flake.success">
    <Setter Property="Fill" Value="{StaticResource Success}" />
  </Style>
  <Style Selector="Canvas.confetti :is(Shape).flake.accent">
    <Setter Property="Fill" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="Canvas.confetti :is(Shape).flake.warning">
    <Setter Property="Fill" Value="{StaticResource Warning}" />
  </Style>
  <!-- When the last entry goes the confetti falls once: no FillMode, so each piece ends where it is drawn. -->
  <Style Selector="Canvas.confetti.celebrating Path.flake">
    <Style.Animations>
      <Animation Duration="0:0:0.9" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Canvas.Top" Value="-36" />
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Canvas.Top" Value="0" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <Style Selector="Canvas.confetti.celebrating Ellipse.flake">
    <Style.Animations>
      <Animation Duration="0:0:0.9" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!-- The library's filter (#44, designs T44Library, T44Modal, T44Bausteine). -->
  <Style Selector="Path.filterFunnel">
    <Setter Property="Data" Value="M3.5 5h17l-6.5 8v6l-4 -2v-4z" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="24" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Stroke" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="Path.filterFunnel.modalFunnel">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <!-- The funnel beside "Ansicht": neutral without a filter; with one the funnel fills and "19 von 412" shows. -->
  <Style Selector="Button.filterChip">
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="8,0,16,0" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="ExtraBold" />
  </Style>
  <Style Selector="Button.filterChip:pointerover">
    <Setter Property="Background" Value="{StaticResource Line}" />
  </Style>
  <!-- An active filter stays a chip like "Ansicht": only the funnel fills and the count shows, in the soft accent. -->
  <Style Selector="Button.filterChip.active">
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
  </Style>
  <Style Selector="Button.filterChip.active Path.filterFunnel">
    <Setter Property="Stroke" Value="{StaticResource AccentSoft}" />
    <Setter Property="Fill" Value="{StaticResource AccentSoft}" />
  </Style>
  <!-- A tab with nothing to filter by: the funnel alone, faint, without a key (#44). -->
  <Style Selector="Button.filterChip:disabled">
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.filterChip:disabled Path.filterFunnel">
    <Setter Property="Stroke" Value="{StaticResource TextFaint}" />
  </Style>

  <!-- The filter hides every entry of the tab: an empty funnel over empty tiles. -->
  <Style Selector="Path.noHitsTile">
    <Setter Property="Fill" Value="{StaticResource Surface}" />
