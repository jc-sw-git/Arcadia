<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Arcadia.App"
             xmlns:vm="using:Arcadia.App.ViewModels"
             xmlns:ctl="using:Arcadia.App.Controls"
             xmlns:views="using:Arcadia.App.Views"
             x:Class="Arcadia.App.Views.GameDetailView"
             x:DataType="vm:GameDetailViewModel"
             ClipToBounds="True">

  <!-- The detail page (#499, design "Detailseite neu: Mischung aus A, B und C"), the whole 1920 × 1080 layout under the
       window's header and footer: the game's artwork as background, its cover in front beside title and buttons, the
       games before and after it in stacks to the sides, and below the panel with the rail of areas and the open area. -->
  <UserControl.Resources>
    <DataTemplate x:Key="DetailButton" x:DataType="vm:GameActionViewModel">
      <Button Classes="plain detailAction" Classes.primary="{Binding IsPrimary}" Classes.focused="{Binding IsFocused}"
              IsEnabled="{Binding IsEnabled}" Command="{Binding InvokeCommand}"
              ToolTip.Tip="{Binding DisabledReason}" ToolTip.ShowOnDisabled="True">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ctl:KeyHint Pad="A" Keys="Leertaste" IsDark="True" IsVisible="{Binding IsPrimary}" />
          <!-- The icons are drawn in a 24 px box; scaled to 20 px like the design. -->
          <Viewbox Width="20" Height="20" IsVisible="{Binding !IsPrimary}" VerticalAlignment="Center">
            <Path Data="{Binding Icon}" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="None" />
          </Viewbox>
          <TextBlock Text="{Binding ButtonLabel}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Canvas Width="1920" Height="1080">
    <!-- The background: the game's artwork (#487), the game's hue with its rings until it is there (#13); the hue blends
         to the next game's. -->
    <Border Name="Backdrop" Width="1920" Height="1080" Background="{Binding Current.Backdrop}">
      <Border.Transitions>
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.48" />
        </Transitions>
      </Border.Transitions>
      <Panel ClipToBounds="True">
        <Ellipse Width="1300" Height="1300" Stroke="{Binding Current.Ring}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-160,0" />
        <Ellipse Width="660" Height="660" Stroke="{Binding Current.Ring}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,20,240,0" />
        <Ellipse Width="220" Height="220" Stroke="{Binding Current.Ring}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,250,500,0" />
        <ctl:ArtworkImage Name="HeroArt" File="{Binding Current.Tile.Hero}" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
      </Panel>
    </Border>
    <!-- Scrims: the text on the left, the header's tabs and the footer's hints stay readable over any image. -->
    <Border Width="1920" Height="1080" Background="{StaticResource DetailScrimSide}" IsHitTestVisible="False" />
    <Border Width="1920" Height="150" Background="{StaticResource DetailScrimTop}" IsHitTestVisible="False" />
    <Border Canvas.Top="820" Width="1920" Height="260" Background="{StaticResource DetailScrimBottom}" IsHitTestVisible="False" />

    <!-- The covers: the shown game's in front, the others in the stacks; ctl:DepthSlot moves them when the carousel turns. -->
    <ItemsControl Name="CoverList" ItemsSource="{Binding Covers}" Width="1920" Height="1080" IsHitTestVisible="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <Panel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.Styles>
        <Style Selector="ItemsControl#CoverList > ContentPresenter" x:DataType="vm:DetailCoverViewModel">
          <Setter Property="ZIndex" Value="{Binding Layer}" />
        </Style>
      </ItemsControl.Styles>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DetailCoverViewModel">
          <ctl:DepthSlot Slot="{Binding Offset}" StackDepth="{Binding $parent[UserControl].((vm:GameDetailViewModel)DataContext)?.StackDepth, TargetNullValue=0}"
                         HorizontalAlignment="Left" VerticalAlignment="Top">
            <Border Width="180" Height="270" CornerRadius="12" Background="{Binding Tile.CoverBrush}" BoxShadow="{StaticResource CoverShadow}" ClipToBounds="True">
              <Panel>
                <ctl:ArtworkImage Name="DetailCoverArt" File="{Binding Tile.Cover}" CornerRadius="12" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
                <Border Classes="shade" CornerRadius="12" IsVisible="{Binding !Tile.IsInstalled}" />
                <Grid RowDefinitions="*,Auto" Margin="18" IsVisible="{Binding !#DetailCoverArt.IsShowing}">
                  <TextBlock Text="{Binding Tile.Monogram}" FontSize="88" FontWeight="ExtraBold" Foreground="{Binding Tile.AccentBrush}" />
                  <TextBlock Grid.Row="1" Text="{Binding Tile.Title}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                             TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                </Grid>
              </Panel>
            </Border>
          </ctl:DepthSlot>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- The stacks: a click turns the carousel to the game before or after. Over the covers, which let clicks through. -->
    <Button Classes="plain detailStack" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Canvas.Top="380" Width="240" Height="408" IsVisible="{Binding HasNeighbours}"
            Command="{Binding PreviousCommand}" ToolTip.Tip="{x:Static app:AppTexts.PreviousGameTip}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <TextBlock Classes="onArt" Text="{Binding Previous?.Title, TargetNullValue=''}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                     MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
          <TextBlock Classes="label onArt" Text="{x:Static app:AppTexts.DetailBefore}" FontSize="13" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" />
          <!-- An arrow pointing the way the carousel turns, with its button inside (#530): under the stack, not above it. -->
          <Panel Classes="turnArrow" Margin="0,12,0,0" HorizontalAlignment="Center">
            <Path Classes="turnArrow" Data="M24,0 H130 Q140,0 140,10 V42 Q140,52 130,52 H24 L0,26 Z" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0,0,0">
              <Path Classes="turnChevron" Data="M8,0 L0,7 L8,14" />
              <ctl:KeyHint Pad="LT" Keys="Q" />
            </StackPanel>
          </Panel>
        </StackPanel>
        <Panel />
      </DockPanel>
    </Button>
    <Button Classes="plain detailStack" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Canvas.Left="1680" Canvas.Top="380" Width="240" Height="408" IsVisible="{Binding HasNeighbours}"
            Command="{Binding NextCommand}" ToolTip.Tip="{x:Static app:AppTexts.NextGameTip}">
      <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Bottom">
          <TextBlock Classes="onArt" Text="{Binding Next?.Title, TargetNullValue=''}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                     MaxWidth="220" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
          <TextBlock Classes="label onArt" Text="{x:Static app:AppTexts.DetailAfter}" FontSize="13" Foreground="{StaticResource TextSoft}" HorizontalAlignment="Center" />
          <!-- An arrow pointing the way the carousel turns, with its button inside (#530): under the stack, not above it. -->
          <Panel Classes="turnArrow" Margin="0,12,0,0" HorizontalAlignment="Center">
            <Path Classes="turnArrow" Data="M24,0 H130 Q140,0 140,10 V42 Q140,52 130,52 H24 L0,26 Z" RenderTransform="scaleX(-1)" />
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,14,0">
              <ctl:KeyHint Pad="RT" Keys="E" />
              <Path Classes="turnChevron" Data="M0,0 L8,7 L0,14" />
            </StackPanel>
          </Panel>
        </StackPanel>
        <Panel />
      </DockPanel>
    </Button>

    <!-- Title, button row and the quiet note under it, on the artwork right of the front cover. The heading reaches down to the
         panel (Canvas.Top 116 + 308 = the panel's 424), so the note can sit in the middle of the space below the buttons. -->
    <DockPanel Name="Heading" Canvas.Left="496" Canvas.Top="116" Width="1164" Height="308" DataContext="{Binding Current}" x:DataType="vm:GameDetailPageViewModel">
      <!-- Drawn above the note's cloud (ZIndex), which reaches up under the buttons, so the cloud never dims a button or its ring. -->
      <StackPanel Name="HeadingTop" DockPanel.Dock="Top" ZIndex="1">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <Border Classes="detailChip">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:LauncherLogo Badge="{Binding Tile.LauncherBadge}" Width="18" Height="18" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LauncherUpper}" FontSize="14" FontWeight="Bold" LetterSpacing="1.7" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <!-- What the entry is, when it is no game (#141). -->
          <Border Classes="detailChip" IsVisible="{Binding Tile.HasTypeIcon}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <ctl:LineIcon Icon="{Binding Tile.TypeIconKey}" Width="18" Height="18" StrokeThickness="2.2" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Tile.TypeNameUpper}" FontSize="14" FontWeight="Bold" LetterSpacing="1.7" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="detailChip running" IsVisible="{Binding Tile.IsRunning}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M7 4.5v15l13-7.5z" Fill="{StaticResource OnRunning}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RunStateUpper}" FontSize="14" FontWeight="ExtraBold" LetterSpacing="0.8" Foreground="{StaticResource OnRunning}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Classes="detailChip" IsVisible="{Binding Tile.IsStarting}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Data="M7 4.5v15l13-7.5z" Stroke="{StaticResource TextSoft}" StrokeThickness="2.4" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding RunStateUpper}" FontSize="14" FontWeight="ExtraBold" LetterSpacing="0.8" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- A long title shrinks to half its size before it wraps (#531), so the button row stays in place. -->
        <ctl:ShrinkingTitle Name="Title" Classes="onArt" Margin="0,10,0,0" Text="{Binding Tile.Title}" LargestSize="66" SmallestSize="33" FontWeight="ExtraBold"
                            TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextStrong}" />
        <!-- "Original-Titel: …" (#496): R3 shows it under an own title in place of the info line, one line cut with "…", so
             a two-line title doesn't push the button row down. -->
        <TextBlock Name="OriginalTitle" Classes="detailOriginalTitle onArt" Text="{Binding OriginalTitleLine}" IsVisible="{Binding ShowsOriginalTitle}" />
        <!-- The info line (#493): genres · developer · year in one line, cut with "…", and the first age rating. -->
        <StackPanel Name="InfoLine" Classes="onArt" Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="GameInfo.HasInfoLine" />
              <Binding Path="!ShowsOriginalTitle" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <TextBlock Text="{Binding GameInfo.InfoLine, TargetNullValue=''}" IsVisible="{Binding GameInfo.HasInfoText}" FontSize="21" Foreground="{StaticResource Text}"
                     MaxWidth="1040" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          <ctl:AgeRatingBadge Classes="ageBadge" Tone="{Binding GameInfo.BadgeTone}" IsVisible="{Binding GameInfo.HasBadge}">
            <TextBlock Text="{Binding GameInfo.Badge, TargetNullValue=''}" />
          </ctl:AgeRatingBadge>
        </StackPanel>
        <!-- 7 px around the buttons leave room for their focus ring (FocusRingGap). -->
        <ItemsControl Name="ButtonRow" Margin="0,20,0,0" HorizontalAlignment="Left" ItemsSource="{Binding Buttons}" ItemTemplate="{StaticResource DetailButton}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
      <!-- The quiet note under "Spielen" (#541): an icon and text, no surface or border; the focus never lands on it. It sits
           in the middle between the buttons and the panel (#546). A soft dark cloud behind it, wider than the text by the
           same amount on each side and fading out at every edge, keeps it readable on a bright image. -->
      <Panel Name="NoteArea" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" IsVisible="{Binding HasNotes}">
        <Border Classes="detailNoteScrim" Margin="-72,-26" IsHitTestVisible="False" />
        <StackPanel Name="Note" Classes="onArt" Spacing="4" MaxWidth="900">
          <DockPanel IsVisible="{Binding HasUpdateNote}">
            <Path DockPanel.Dock="Left" Classes="detailNoteIcon" Data="M12 4v12M6 10l6 6 6-6M5 20h14" Margin="0,0,12,0" />
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="{x:Static app:AppTexts.DetailUpdateAvailable}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding UpdateNote}" FontSize="15" Foreground="{StaticResource TextSoft}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DockPanel>
          <DockPanel IsVisible="{Binding HasPlayNote}">
            <Path DockPanel.Dock="Left" Classes="detailNoteIcon" Data="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 11v5.5M12 7.5v.5" Margin="0,0,12,0" />
            <TextBlock Text="{Binding PlayNote}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <DockPanel IsVisible="{Binding HasSoundtrackNote}">
            <Path DockPanel.Dock="Left" Classes="detailNoteIcon" Data="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 11v5.5M12 7.5v.5" Margin="0,0,12,0" />
            <TextBlock Text="{Binding SoundtrackNote}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Panel>
    </DockPanel>

    <!-- The panel: the rail of areas on the left, the open area beside it. -->
    <Border Name="Panel" Canvas.Left="260" Canvas.Top="424" Width="1400" Height="572" Background="{StaticResource DetailSurface}" CornerRadius="20"
            BoxShadow="{StaticResource DetailShadow}" DataContext="{Binding Current}" x:DataType="vm:GameDetailPageViewModel">
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="340" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,0,1,0">
          <ItemsControl Name="Rail" ItemsSource="{Binding Areas}" Margin="14">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailAreaViewModel">
                <Button Classes="plain detailRail" Classes.open="{Binding IsOpen}" Classes.focused="{Binding IsFocused}" Command="{Binding OpenCommand}">
                  <DockPanel>
                    <!-- A's glyph in the ring (#530): a press enters the area, ◀ ▶ don't. -->
                    <ctl:KeyHint DockPanel.Dock="Right" Pad="A" Keys="Leertaste" IsVisible="{Binding ShowsEnterHint}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <Border DockPanel.Dock="Left" Classes="railIcon" Margin="0,0,14,0" VerticalAlignment="Center">
                      <Path Data="{Binding Icon}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="24" Height="24" Stretch="None"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextStrong}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="railValue" Text="{Binding ValueLine}" />
                    </StackPanel>
                  </DockPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <Panel Name="AreaContent" Margin="34,28">
          <!-- "Übersicht" (#500): left the quick selection, up to five rows of the other areas that act as their rows do, and set
               apart "Übersicht anpassen"; right the game's facts, which take no focus. Wider than the artboard's 384, so a
               name and a value like "Standard (Arcadia)" fit side by side. -->
          <Grid Name="Overview" ColumnDefinitions="480,*" ColumnSpacing="34" IsVisible="{Binding OpenArea.IsOverview}">
            <!-- The places of five entries stay reserved (#541), so the note and "Übersicht anpassen" never move: the note right
                 under the fifth place, "Übersicht anpassen" in the middle between that place and the panel's lower edge (the
                 -28 reaches through AreaContent's margin to that edge). 5 × 56 + 4 × 8 = 312. -->
            <Grid RowDefinitions="Auto,312,*">
              <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailQuickSelectionCaption}" FontSize="13" Margin="0,0,0,14" />
              <ItemsControl Name="QuickEntries" Grid.Row="1" VerticalAlignment="Top" ItemsSource="{Binding Overview.Rows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailRowViewModel">
                    <Button Classes="plain quickEntry" Classes.focused="{Binding IsFocused}" Classes.greyed="{Binding IsGreyed}" Classes.danger="{Binding IsDanger}"
                            Command="{Binding ClickCommand}" PointerEntered="OnRowPointerEntered" ToolTip.Tip="{Binding Note}">
                      <DockPanel>
                        <Viewbox DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center">
                          <Path Classes="quickIcon" Data="{Binding QuickIcon}" Width="24" Height="24" Stretch="None" />
                        </Viewbox>
                        <!-- ◀ value ▶: the arrows change it with the mouse, as on the row. -->
                        <!-- In its own, darker chip (#531), as the settings' value pill. -->
                        <Border DockPanel.Dock="Right" Classes="quickChip" Margin="12,0,-12,0" VerticalAlignment="Center" IsVisible="{Binding IsChoice}">
                          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Classes="plain valueArrow quickArrow" Command="{Binding StepBackCommand}">
                              <Path Classes="chevronLeft" />
                            </Button>
                            <TextBlock Classes="quickValue" Text="{Binding ValueText}" />
                            <Button Classes="plain valueArrow quickArrow" Command="{Binding StepOnCommand}">
                              <Path Classes="chevronRight" />
                            </Button>
                          </StackPanel>
                        </Border>
                        <TextBlock DockPanel.Dock="Right" Classes="quickValue" Margin="12,0,0,0" Text="{Binding ValueText}" IsVisible="{Binding HasActionValue}" />
                        <TextBlock Classes="quickTitle" Text="{Binding Title}" />
                      </DockPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Panel Grid.Row="2">
                <!-- Why the focused entry is greyed out: "Übersicht" has no info box. -->
                <DockPanel Name="QuickNote" Margin="4,6,0,0" IsVisible="{Binding HasQuickNote}">
                  <Path DockPanel.Dock="Left" Classes="detailNoteIcon" Data="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 11v5.5M12 7.5v.5" Width="18" Height="18"
                        VerticalAlignment="Top" Margin="0,2,10,0" />
                  <TextBlock Text="{Binding QuickNote}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <Button Name="Customize" Classes="plain quickEntry customize" Classes.focused="{Binding IsCustomizeFocused}" VerticalAlignment="Center" Margin="0,0,0,-28"
                        Command="{Binding CustomizeCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                      <Path Classes="quickIcon" Data="M4 7h9M17 7h3M4 17h3M11 17h9M15 5v4M9 15v4" Width="24" Height="24" Stretch="None" />
                    </Viewbox>
                    <TextBlock Classes="quickTitle" Text="{x:Static app:AppTexts.DetailCustomizeOverview}" />
                  </StackPanel>
                </Button>
              </Panel>
            </Grid>

            <DockPanel Grid.Column="1">
            <!-- The first tags, own ones first (#495), and "+n" (#493), at the foot of the column as in the artboard. -->
            <StackPanel Name="OverviewTags" DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0" ClipToBounds="True" IsVisible="{Binding GameInfo.HasOverviewTags}">
              <ItemsControl ItemsSource="{Binding GameInfo.OverviewTags}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DetailTag">
                    <Border Classes="metadataTag" Classes.own="{Binding IsOwn}">
                      <TextBlock Text="{Binding Name}" MaxWidth="118" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="metadataTag" IsVisible="{Binding GameInfo.HasMoreTags}">
                <TextBlock Text="{Binding GameInfo.MoreTags, TargetNullValue=''}" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="14">
              <!-- The title once more above the description (#531), whole on one line or cut with "…". -->
              <StackPanel Spacing="8">
                <TextBlock Name="OverviewTitle" Text="{Binding Tile.Title}" FontSize="24" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Tile.Title}" />
                <!-- The short description (#493): four lines at most, then "…"; the whole text is in "Infos". -->
                <TextBlock Name="ShortDescription" Text="{Binding GameInfo.ShortDescription, TargetNullValue=''}" IsVisible="{Binding GameInfo.HasShortDescription}"
                           FontSize="20" LineHeight="30" Foreground="{StaticResource Text}" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" />
                <TextBlock Name="NoShortDescription" Classes="detailNoDescription" Text="{Binding GameInfo.MissingDescription, TargetNullValue=''}" IsVisible="{Binding !GameInfo.HasDescription}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border Classes="detailStat">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="{x:Static app:AppTexts.LastPlayedCaption}" FontSize="12" />
                    <TextBlock Classes="statValue" Text="{Binding Tile.LastPlayedText}" />
                    <TextBlock Classes="statSource" Text="{Binding LastPlayedAt}" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="detailStat">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="{x:Static app:AppTexts.PlaytimeCaption}" FontSize="12" />
                    <TextBlock Classes="statValue" Text="{Binding Tile.PlaytimeText}" />
                    <TextBlock Classes="statSource" Text="{Binding PlaytimeSource}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Classes="detailStat">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="{x:Static app:AppTexts.InstalledOnCaption}" FontSize="12" />
                    <TextBlock Classes="statValue" Text="{Binding InstalledAt}" />
                    <TextBlock Classes="statSource" Text="{Binding Tile.LocationText}" ToolTip.Tip="{Binding Tile.LocationText}" />
                  </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Classes="detailStat">
                  <StackPanel Spacing="3">
                    <TextBlock Classes="label" Text="{x:Static app:AppTexts.SizeCaption}" FontSize="12" />
                    <TextBlock Classes="statValue" Text="{Binding Tile.SizeText}" />
                    <TextBlock Classes="statSource" Text="{Binding DriveText}" />
                  </StackPanel>
                </Border>
              </Grid>
              <!-- E.g. another account in Steam than in Arcadia (#83). -->
              <DockPanel IsVisible="{Binding Tile.HasNotice}">
                <Path DockPanel.Dock="Left" Classes="detailNoteIcon" Data="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 11v5.5M12 7.5v.5" Width="18" Height="18"
                      VerticalAlignment="Top" Margin="0,2,10,0" />
                <TextBlock Text="{Binding Tile.Notice}" FontSize="17" Foreground="{StaticResource AccentSoft}" TextWrapping="Wrap" />
              </DockPanel>
            </StackPanel>
            </DockPanel>
          </Grid>

          <!-- "Infos" (#493): the full description on the left, every field with its source on the right; ▲ ▼ and RS scroll
               both together, so every field can be read with the controller alone (A2). -->
          <Panel Name="Infos" IsVisible="{Binding OpenArea.IsInfos}">
            <StackPanel Spacing="12" IsVisible="{Binding GameInfo.IsEmpty}">
              <TextBlock Text="{x:Static app:AppTexts.DetailInfosNone}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}" />
              <TextBlock Text="{x:Static app:AppTexts.DetailInfosNoneText}" FontSize="19" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left" />
            </StackPanel>
            <Panel IsVisible="{Binding !GameInfo.IsEmpty}">
              <ScrollViewer Name="InfosScroller" VerticalScrollBarVisibility="Hidden">
                <Grid ColumnDefinitions="*,500" ColumnSpacing="44">
                  <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailDescriptionCaption}" FontSize="13" VerticalAlignment="Center" />
                      <TextBlock Classes="metadataSource" Text="{Binding GameInfo.DescriptionSource, TargetNullValue=''}" VerticalAlignment="Center" IsVisible="{Binding GameInfo.HasDescription}" />
                    </StackPanel>
                    <TextBlock Name="Description" Text="{Binding GameInfo.Description, TargetNullValue=''}" FontSize="21" LineHeight="32" Foreground="{StaticResource Text}" TextWrapping="Wrap"
                               IsVisible="{Binding GameInfo.HasDescription}" />
                    <!-- Without one, a line says so instead of an empty column (#531). -->
                    <TextBlock Name="NoDescription" Classes="detailNoDescription" Text="{Binding GameInfo.MissingDescription, TargetNullValue=''}" IsVisible="{Binding !GameInfo.HasDescription}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="22">
                    <ItemsControl Name="Facts" ItemsSource="{Binding GameInfo.Facts}" IsVisible="{Binding GameInfo.HasFacts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DetailFact">
                          <Border Classes="metadataFact">
                            <DockPanel>
                              <TextBlock DockPanel.Dock="Left" Classes="label" Text="{Binding Caption}" FontSize="13" Width="170" VerticalAlignment="Center" />
                              <TextBlock DockPanel.Dock="Right" Classes="metadataSource" Text="{Binding Source}" Margin="16,0,0,0" VerticalAlignment="Center" />
                              <Panel>
                                <TextBlock Text="{Binding Value}" IsVisible="{Binding !IsBadge}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                                <ctl:AgeRatingBadge Classes="ageBadge" Tone="{Binding Tone}" HorizontalAlignment="Left" IsVisible="{Binding IsBadge}">
                                  <TextBlock Text="{Binding Value}" />
                                </ctl:AgeRatingBadge>
                              </Panel>
                            </DockPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- The player's own tags (#495), before the providers'. -->
                    <StackPanel Spacing="10" IsVisible="{Binding GameInfo.HasOwnTags}">
                      <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailOwnTagsCaption}" FontSize="13" />
                      <ItemsControl ItemsSource="{Binding GameInfo.OwnTags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Classes="metadataTag own">
                              <TextBlock Text="{Binding}" MaxWidth="460" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding GameInfo.HasTags}">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailTagsCaption}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Classes="metadataSource" Text="{Binding GameInfo.TagsSource, TargetNullValue=''}" VerticalAlignment="Center" />
                      </StackPanel>
                      <ItemsControl ItemsSource="{Binding GameInfo.Tags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Classes="metadataTag">
                              <TextBlock Text="{Binding}" MaxWidth="460" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
              <ctl:EdgeFade FadeColor="{StaticResource ModalSurfaceColor}" Size="48" ScrollTarget="{Binding #InfosScroller}" />
            </Panel>
          </Panel>

          <!-- An area with rows: its name and value line, the rows, and the info box that explains the focused row. -->
          <DockPanel IsVisible="{Binding OpenArea.HasInfoBox}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="14" Margin="0,0,0,20">
              <TextBlock Text="{Binding OpenArea.Name}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Bottom" />
              <TextBlock Text="{Binding OpenArea.ValueLine}" FontSize="18" Foreground="{StaticResource TextSoft}" VerticalAlignment="Bottom" Margin="0,0,0,3"
                         MaxWidth="600" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Border Name="InfoBox" DockPanel.Dock="Right" Classes="detailInfoBox" Margin="24,0,0,0">
              <Panel>
                <!-- RS (Shift+W/S) scrolls it (#506); the view brings it back to the top when the row, its value or the game changes. -->
                <ScrollViewer Name="InfoScroller" VerticalScrollBarVisibility="Hidden" Padding="24,22">
                  <StackPanel Spacing="12">
                    <!-- Why the row is greyed out, at the very top (#506), as the settings' blue note. -->
                    <Border Classes="infoNote info" IsVisible="{Binding InfoRow?.HasNote, TargetNullValue=False}">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Path Classes="statusIcon info" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Classes="noteText" Text="{Binding InfoRow?.Note, TargetNullValue=''}" />
                      </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Path Classes="detailNoteIcon" Data="M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18M12 11v5.5M12 7.5v.5" Width="20" Height="20" />
                      <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailInfoCaption}" FontSize="13" Foreground="{StaticResource AccentSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding InfoRow?.Title, TargetNullValue=''}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextStrong}" TextWrapping="Wrap" />
                    <views:ValueBoxesView Boxes="{Binding InfoRow?.ValueBoxes}" Classes.dimmed="{Binding InfoRow?.IsGreyed, TargetNullValue=False}" IsVisible="{Binding InfoRow?.HasValueBoxes, TargetNullValue=False}" />
                    <TextBlock Text="{Binding InfoRow?.InfoText, TargetNullValue=''}" IsVisible="{Binding InfoRow?.HasInfoText, TargetNullValue=False}"
                               FontSize="17" LineHeight="25" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                    <!-- The game's own tags below the text of "Tags" (#533), as the chips in "Infos". -->
                    <StackPanel Spacing="10" IsVisible="{Binding InfoRow?.HasInfoTags, TargetNullValue=False}">
                      <TextBlock Classes="label" Text="{x:Static app:AppTexts.DetailOwnTagsCaption}" FontSize="13" />
                      <ItemsControl ItemsSource="{Binding InfoRow?.InfoTags}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel ItemSpacing="8" LineSpacing="8" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String">
                            <Border Classes="metadataTag own">
                              <TextBlock Text="{Binding}" />
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <TextBlock Text="{x:Static app:AppTexts.DetailTagsOfGameNone}" IsVisible="{Binding InfoRow?.HasNoInfoTags, TargetNullValue=False}"
                               FontSize="17" LineHeight="25" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                </ScrollViewer>
                <ctl:EdgeFade FadeColor="{StaticResource DetailInfoBoxColor}" Size="48" ScrollTarget="{Binding #InfoScroller}" />
              </Panel>
            </Border>
            <ItemsControl Name="Rows" ItemsSource="{Binding OpenArea.Rows}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailRowViewModel">
                  <Button Classes="plain detailRow" Classes.focused="{Binding IsFocused}" Classes.greyed="{Binding IsGreyed}" Classes.danger="{Binding IsDanger}"
                          Command="{Binding ClickCommand}" PointerEntered="OnRowPointerEntered">
                    <DockPanel>
                      <!-- The value in the settings' chip (#506). -->
                      <Border DockPanel.Dock="Right" Classes="valuePill" VerticalAlignment="Center" Margin="16,0,0,0" IsVisible="{Binding IsChoice}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <Button Classes="plain valueArrow" Command="{Binding StepBackCommand}">
                            <Path Classes="chevronLeft" />
                          </Button>
                          <TextBlock Grid.Column="1" Classes="valueText" Text="{Binding ValueText}" />
                          <Button Grid.Column="2" Classes="plain valueArrow" Command="{Binding StepOnCommand}">
                            <Path Classes="chevronRight" />
                          </Button>
                        </Grid>
                      </Border>
                      <TextBlock DockPanel.Dock="Right" Classes="actionValue" Margin="16,0,0,0" Text="{Binding ValueText}" IsVisible="{Binding HasActionValue}" />
                      <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="rowTitle" Text="{Binding Title}" />
                        <TextBlock Classes="rowSubtitle" Text="{Binding Subtitle}" />
                      </StackPanel>
                    </DockPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </DockPanel>
        </Panel>
      </DockPanel>
    </Border>
  </Canvas>

  <UserControl.Styles>
    <Style Selector="TextBlock.statValue">
      <Setter Property="FontSize" Value="21" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.detailNoDescription">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="LineHeight" Value="30" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.statSource">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
  </UserControl.Styles>
</UserControl>
