<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Arcadia.App.ViewModels"
        xmlns:ctl="using:Arcadia.App.Controls"
        xmlns:views="using:Arcadia.App.Views"
        xmlns:search="using:Arcadia.App.Search"
        xmlns:settings="using:Arcadia.App.Settings"
        x:Class="Arcadia.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Arcadia"
        Icon="/Assets/arcadia.ico"
        Width="1600" Height="900"
        MinWidth="960" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}">

  <!-- The Big Picture layout is designed for 1920×1080 and scaled to the window. -->
  <!-- No clipping: bands reach past the layout into the bars beside it (Theme.axaml, bleed). -->
  <Viewbox Stretch="Uniform" ClipToBounds="False">
    <Grid Width="1920" Height="1080" RowDefinitions="104,72,*,72" Background="{StaticResource Bg}">

      <!-- Header: logo, launcher tabs, status. The tab strip sits in the middle between logo and status, as wide as its
           tabs need; at its widest it keeps 40 px to both sides, with a divider in the middle of each gap (owner, 2026-10-21). -->
      <Grid Grid.Row="0" Margin="80,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <Path Data="M4 30V16a13 13 0 0 1 26 0v14 M11 30v-8h12v8" Stroke="{StaticResource Accent}" StrokeThickness="3"
                StrokeLineCap="Round" StrokeJoin="Round" Width="34" Height="34" />
          <TextBlock Text="ARCADIA" FontSize="24" FontWeight="ExtraBold" LetterSpacing="1.4" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Shown only while the strip is at its widest (MainWindow.axaml.cs, UpdateTabEdges); the gap stays either way. -->
        <Border Name="TabDividerLeft" Grid.Column="1" Classes="divider tabDivider" Margin="20,0" />

        <DockPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsTabStripShown}">
          <Button DockPanel.Dock="Left" Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Margin="0,0,12,0"
                  Command="{Binding PreviousTabCommand}" ToolTip.Tip="Vorheriger Launcher (Umschalt+Q)">
            <ctl:KeyText Pad="LB" Keys="⇧ Q" />
          </Button>
          <Button DockPanel.Dock="Right" Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Margin="12,0,0,0"
                  Command="{Binding NextTabCommand}" ToolTip.Tip="Nächster Launcher (Umschalt+E)">
            <ctl:KeyText Pad="RB" Keys="⇧ E" />
          </Button>
          <Panel>
            <ScrollViewer Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
              <ItemsControl Name="TabList" ItemsSource="{Binding Tabs}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LauncherTabViewModel">
                    <Button Classes="plain tab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <ctl:LauncherLogo Badge="{Binding Badge}" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <Border IsVisible="{Binding IsSelected}" Background="{StaticResource Bg}" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Count}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
                        </Border>
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

            <!-- Fade out where more tabs follow; clicks pass through to a cut-off tab, the wheel turns the strip. -->
            <Border Name="TabEdgeLeft" IsVisible="False" Width="96" HorizontalAlignment="Left" IsHitTestVisible="False" Background="{StaticResource TabEdgeLeft}" />
            <Border Name="TabEdgeRight" IsVisible="False" Width="96" HorizontalAlignment="Right" IsHitTestVisible="False" Background="{StaticResource TabEdgeRight}" />
          </Panel>
        </DockPanel>

        <Border Name="TabDividerRight" Grid.Column="3" Classes="divider tabDivider" Margin="20,0" />

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding Status.IsControllerStarting}" VerticalAlignment="Center"
                      ToolTip.Tip="SISR startet und richtet den Steam Controller als Xbox Controller ein">
            <Path Classes="spinner" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
            <TextBlock Text="Controller wird eingerichtet …" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
          </StackPanel>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasControllerStatus}" Command="{Binding OpenControllerSettingsCommand}" ToolTip.Tip="{Binding Status.ControllerStatusText}">
            <!-- Symbol and colour come from the statusIcon styles, so no local Data or Stroke. -->
            <Path Classes="statusIcon" Classes.info="{Binding Status.IsControllerStatusInfo}" Classes.error="{Binding Status.IsControllerStatusError}" />
          </Button>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasSisrUpdate}" Command="{Binding OpenControllerSettingsCommand}" ToolTip.Tip="Neue SISR-Version verfügbar">
            <Path Data="M20 12a8 8 0 1 1 -2.3 -5.6 M20 4v4.5h-4.5" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="None" />
          </Button>
          <Button Classes="plain glyphButton" Width="44" Height="44" MinWidth="44" CornerRadius="22" Padding="0" Background="Transparent"
                  IsVisible="{Binding Status.HasArcadiaUpdate}" Command="{Binding OpenAboutSettingsCommand}" ToolTip.Tip="{Binding Status.ArcadiaUpdateText}">
            <Panel Width="24" Height="24">
              <Path Data="M20 12a8 8 0 1 1 -2.3 -5.6 M20 4v4.5h-4.5" Stroke="{StaticResource AccentSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="24" Height="24" Stretch="None" />
              <!-- The dot tells Arcadia's own update apart from SISR's. -->
              <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" Stroke="{StaticResource Bg}" StrokeThickness="2"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" />
            </Panel>
          </Button>
          <Border Classes="divider" Margin="6,0" IsVisible="{Binding Status.HasAnyStatus}" />
          <!-- Search and settings as chips: the key that opens them beside their symbol (owner, 2026-10-21). -->
          <Button Classes="plain headerChip" Command="{Binding OpenSearchCommand}" ToolTip.Tip="Suchen (F)" IsVisible="{Binding !IsSearchShown}">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ctl:KeyHint Pad="X" Keys="F" />
              <Path Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M20 20l-4-4" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" />
            </StackPanel>
          </Button>
          <Button Classes="plain headerChip" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Einstellungen (Enter)">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <ctl:KeyHint Pad="≡" Keys="Enter" />
              <Path Data="M4 7h10 M18 7h2 M4 17h4 M12 17h8 M14 7a2 2 0 1 0 4 0a2 2 0 1 0 -4 0 M8 17a2 2 0 1 0 4 0a2 2 0 1 0 -4 0"
                    Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" Width="24" Height="24" Stretch="None" />
            </StackPanel>
          </Button>
          <Border Classes="divider" Margin="6,0" />
          <TextBlock Text="{Binding Status.Date}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status.Clock}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>

      <!-- Toolbar: current tab and view options -->
      <Grid Grid.Row="1" Margin="80,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsLibraryShown}">
        <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
          <TextBlock Text="{Binding SelectedTab?.Name, TargetNullValue=''}" FontSize="34" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock Text="{Binding CountText}" FontSize="18" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,8,0,0" />
        </StackPanel>
        <Button Grid.Column="1" Classes="plain toolbar" Command="{Binding OpenViewOptionsCommand}" IsVisible="{Binding AreGamesShown}">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ctl:KeyHint Pad="Y" Keys="V" />
            <TextBlock Text="{Binding ViewSummary}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>

      <!-- Detail page: path back, position in the list and the sort order -->
      <Grid Grid.Row="1" Margin="80,0" ColumnDefinitions="*,Auto" IsVisible="{Binding IsDetailOpen}">
        <Button Classes="plain" HorizontalAlignment="Left" Command="{Binding CloseDetailCommand}" ToolTip.Tip="Zurück (Esc)">
          <StackPanel Orientation="Horizontal" Spacing="14">
            <ctl:KeyHint Pad="B" Keys="Esc" />
            <TextBlock Classes="crumb" Text="Bibliothek" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}" />
            <TextBlock Classes="crumb separator" Text="/" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}" />
            <TextBlock Classes="crumb" Text="{Binding Detail?.TabName, TargetNullValue=''}" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}" />
            <TextBlock Classes="crumb" Text="Suche" IsVisible="{Binding Detail?.IsFromSearch, TargetNullValue=False}" />
            <TextBlock Classes="crumb separator" Text="/" />
            <TextBlock Classes="crumb current" Text="{Binding Detail?.Current.Tile.Title, TargetNullValue=''}" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20">
          <TextBlock Text="{Binding Detail?.PositionText, TargetNullValue=''}" FontSize="17" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
          <Button Classes="plain toolbar" Command="{Binding OpenViewOptionsCommand}" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ctl:KeyHint Pad="Y" Keys="V" />
              <TextBlock Text="{Binding Detail?.SortLabel, TargetNullValue=''}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Panel Grid.Row="2" IsVisible="{Binding IsDetailOpen}">
        <views:GameDetailView DataContext="{Binding Detail}" />
      </Panel>

      <!-- Body: preview panel and cover grid -->
      <Grid Grid.Row="2" ColumnDefinitions="400,*" Margin="80,0,0,0" ColumnSpacing="40" IsVisible="{Binding IsLibraryShown}">

        <Border Classes="preview" Classes.holding="{Binding FocusedGame?.IsHolding, TargetNullValue=False}" Background="{StaticResource Surface}" CornerRadius="16" ClipToBounds="True" Margin="0,18,0,16"
                IsVisible="{Binding FocusedGame, Converter={x:Static ObjectConverters.IsNotNull}}">
          <Panel>
            <Grid RowDefinitions="180,*" DataContext="{Binding FocusedGame}" x:DataType="vm:GameTileViewModel">
              <Panel Background="{Binding CoverBrush}">
                <TextBlock Text="{Binding Monogram}" FontSize="140" FontWeight="ExtraBold" Foreground="{Binding AccentBrush}" Opacity="0.55"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,20,0" />
                <Border Classes="shade" CornerRadius="0" IsVisible="{Binding !IsInstalled}" />
                <Border Classes="installBadge" IsVisible="{Binding ShowInstallBadge}" CornerRadius="16" Height="32" Padding="10,0,14,0"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Data="M7 17a4 4 0 0 1-.6-7.95A6 6 0 0 1 17.8 8.5 4 4 0 0 1 17 16.9M12 11v9M9 17l3 3 3-3" Stroke="{StaticResource TextSoft}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="Nicht installiert" FontSize="14" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Panel>
              <DockPanel Grid.Row="1" Margin="24,22,24,24">
                <StackPanel DockPanel.Dock="Bottom" Spacing="10">
                  <!-- One below the other, so a long label ("Zurück ins Spiel" beside the Space key) has the full width. -->
                  <Button Classes="plain primary" HorizontalAlignment="Stretch" Command="{Binding ActivateCommand}" IsEnabled="{Binding CanActivate}">
                    <Viewbox StretchDirection="DownOnly">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <ctl:KeyHint Pad="A" Keys="Leertaste" IsDark="True" />
                        <TextBlock Text="{Binding PrimaryActionText}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Viewbox>
                  </Button>
                  <Button Name="PreviewOptionsButton" Classes="plain secondary" HorizontalAlignment="Stretch" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.OpenMenuCommand}"
                          ToolTip.Tip="Weitere Aktionen (R oder Rechtsklick auf ein Cover)">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <ctl:KeyHint Pad="⧉" Keys="R" />
                      <TextBlock Text="Optionen" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <TextBlock IsVisible="{Binding UpdateAvailable}" Classes="actionHint">
                    <Run Text="{Binding LauncherName}" /><Run Text=" installiert das Update ggf. vor dem Start" />
                  </TextBlock>
                  <TextBlock IsVisible="{Binding ShowInstallBadge}" Classes="actionHint">
                    <Run Text="Die Installation wird in " /><Run Text="{Binding LauncherName}" /><Run Text=" geöffnet" />
                  </TextBlock>
                  <TextBlock IsVisible="{Binding ShowLauncherControlsHint}" Classes="actionHint">
                    <Run Text="Pausieren und Abbrechen in " /><Run Text="{Binding LauncherName}" />
                  </TextBlock>
                </StackPanel>
                <StackPanel Spacing="20">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="ExtraBold" TextWrapping="Wrap" />
                    <!-- A status, not a control: plain text, no pill that could pass for a button. -->
                    <StackPanel IsVisible="{Binding UpdateAvailable}" Orientation="Horizontal" Spacing="8">
                      <Path Data="M21 12a9 9 0 0 0-15-6.7L3 8M3 3v5h5M3 12a9 9 0 0 0 15 6.7l3-2.7M21 21v-5h-5" Stroke="{StaticResource Accent}" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="Update verfügbar" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsRunning}" Orientation="Horizontal" Spacing="8">
                      <Path Data="M7 4.5v15l13-7.5z" Fill="{StaticResource Running}" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding RunStateText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Running}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel IsVisible="{Binding IsStarting}" Orientation="Horizontal" Spacing="8">
                      <Path Data="M7 4.5v15l13-7.5z" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeJoin="Round" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding RunStateText}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="10" IsVisible="{Binding IsInstallActive}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                      <Path Classes="spinner" IsVisible="{Binding IsInstallSpinning}" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <Path IsVisible="{Binding IsInstallQueued}" Data="M6 3h12M6 21h12M8 3v3.5l4 5.5-4 5.5v3.5M16 3v3.5l-4 5.5 4 5.5v3.5" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <Path IsVisible="{Binding IsInstallPaused}" Data="M9 6v12M15 6v12" Stroke="{StaticResource Warning}" StrokeThickness="2.8" StrokeLineCap="Round" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding InstallStatusText}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Classes="install large" Classes.paused="{Binding IsInstallPaused}" Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}" />
                  </StackPanel>
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="18" ColumnSpacing="16">
                    <StackPanel Spacing="3">
                      <TextBlock Classes="label" Text="ZULETZT GESPIELT" />
                      <TextBlock Classes="value" Text="{Binding LastPlayedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="3">
                      <TextBlock Classes="label" Text="SPIELZEIT" />
                      <TextBlock Classes="value" Text="{Binding PlaytimeText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Spacing="3">
                      <TextBlock Classes="label" Text="INSTALLATIONSGRÖSSE" />
                      <TextBlock Classes="value" Text="{Binding SizeText}" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                      <TextBlock Classes="label" Text="LAUNCHER" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <ctl:LauncherLogo Badge="{Binding LauncherBadge}" Width="20" Height="20" VerticalAlignment="Center" />
                        <TextBlock Classes="value" Text="{Binding LauncherName}" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Spacing="3">
                      <TextBlock Classes="label" Text="SPEICHERORT" />
                      <TextBlock Text="{Binding LocationText}" FontSize="15" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Grid>
                  <StackPanel Spacing="6" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ShowControllerSupport, TargetNullValue=False}">
                    <TextBlock Classes="label" Text="STEAM CONTROLLER" />
                    <!-- A plain value, not a dropdown: the mouse click switches it; the controller gets it with #10. -->
                    <Button Classes="plain modeValue" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.CycleControllerSupportCommand}"
                            IsEnabled="{Binding !IsRunningOrStarting}" ToolTip.ShowOnDisabled="True"
                            ToolTip.Tip="{Binding NextStartOnlyReason, TargetNullValue='Klicken wechselt zwischen „Xbox Controller (SISR)“ und „Steam Input“'}">
                      <TextBlock Classes="value" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.FocusedControllerSupportText}" />
                    </Button>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ShowGameMouseMode, TargetNullValue=False}">
                    <TextBlock Classes="label" Text="INDIVIDUELLER MAUSMODUS" />
                    <Button Classes="plain modeValue" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.CycleGameMouseModeCommand}"
                            ToolTip.Tip="Klicken wechselt zwischen „Standard“, „Erlaubt“ und „Deaktiviert“">
                      <TextBlock Classes="value" Text="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.FocusedGameMouseModeText}" />
                    </Button>
                  </StackPanel>
                </StackPanel>
              </DockPanel>
            </Grid>
            <!-- Fills while A is held; full opens the detail page. -->
            <ctl:HoldRing />
          </Panel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="*,64" IsVisible="{Binding !IsEmptyTabShown}">
          <ScrollViewer Name="GridScroller" VerticalScrollBarVisibility="Auto" Padding="6,8,70,8">
            <ItemsControl Name="GameGrid" ItemsSource="{Binding PageGames}" VerticalAlignment="Top">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="8" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameTileViewModel">
                  <Button Classes="plain tile" Classes.focused="{Binding IsFocused}" Command="{Binding FocusCommand}"
                          Background="{Binding CoverBrush}" Height="215" ToolTip.Tip="{Binding Title}">
                    <Panel>
                      <Border Classes="shade" IsVisible="{Binding !IsInstalled}" />
                      <Grid RowDefinitions="*,Auto" Margin="12">
                        <TextBlock Text="{Binding Monogram}" FontSize="56" FontWeight="ExtraBold" Foreground="{Binding AccentBrush}" Classes.dim="{Binding !IsInstalled}" />
                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                                   TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <Border Classes="installBadge" IsVisible="{Binding ShowInstallBadge}" Width="30" Height="30" CornerRadius="15"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Nicht installiert – A installiert">
                        <Path Data="M7 17a4 4 0 0 1-.6-7.95A6 6 0 0 1 17.8 8.5 4 4 0 0 1 17 16.9M12 11v9M9 17l3 3 3-3" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                      </Border>
                      <Border Classes="installBadge" IsVisible="{Binding UpdateAvailable}" Width="30" Height="30" CornerRadius="15"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Update verfügbar">
                        <Path Data="M21 12a9 9 0 0 0-15-6.7L3 8M3 3v5h5M3 12a9 9 0 0 0 15 6.7l3-2.7M21 21v-5h-5" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                      </Border>
                      <!-- A running game (#95), like the update symbol; while it starts, without animation, since Arcadia is then behind the game. -->
                      <Border Classes="installBadge" IsVisible="{Binding IsRunning}" Height="30" CornerRadius="15" Padding="9,0,11,0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding RunStateText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="M7 4.5v15l13-7.5z" Fill="{StaticResource Running}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding RunStateShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource Running}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border Classes="installBadge" IsVisible="{Binding IsStarting}" Height="30" CornerRadius="15" Padding="9,0,11,0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding RunStateText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Data="M7 4.5v15l13-7.5z" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeJoin="Round" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding RunStateShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <Border Classes="installBadge" IsVisible="{Binding IsInstallActive}" Height="30" CornerRadius="15" Padding="8,0,11,0"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding InstallStatusText}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Path Classes="spinner" IsVisible="{Binding IsInstallSpinning}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                          <Path IsVisible="{Binding IsInstallQueued}" Data="M6 3h12M6 21h12M8 3v3.5l4 5.5-4 5.5v3.5M16 3v3.5l-4 5.5 4 5.5v3.5" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                          <Path IsVisible="{Binding IsInstallPaused}" Data="M9 6v12M15 6v12" Stroke="{StaticResource Warning}" StrokeThickness="2.8" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding InstallShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                      <ProgressBar Classes="install" Classes.paused="{Binding IsInstallPaused}" IsVisible="{Binding IsInstallActive}"
                                   Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}"
                                   VerticalAlignment="Bottom" Margin="0" />
                    </Panel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <!-- Covers cut off at an edge fade out there, but only where the grid can still scroll
               that way (#102). Shown from MainWindow.axaml.cs; the scroll bar stays uncovered. They reach
               2 px past the grid: at a scaled window size the grid's clip and the fade's edge round to
               different pixels, which left a line of unfaded covers. -->
          <Border Name="GridFadeTop" Classes="listFade" VerticalAlignment="Top" Margin="0,-2,64,0" Background="{StaticResource ListFadeTop}" />
          <Border Name="GridFadeBottom" Classes="listFade" VerticalAlignment="Bottom" Margin="0,0,64,-2" Background="{StaticResource ListFadeBottom}" />

          <Panel Grid.Row="1" Margin="0,0,80,0">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Button Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Vorherige Seite (Q, Bild ↑ oder Umschalt+←)">
                <ctl:KeyText Pad="LT" Keys="Q" />
              </Button>
              <ItemsControl ItemsSource="{Binding PageButtons}" Margin="10,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:PageButtonViewModel">
                    <Panel>
                      <TextBlock IsVisible="{Binding IsEllipsis}" Text="…" Width="28" TextAlignment="Center" FontWeight="Bold"
                                 Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                      <Button IsVisible="{Binding IsPage}" Classes="plain page" Classes.current="{Binding IsCurrent}"
                              Content="{Binding Label}" Command="{Binding GoCommand}" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Command="{Binding NextPageCommand}" ToolTip.Tip="Nächste Seite (E, Bild ↓ oder Umschalt+→)">
                <ctl:KeyText Pad="RT" Keys="E" />
              </Button>
            </StackPanel>
            <TextBlock Text="{Binding RangeText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource TextMuted}" />
          </Panel>
        </Grid>

        <!-- Loading / empty states -->
        <TextBlock Grid.ColumnSpan="2" IsVisible="{Binding IsLoading}" Text="Bibliothek wird geladen …" FontSize="22"
                   Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        <!-- An active launcher without games, or no longer found, or no launcher active at all (#136): the library says so,
             with the way to the launcher settings. -->
        <Panel Grid.ColumnSpan="2" IsVisible="{Binding IsEmptyTabShown}" Margin="0,0,80,0">
          <Ellipse Width="900" Height="560" Fill="{StaticResource EmptyStateGlow}" IsHitTestVisible="False" />
          <StackPanel DataContext="{Binding EmptyTab}" x:DataType="vm:EmptyTabViewModel" Spacing="22" MaxWidth="760" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ContentControl Classes="tabEmpty" Content="{Binding}" HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="{Binding Text}" FontSize="19" LineHeight="28" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center" Margin="0,12,0,0">
              <Button Classes="plain action primaryAction" Classes.focused="{Binding IsSettingsFocused}" Command="{Binding OpenSettingsCommand}" Content="Launcher-Einstellungen" />
              <Button Classes="plain action" Classes.focused="{Binding IsRescanFocused}" Command="{Binding RescanCommand}" Content="{Binding RescanText}" />
            </StackPanel>
          </StackPanel>
        </Panel>
      </Grid>

      <!-- Footer: button hints -->
      <!-- The line bleeds into the bars beside the layout (Theme.axaml, bleed): 1920 + 80 padding. -->
      <Border Grid.Row="3" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Margin="-1920,0" Padding="2000,0">
        <Panel>
        <!-- The hints name the input in use: the controller's buttons, or the keyboard's keys and the mouse (#127). Search
             and settings aren't listed: their chips in the header name their keys (owner, 2026-10-21). -->
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsDetailOpen}">
          <ctl:KeyHint Pad="D-Pad" Keys="WASD" Text="Aktion wählen" />
          <ctl:KeyHint Pad="A" Keys="Leertaste" Alt="Klick" Text="Auswählen" />
          <ctl:KeyHint Pad="Y" Keys="V" Text="Ansicht" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}" />
          <ctl:KeyHint Pad="LB|RB" Keys="⇧ Q|⇧ E" Alt="1 … 0" Text="Launcher" IsVisible="{Binding Detail?.IsFromLibrary, TargetNullValue=False}" />
          <ctl:KeyHint Pad="LT|RT" Keys="Q|E" Alt="Mausrad" Text="Spiel" />
          <ctl:KeyHint Pad="B" Keys="Esc" Text="Zurück" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding IsEmptyTabShown}">
          <ctl:KeyHint Pad="◀▶" Keys="A|D" Text="Wechseln" />
          <ctl:KeyHint Pad="A" Keys="Leertaste" Alt="Klick" Text="Auswählen" />
          <ctl:KeyHint Pad="LB|RB" Keys="⇧ Q|⇧ E" Alt="1 … 0" Text="Launcher" IsVisible="{Binding EmptyTab?.HasTab, TargetNullValue=False}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding AreGamesShown}">
          <ctl:KeyHint Pad="A" Keys="Leertaste" Alt="Doppelklick" Text="{Binding FocusedGame?.PrimaryActionText, TargetNullValue='Spielen'}" />
          <ctl:KeyHint Pad="A" Keys="Leertaste" Alt="Klick" Text="halten: Details" />
          <ctl:KeyHint Pad="⧉" Keys="R" Alt="Rechtsklick" Text="Optionen" />
          <ctl:KeyHint Pad="Y" Keys="V" Text="Ansicht" />
          <ctl:KeyHint Pad="LB|RB" Keys="⇧ Q|⇧ E" Alt="1 … 0" Text="Launcher" />
          <ctl:KeyHint Pad="LT|RT" Keys="Q|E" Text="Seite" />
        </StackPanel>
        </Panel>
      </Border>

      <!-- Search (#12): covers the library; a detail page opened from it takes its place. -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsSearchShown}">
        <!-- Covers the library in the bars beside the layout too. -->
        <Border Classes="bleedAll" Background="{StaticResource Bg}" />
        <Panel.Resources>
          <!-- A hit; also the faded neighbours beside the window of hits. -->
          <DataTemplate x:Key="SearchHitTile" x:DataType="vm:GameTileViewModel">
            <!-- Fixed size: the window slides by whole tiles (MainWindow.axaml.cs, HitPitch). -->
            <StackPanel Width="190" Height="270" Spacing="10">
              <Button Classes="plain resultTile" Classes.focused="{Binding IsFocused}" Classes.holding="{Binding IsHolding}" Command="{Binding FocusCommand}"
                      Background="{Binding CoverBrush}" Height="240" ToolTip.Tip="{Binding Title}">
                <Panel>
                  <Border Classes="shade" IsVisible="{Binding !IsInstalled}" />
                  <DockPanel Margin="12">
                    <Border DockPanel.Dock="Top" Classes="launcherBadge" Width="28" Height="28" CornerRadius="7" HorizontalAlignment="Left">
                      <ctl:LauncherLogo Classes="onCover" Badge="{Binding LauncherBadge}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Bottom"
                               TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                  </DockPanel>
                  <Border Classes="installBadge" IsVisible="{Binding ShowInstallBadge}" Width="30" Height="30" CornerRadius="15"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Nicht installiert – ≡ installiert">
                    <Path Data="M7 17a4 4 0 0 1-.6-7.95A6 6 0 0 1 17.8 8.5 4 4 0 0 1 17 16.9M12 11v9M9 17l3 3 3-3" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="16" Height="16" Stretch="Uniform" />
                  </Border>
                  <Border Classes="installBadge" IsVisible="{Binding UpdateAvailable}" Width="30" Height="30" CornerRadius="15"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="Update verfügbar">
                    <Path Data="M21 12a9 9 0 0 0-15-6.7L3 8M3 3v5h5M3 12a9 9 0 0 0 15 6.7l3-2.7M21 21v-5h-5" Stroke="{StaticResource Accent}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="15" Height="15" Stretch="Uniform" />
                  </Border>
                  <!-- A running game (#95), like the update symbol; while it starts, without animation, since Arcadia is then behind the game. -->
                  <Border Classes="installBadge" IsVisible="{Binding IsRunning}" Height="30" CornerRadius="15" Padding="9,0,11,0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding RunStateText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Data="M7 4.5v15l13-7.5z" Fill="{StaticResource Running}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding RunStateShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource Running}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="installBadge" IsVisible="{Binding IsStarting}" Height="30" CornerRadius="15" Padding="9,0,11,0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding RunStateText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Data="M7 4.5v15l13-7.5z" Stroke="{StaticResource TextSoft}" StrokeThickness="2.2" StrokeJoin="Round" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding RunStateShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <Border Classes="installBadge" IsVisible="{Binding IsInstallActive}" Height="30" CornerRadius="15" Padding="8,0,11,0"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" ToolTip.Tip="{Binding InstallStatusText}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Path Classes="spinner" IsVisible="{Binding IsInstallSpinning}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <Path IsVisible="{Binding IsInstallQueued}" Data="M6 3h12M6 21h12M8 3v3.5l4 5.5-4 5.5v3.5M16 3v3.5l-4 5.5 4 5.5v3.5" Stroke="{StaticResource TextSoft}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                      <Path IsVisible="{Binding IsInstallPaused}" Data="M9 6v12M15 6v12" Stroke="{StaticResource Warning}" StrokeThickness="2.8" StrokeLineCap="Round" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding InstallShortText}" FontSize="13" FontWeight="ExtraBold" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>
                  <ProgressBar Classes="install" Classes.paused="{Binding IsInstallPaused}" IsVisible="{Binding IsInstallActive}"
                               Value="{Binding InstallPercent}" IsIndeterminate="{Binding IsInstallIndeterminate}" VerticalAlignment="Bottom" />
                  <!-- Fills while ≡ (or Enter) is held; full opens the detail page. -->
                  <ctl:HoldRing />
                </Panel>
              </Button>
              <!-- Above the focused cover's drop shadow. -->
              <TextBlock Text="{Binding LauncherName}" FontSize="14" Foreground="{StaticResource TextMuted}" ZIndex="3" />
            </StackPanel>
          </DataTemplate>
        </Panel.Resources>
        <DockPanel DataContext="{Binding Search}" x:DataType="search:SearchViewModel">

          <Grid DockPanel.Dock="Top" Height="96" Margin="80,0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <Path Data="M4 30V16a13 13 0 0 1 26 0v14 M11 30v-8h12v8" Stroke="{StaticResource Accent}" StrokeThickness="3"
                    StrokeLineCap="Round" StrokeJoin="Round" Width="34" Height="34" />
              <TextBlock Text="ARCADIA" FontSize="24" FontWeight="ExtraBold" LetterSpacing="1.4" VerticalAlignment="Center" />
              <TextBlock Text="Suche" FontSize="24" Foreground="{StaticResource TextFaint}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Button Grid.Column="1" Classes="plain" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.CloseSearchCommand}" ToolTip.Tip="Suche schließen (Esc)">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <!-- B closes the search only with the keyboard in; with it out, B puts the keyboard away first. -->
                <ctl:KeyHint Pad="B" Keys="Esc" IsVisible="{Binding !IsKeyboardOut}" />
                <TextBlock Text="Schließen" FontSize="16" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Field and scope. The /launcher prefix still works when typed, but the field doesn't advertise it (owner, 2026-10-18). -->
          <StackPanel DockPanel.Dock="Top" Margin="80,0" Spacing="12">
            <Border Height="76" CornerRadius="38" Background="{StaticResource Surface}" BoxShadow="{StaticResource SearchFieldRing}" Padding="28,0">
              <DockPanel>
                <Path DockPanel.Dock="Left" Data="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0 M20 20l-4-4" Stroke="{StaticResource TextMuted}" StrokeThickness="2"
                      StrokeLineCap="Round" Width="28" Height="28" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Panel VerticalAlignment="Center">
                  <TextBlock Text="Spiele suchen …" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextFaint}"
                             IsVisible="{Binding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" Margin="6,0,0,0" />
                  <!-- The caret stands where typing goes; the on-screen keyboard's arrows move it (#110). -->
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <TextBlock Text="{Binding TextBeforeCaret}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                    <Border Classes="caret" Width="3" Height="34" CornerRadius="1.5" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding TextAfterCaret}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextStrong}" VerticalAlignment="Center" />
                  </StackPanel>
                </Panel>
              </DockPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="28,0,0,0" MinHeight="24">
              <TextBlock Text="{Binding ScopeText}" FontSize="16" Foreground="{StaticResource TextMuted}" />
              <TextBlock IsVisible="{Binding HasUnknownKeywords}" Text="{Binding UnknownKeywordsText, StringFormat='· {0}'}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
            </StackPanel>
          </StackPanel>

          <!-- Launcher chips (for the mouse; the controller filters with L3) and the sort order in one row. With many
               launchers the chips get narrower: first the keyword goes, then the name shrinks, last only the icon is left. -->
          <Grid DockPanel.Dock="Top" Name="SearchChipRow" Margin="80,16,80,4" ColumnDefinitions="*,Auto,Auto">
            <ItemsControl Name="SearchChips" ItemsSource="{Binding Chips}" HorizontalAlignment="Left" Margin="4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <ctl:SharedWidthRow Spacing="10" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="search:SearchChipViewModel">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" IsVisible="{Binding !IsLauncher}" Classes="divider" Margin="16,0,6,0" />
                    <Button Classes="plain chip" Classes.all="{Binding !IsLauncher}" Classes.on="{Binding IsOn}" Command="{Binding ToggleCommand}" ToolTip.Tip="{Binding Name}">
                      <ctl:CollapsingStack Spacing="10" EndPadding="8">
                        <ctl:LauncherLogo Classes="chipLogo" IsVisible="{Binding IsLauncher}" Badge="{Binding Badge}" Width="24" Height="24" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" ctl:CollapsingStack.MinShrinkWidth="44" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock IsVisible="{Binding IsLauncher}" Text="{Binding Keyword}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" />
                      </ctl:CollapsingStack>
                    </Button>
                  </DockPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- Shows when the chips come close to the sort button (MainWindow.axaml.cs). -->
            <Border Grid.Column="1" Name="SortDivider" Classes="divider unneeded" Margin="16,0,20,0" />
            <Button Grid.Column="2" Name="SearchSortButton" Classes="plain toolbar" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.OpenSearchFilterCommand}" ToolTip.Tip="Filter und Sortierung (L3)">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Classes="glyph" IsVisible="{Binding UsesController}"><TextBlock Text="L3" /></Border>
                <TextBlock Text="{Binding SortText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- Button legend for the input in use: the controller's buttons, or the mouse's and keyboard's. Always there, so
               the keyboard above it never moves; it moved under a click once, and the click missed its key (owner, 2026-10-19). -->
          <Border DockPanel.Dock="Bottom" Height="64">
            <Panel>
            <!-- The band bleeds into the bars beside and below the layout (Theme.axaml, bleed). -->
            <Border Classes="bleedDown" Background="{StaticResource KeyboardSurface}" />
            <!-- In the mouse mode the keyboard has the mouse mode's buttons (#110), the same as over other windows. -->
            <Panel IsVisible="{Binding IsInMouseMode}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="80,0">
              <views:MouseModeKeyboardLegend DataContext="{Binding Keyboard}" />
            </Panel>
            <Panel IsVisible="{Binding !IsInMouseMode}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="80,0">
              <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding UsesController}">
                <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding IsKeyboardOut}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
                    <TextBlock Classes="hint" Text="Tastatur" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                    <TextBlock Classes="hint" Text="Eingeben" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                    <TextBlock Classes="hint" Text="Tastatur einfahren" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="RS" /></Border>
                    <TextBlock Classes="hint" Text="Treffer wählen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="LT" /></Border><Border Classes="glyph"><TextBlock Text="RT" /></Border>
                    <TextBlock Classes="hint" Text="Weitere Treffer" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="≡" /></Border>
                    <TextBlock Classes="hint" Text="{Binding FocusedResult?.PrimaryActionText, TargetNullValue='Spielen'}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="≡" /></Border>
                    <TextBlock Classes="hint" Text="halten: Details" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="⧉" /></Border>
                    <TextBlock Classes="hint" Text="Optionen" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding !IsKeyboardOut}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="D-Pad" /></Border>
                    <TextBlock Classes="hint" Text="Treffer wählen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                    <TextBlock Classes="hint" Text="{Binding FocusedResult?.PrimaryActionText, TargetNullValue='Spielen'}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="A" /></Border>
                    <TextBlock Classes="hint" Text="halten: Details" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="LT" /></Border><Border Classes="glyph"><TextBlock Text="RT" /></Border>
                    <TextBlock Classes="hint" Text="Weitere Treffer" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="⧉" /></Border>
                    <TextBlock Classes="hint" Text="Optionen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="X" /></Border>
                    <TextBlock Classes="hint" Text="Tastatur" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph round"><TextBlock Text="B" /></Border>
                    <TextBlock Classes="hint" Text="Schließen" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <!-- Mouse and keyboard. A real key puts the on-screen keyboard away, so beside it only the mouse is said. -->
              <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding !UsesController}" Classes="keys">
                <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding IsKeyboardOut}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Klick" /></Border>
                    <TextBlock Classes="hint" Text="Eingeben" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Mausrad" /></Border>
                    <TextBlock Classes="hint" Text="Weitere Treffer" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Doppelklick" /></Border>
                    <TextBlock Classes="hint" Text="{Binding FocusedResult?.PrimaryActionText, TargetNullValue='Spielen'}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Klick" /></Border>
                    <TextBlock Classes="hint" Text="halten: Details" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Rechtsklick" /></Border>
                    <TextBlock Classes="hint" Text="Optionen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Esc" /></Border>
                    <TextBlock Classes="hint" Text="Tastatur einfahren" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="28" IsVisible="{Binding !IsKeyboardOut}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="↑ ↓ ← →" /></Border>
                    <TextBlock Classes="hint" Text="Treffer wählen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Bild ↑ ↓" /></Border>
                    <TextBlock Classes="hint" Text="/" />
                    <Border Classes="glyph"><TextBlock Text="Mausrad" /></Border>
                    <TextBlock Classes="hint" Text="Weitere Treffer" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Enter" /></Border>
                    <TextBlock Classes="hint" Text="/" />
                    <Border Classes="glyph"><TextBlock Text="Doppelklick" /></Border>
                    <TextBlock Classes="hint" Text="{Binding FocusedResult?.PrimaryActionText, TargetNullValue='Spielen'}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Enter" /></Border>
                    <TextBlock Classes="hint" Text="/" />
                    <Border Classes="glyph"><TextBlock Text="Klick" /></Border>
                    <TextBlock Classes="hint" Text="halten: Details" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Menütaste" /></Border>
                    <TextBlock Classes="hint" Text="/" />
                    <Border Classes="glyph"><TextBlock Text="Rechtsklick" /></Border>
                    <TextBlock Classes="hint" Text="Optionen" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Border Classes="glyph"><TextBlock Text="Esc" /></Border>
                    <TextBlock Classes="hint" Text="Schließen" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Panel>
            </Panel>
          </Border>

          <!-- On-screen keyboard: slides in from below (X, the tab, a search opened with the gamepad) and out again (B, the
               tab, a real keyboard). Above the hits, so the tab and the layout menu cover them. -->
          <StackPanel DockPanel.Dock="Bottom" ZIndex="1">
            <!-- Docked to the keyboard's top edge, without taking room from the hits. -->
            <Button Classes="plain keyboardTab" Command="{Binding ToggleKeyboardCommand}" Margin="0,-40,0,0"
                    ToolTip.Tip="Bildschirmtastatur ein- oder ausblenden">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Panel IsVisible="{Binding UsesController}" VerticalAlignment="Center">
                  <Border Classes="glyph small round" IsVisible="{Binding !IsKeyboardOut}"><TextBlock Text="X" /></Border>
                  <Border Classes="glyph small round" IsVisible="{Binding IsKeyboardOut}"><TextBlock Text="B" /></Border>
                </Panel>
                <Path Classes="keyboardIcon" Data="M3 6h18v12H3z M7 10h1 M11 10h1 M15 10h1 M8 14h8" StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" Width="22" Stretch="Uniform" VerticalAlignment="Center" />
                <!-- Up while the keyboard is in, down while it's out. -->
                <Path IsVisible="{Binding !IsKeyboardOut}" Data="M6 15l6-6 6 6" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Stretch="Uniform" VerticalAlignment="Center" />
                <Path IsVisible="{Binding IsKeyboardOut}" Data="M6 9l6 6 6-6" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round" Width="14" Stretch="Uniform" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <ctl:RevealPanel Classes="keyboardDrawer bleed" Classes.out="{Binding IsKeyboardOut}">
              <Border Background="{StaticResource KeyboardSurface}" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,14">
                <views:OnScreenKeyboardView DataContext="{Binding Keyboard}" HorizontalAlignment="Center" />
              </Border>
            </ctl:RevealPanel>
          </StackPanel>

          <!-- Hits: one row above the keyboard, a grid without it. The window of hits slides (MainWindow.axaml.cs); hits
               beyond it peek in faded at the edges. -->
          <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
            <Grid Margin="235,0" Height="48" ColumnDefinitions="*,Auto,*" IsVisible="{Binding HasHits}">
              <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{Binding ResultsTitle}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="{Binding RangeText}" FontSize="17" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              </StackPanel>
              <!-- The right stick picks a hit; said here as well as in the legend, where it's easily missed. -->
              <Border Grid.Column="1" Classes="stickHint" IsVisible="{Binding ShowsStickHint}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Border Classes="glyph"><TextBlock Text="RS" /></Border>
                  <TextBlock Classes="hint" Text="Treffer wählen" />
                </StackPanel>
              </Border>
            </Grid>
            <Panel Grid.Row="1" Name="SearchViewport" Background="Transparent" ClipToBounds="True" IsVisible="{Binding HasHits}">
              <Canvas>
                <ItemsControl Name="SearchResults" Classes="hits" Classes.grid="{Binding !IsKeyboardOut}" ItemsSource="{Binding Slots}">
                  <!-- A slot keeps its tile's controls when it shows another hit (SearchViewModel.Slots). -->
                  <ItemsControl.Styles>
                    <Style Selector="ItemsControl#SearchResults > ContentPresenter" x:DataType="search:HitSlotViewModel">
                      <Setter Property="IsVisible" Value="{Binding IsShown}" />
                    </Style>
                  </ItemsControl.Styles>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="search:HitSlotViewModel">
                      <ContentControl Content="{Binding Tile}" ContentTemplate="{StaticResource SearchHitTile}" ClipToBounds="False" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="20" LineSpacing="20" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
              </Canvas>
              <!-- 2 px past the edges, as the grid's fades (GridFadeTop), so no line of hits shows at a scaled window size. -->
              <Border Width="200" HorizontalAlignment="Left" Margin="-2,0,0,0" IsHitTestVisible="False" IsVisible="{Binding IsKeyboardOut}" Background="{StaticResource CarouselFadeLeft}" />
              <Border Width="200" HorizontalAlignment="Right" Margin="0,0,-2,0" IsHitTestVisible="False" IsVisible="{Binding IsKeyboardOut}" Background="{StaticResource CarouselFadeRight}" />
              <Border Height="40" VerticalAlignment="Top" Margin="0,-2,0,0" IsHitTestVisible="False" IsVisible="{Binding !IsKeyboardOut}" Background="{StaticResource ListFadeTop}" />
              <Border Height="96" VerticalAlignment="Bottom" Margin="0,0,0,-2" IsHitTestVisible="False" IsVisible="{Binding !IsKeyboardOut}" Background="{StaticResource ListFadeBottom}" />
              <!-- Where the shown hits are among all of them: across below the row, down beside the grid (owner, 2026-10-19).
                   1450 = the width of seven hits (MainWindow.axaml.cs, HitWindowWidth); dragging scrolls (OnHitsScrollBarScroll). -->
              <ScrollBar Name="HitsRowScrollBar" Orientation="Horizontal" IsVisible="{Binding ShowsRowScrollBar}" Width="1450"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,300,0,0"
                         Minimum="0" Maximum="{Binding ScrollEnd}" ViewportSize="{Binding ScrollViewport}" Value="{Binding ScrollStart, Mode=OneWay}" />
              <ScrollBar Name="HitsGridScrollBar" Orientation="Vertical" IsVisible="{Binding ShowsGridScrollBar}" Height="560"
                         HorizontalAlignment="Center" VerticalAlignment="Top" Margin="1498,40,0,0"
                         Minimum="0" Maximum="{Binding ScrollEnd}" ViewportSize="{Binding ScrollViewport}" Value="{Binding ScrollStart, Mode=OneWay}" />
              <Panel IsVisible="{Binding IsKeyboardOut}">
                <Button Classes="plain glyphButton carouselNav turnHits" HorizontalAlignment="Left" Margin="80,104,0,0" IsVisible="{Binding CanTurn}"
                        Command="{Binding TurnBackCommand}" ToolTip.Tip="Vorherige Treffer (LT, Bild ↑, Mausrad)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Path Classes="chevron" Data="M15 6l-6 6 6 6" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                    <TextBlock Text="LT" IsVisible="{Binding UsesController}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Classes="plain glyphButton carouselNav turnHits" HorizontalAlignment="Right" Margin="0,104,80,0" IsVisible="{Binding CanTurn}"
                        Command="{Binding TurnOnCommand}" ToolTip.Tip="Weitere Treffer (RT, Bild ↓, Mausrad)">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="RT" IsVisible="{Binding UsesController}" VerticalAlignment="Center" />
                    <Path Classes="chevron" Data="M9 6l6 6-6 6" StrokeThickness="2.4" StrokeLineCap="Round" StrokeJoin="Round" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </Panel>
            </Panel>
            <!-- Nothing typed yet, or nothing found: a picture with the text below it; the theme draws both (ContentControl.searchEmpty). -->
            <ContentControl Grid.RowSpan="2" Classes="searchEmpty" Content="{Binding Empty}" IsVisible="{Binding !HasHits}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </DockPanel>
      </Panel>

      <!-- "Ansicht" dialog -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsViewOptionsOpen}">
        <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseViewOptionsCommand}" />
        <Border Width="820" Background="{StaticResource Surface}" CornerRadius="20" Padding="56,48,56,36"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{StaticResource DialogShadow}">
          <Panel>
          <Button Classes="plain dialogClose" Margin="0,-32,-40,0" ToolTip.Tip="Schließen"
                  IsVisible="{Binding ShowsCloseButtons}" Command="{Binding CloseViewOptionsCommand}">
            <Path Data="M1 1L13 13M13 1L1 13" StrokeThickness="2.5" StrokeLineCap="Round" Width="14" Height="14" Stretch="None" />
          </Button>
          <StackPanel Spacing="40" DataContext="{Binding ViewOptions}" x:DataType="vm:ViewOptionsViewModel">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Title}" FontSize="34" FontWeight="ExtraBold" />
              <TextBlock FontSize="17" Foreground="{StaticResource TextMuted}" Text="{Binding Subtitle}" />
            </StackPanel>

            <!-- The search's launchers: any number at once, "Alle Launcher" switches them all on. -->
            <StackPanel Spacing="14" IsVisible="{Binding HasLaunchers}">
              <TextBlock Classes="label" Text="LAUNCHER" FontSize="14" />
              <ItemsControl ItemsSource="{Binding LauncherRows}" Margin="-6">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:Object">
                    <ItemsControl ItemsSource="{Binding}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptionViewModel">
                          <Button Classes="plain size launcher" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                                  Content="{Binding Label}" Command="{Binding ApplyCommand}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="label" Text="SORTIEREN NACH" FontSize="14" />
              <ItemsControl ItemsSource="{Binding SortRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SortRowViewModel">
                    <Grid ColumnDefinitions="*,Auto" Margin="0,6">
                      <TextBlock Text="{Binding Label}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                      <Border Grid.Column="1" Background="{StaticResource Bg}" CornerRadius="26" Padding="4">
                        <ItemsControl ItemsSource="{Binding Options}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OptionViewModel">
                              <Button Classes="plain segment" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                                      Content="{Binding Label}" Command="{Binding ApplyCommand}" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14" IsVisible="{Binding HasPageSizes}">
              <TextBlock Classes="label" Text="EINTRÄGE PRO SEITE" FontSize="14" />
              <ItemsControl ItemsSource="{Binding PageSizeOptions}" Margin="-6">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:OptionViewModel">
                    <Button Classes="plain size" Classes.selected="{Binding IsSelected}" Classes.focused="{Binding IsFocused}"
                            Content="{Binding Label}" Command="{Binding ApplyCommand}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding PageSizeNote}" FontSize="16" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,24,0,0">
              <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                <ctl:KeyHint Pad="D-Pad" Keys="WASD" Text="Wechseln" />
                <ctl:KeyHint Pad="A" Keys="Leertaste" Text="Auswählen" />
                <ctl:KeyHint Pad="B" Keys="Esc" Text="Schließen" />
              </StackPanel>
            </Border>
          </StackPanel>
          </Panel>
        </Border>
      </Panel>

      <!-- Context menu of the focused game, beside its cover or over "Optionen" (placed in MainWindow.axaml.cs). -->
      <Panel Name="GameMenuLayer" Grid.RowSpan="4" IsVisible="{Binding IsGameMenuOpen}">
        <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseMenuCommand}" />
        <Border Name="GameMenuPanel" Width="420" Background="{StaticResource Surface}" CornerRadius="16" Padding="12"
                HorizontalAlignment="Left" VerticalAlignment="Top" BoxShadow="{StaticResource DialogShadow}">
          <StackPanel Spacing="2" DataContext="{Binding GameMenu}" x:DataType="vm:GameMenuViewModel">
            <TextBlock Classes="label" Text="{Binding Title}" FontSize="14" Margin="16,10,16,12" TextTrimming="CharacterEllipsis" />
            <ItemsControl ItemsSource="{Binding Actions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameActionViewModel">
                  <StackPanel>
                    <Border IsVisible="{Binding StartsGroup}" Height="1" Background="{StaticResource Line}" Margin="8,6" />
                    <Button Classes="plain menuItem" Classes.focused="{Binding IsFocused}" Classes.danger="{Binding IsDanger}" IsEnabled="{Binding IsEnabled}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.InvokeMenuActionCommand}" CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="24,*" ColumnSpacing="14">
                        <Path Classes="icon" Data="{Binding Icon}" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                              Width="24" Height="24" Stretch="None" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="note" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" Margin="8,10,8,2">
              <ctl:KeyHint Pad="A" Keys="Leertaste" Text="Auswählen" />
              <ctl:KeyHint Pad="B" Keys="Esc" Text="Schließen" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Asks before an action that can't be undone from Arcadia (uninstalling). -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsConfirmationOpen}">
        <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CancelConfirmationCommand}" />
        <Border Width="680" Background="{StaticResource Surface}" CornerRadius="20" Padding="48,40,48,32"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="{StaticResource DialogShadow}">
          <StackPanel Spacing="28" DataContext="{Binding Confirmation}" x:DataType="vm:ConfirmationViewModel">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="ExtraBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Message}" FontSize="17" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button Classes="plain action danger" Classes.focused="{Binding IsConfirmFocused}" Content="{Binding ConfirmLabel}"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ConfirmCommand}" />
              <Button Classes="plain action" Classes.focused="{Binding IsCancelFocused}" Content="Abbrechen"
                      Command="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.CancelConfirmationCommand}" />
            </StackPanel>
            <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
              <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                <ctl:KeyHint Pad="D-Pad" Keys="WASD" Text="Wechseln" />
                <ctl:KeyHint Pad="A" Keys="Leertaste" Text="Auswählen" />
                <ctl:KeyHint Pad="B" Keys="Esc" Text="Abbrechen" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Panel>

      <!-- Settings page (#15): a whole page in place of the library, which stays as it is underneath for the way back.
           Categories are tabs in the header like the launcher tabs; each is a column of rows with an info panel (pattern "Leiste"). -->
      <Panel Grid.RowSpan="4" IsVisible="{Binding IsSettingsOpen}">
        <!-- Covers the library in the bars beside the layout too. -->
        <Border Classes="bleedAll" Background="{StaticResource Bg}" />
        <Grid RowDefinitions="104,*,72">
          <Grid Margin="80,0" ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <Path Data="M4 30V16a13 13 0 0 1 26 0v14 M11 30v-8h12v8" Stroke="{StaticResource Accent}" StrokeThickness="3"
                    StrokeLineCap="Round" StrokeJoin="Round" Width="34" Height="34" />
              <TextBlock Text="ARCADIA" FontSize="24" FontWeight="ExtraBold" LetterSpacing="1.4" VerticalAlignment="Center" />
              <Border Classes="divider" Margin="6,0" Height="26" />
              <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- As the launcher tabs: in the middle, the selected one centred, faded where more follow (MainWindow.axaml.cs). -->
            <Border Name="CategoryDividerLeft" Grid.Column="1" Classes="divider tabDivider" Margin="20,0" />
            <DockPanel Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Button DockPanel.Dock="Left" Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Margin="0,0,12,0"
                      IsVisible="{Binding Settings?.HasSeveralCategories, TargetNullValue=False}" Command="{Binding Settings?.PreviousCategoryCommand}" ToolTip.Tip="Vorherige Kategorie (⇧ Q)">
                <ctl:KeyText Pad="LB" Keys="⇧ Q" />
              </Button>
              <Button DockPanel.Dock="Right" Classes="plain glyphButton keycap" Classes.kbd="{Binding !UsesController}" Margin="12,0,0,0"
                      IsVisible="{Binding Settings?.HasSeveralCategories, TargetNullValue=False}" Command="{Binding Settings?.NextCategoryCommand}" ToolTip.Tip="Nächste Kategorie (⇧ E)">
                <ctl:KeyText Pad="RB" Keys="⇧ E" />
              </Button>
              <Panel DataContext="{Binding Settings}" x:DataType="settings:SettingsPageViewModel">
                <ScrollViewer Name="CategoryScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                  <ItemsControl Name="CategoryList" ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" Margin="4,0" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="settings:SettingsCategoryViewModel">
                        <Button Classes="plain tab" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}">
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <!-- In the tab's text colour, which the tab styles set. -->
                            <Path Classes="tabIcon" Data="{Binding Icon}" Stroke="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                            <!-- A warning or an error of the category; information shows nothing (owner, 2026-10-22). -->
                            <Path Classes="statusIcon" Classes.error="{Binding IsMarkerError}" IsVisible="{Binding HasMarker}" VerticalAlignment="Center"
                                  ToolTip.Tip="Hier stimmt etwas nicht" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Border Name="CategoryEdgeLeft" IsVisible="False" Width="96" HorizontalAlignment="Left" IsHitTestVisible="False" Background="{StaticResource TabEdgeLeft}" />
                <Border Name="CategoryEdgeRight" IsVisible="False" Width="96" HorizontalAlignment="Right" IsHitTestVisible="False" Background="{StaticResource TabEdgeRight}" />
              </Panel>
            </DockPanel>
            <Border Name="CategoryDividerRight" Grid.Column="3" Classes="divider tabDivider" Margin="20,0" />

            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
              <TextBlock Text="{Binding Status.Date}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Status.Clock}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
              <!-- Mouse or keyboard in use: ✕ closes; the controller has B (owner, 2026-10-22). -->
              <Button Classes="plain dialogClose" VerticalAlignment="Center" ToolTip.Tip="Schließen (Esc)" IsVisible="{Binding ShowsCloseButtons}" Command="{Binding CloseSettingsCommand}">
                <Path Data="M1 1L13 13M13 1L1 13" StrokeThickness="2.5" StrokeLineCap="Round" Width="14" Height="14" Stretch="None" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Rows and the info panel of the shown category. The mouse over a row focuses it (MainWindow.axaml.cs), so
               the info panel explains it before a click changes it. -->
          <Grid Grid.Row="1" Margin="80,0,80,22" ColumnDefinitions="*,620" ColumnSpacing="56" DataContext="{Binding Settings?.Selected}" x:DataType="settings:SettingsCategoryViewModel">
            <!-- While a text is written, the on-screen keyboard takes the clicks: ↵ takes it, "Ausblenden" drops it. -->
            <DockPanel IsHitTestVisible="{Binding !IsEditing}">
            <!-- Above the rows, e.g. a launcher's logo, name and its neighbours on its page (#137). -->
            <ContentControl DockPanel.Dock="Top" Content="{Binding Head}" IsVisible="{Binding Head, Converter={x:Static ObjectConverters.IsNotNull}}">
              <ContentControl.DataTemplates>
                <DataTemplate x:DataType="settings:LauncherPageHeadViewModel">
                  <!-- Room on the right for the neighbour's hover ring, which the page would cut off. -->
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20" Margin="18,4,6,8">
                    <ctl:LauncherLogo Classes="launcherLogo" Badge="{Binding Badge}" Width="56" Height="56" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <!-- B, Esc or a click: back to the list, the way the mouse has (owner, 2026-10-23). -->
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Classes="plain neighbour breadcrumb" Margin="-6,0,0,0" Command="{Binding BackCommand}" ToolTip.Tip="Zurück zur Liste">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ctl:KeyHint Pad="B" Keys="Esc" VerticalAlignment="Center" />
                            <TextBlock Text="Launcher" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                        <TextBlock Text="/" FontSize="15" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Text="{Binding Name}" FontSize="36" FontWeight="ExtraBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- LT/RT, Q/E or a click: the launcher before or after it in the list. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding HasNeighbours}">
                      <Button Classes="plain neighbour" Command="{Binding TurnBackCommand}" ToolTip.Tip="Voriger Launcher">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <ctl:KeyHint Pad="LT" Keys="Q" VerticalAlignment="Center" />
                          <ctl:LauncherLogo Classes="neighbourLogo" Badge="{Binding Previous?.Badge}" Width="24" Height="24" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Previous?.Name, TargetNullValue=''}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                      <Border Classes="divider" Height="24" />
                      <Button Classes="plain neighbour" Command="{Binding TurnOnCommand}" ToolTip.Tip="Nächster Launcher">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <ctl:LauncherLogo Classes="neighbourLogo" Badge="{Binding Next?.Badge}" Width="24" Height="24" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Next?.Name, TargetNullValue=''}" VerticalAlignment="Center" />
                          <ctl:KeyHint Pad="RT" Keys="E" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ContentControl.DataTemplates>
            </ContentControl>
            <ScrollViewer Name="SettingsRowsScroller" VerticalScrollBarVisibility="Hidden" Padding="8" Margin="-8">
              <ItemsControl Name="SettingsRows" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="settings:SettingsRowViewModel">
                    <StackPanel>
                      <TextBlock Classes="settingsGroup" Text="{Binding Group}" IsVisible="{Binding HasGroupHeading}" />
                      <!-- Each group in a box of its own (owner, 2026-10-22): the rows of a group are pieces of one box. -->
                      <Border Classes="groupBox" Classes.first="{Binding StartsGroup}" Classes.last="{Binding EndsGroup}">
                        <Button Classes="plain settingRow pageRow" Classes.indent="{Binding IsIndented}" Classes.indentTwice="{Binding IsIndentedTwice}" Classes.focused="{Binding IsFocused}" Classes.unavailable="{Binding IsDimmed}" Classes.lifted="{Binding IsLifted}"
                                Command="{Binding ClickCommand}">
                          <ContentControl Content="{Binding}">
                            <ContentControl.DataTemplates>
                              <!-- A launcher (#136): its tab key, logo, name and state, and the switch "Aktiv". -->
                              <DataTemplate x:DataType="settings:LauncherRowViewModel">
                                <Grid ColumnDefinitions="30,Auto,*,Auto" ColumnSpacing="20" Classes.launcherInactive="{Binding !IsActive}">
                                  <Border Classes="tabKey" IsVisible="{Binding HasTabKey}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TabKey}" />
                                  </Border>
                                  <Panel Grid.Column="1" Classes.launcherInactive="{Binding !IsActive}" VerticalAlignment="Center">
                                    <ctl:LauncherLogo Classes="launcherLogo" Badge="{Binding Badge}" Width="44" Height="44" />
                                  </Panel>
                                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Classes.launcherInactive="{Binding !IsActive}">
                                    <TextBlock Classes="launcherName" Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                      <!-- No local Fill or Data: they would override the styles. -->
                                      <Ellipse Classes="statusDot" Classes.active="{Binding IsHealthy}" Width="9" Height="9" VerticalAlignment="Center" IsVisible="{Binding !HasSeverity}" />
                                      <Path Classes="statusIcon small" IsVisible="{Binding HasSeverity}" VerticalAlignment="Center" />
                                      <TextBlock Classes="launcherStatus" Classes.warning="{Binding HasSeverity}" Text="{Binding StatusText}" />
                                    </StackPanel>
                                  </StackPanel>
                                  <Panel Grid.Column="3" VerticalAlignment="Center">
                                    <Border Classes="valuePill" IsVisible="{Binding HasSwitch}">
                                      <Panel>
                                        <Button Classes="plain valueToggle" Command="{Binding ToggleCommand}" IsEnabled="{Binding CanChange}" />
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                          <Button Classes="plain valueArrow" Command="{Binding StepBackCommand}" IsEnabled="{Binding CanDecrease}" ToolTip.Tip="Abschalten">
                                            <Path Classes="chevronLeft" />
                                          </Button>
                                          <TextBlock Grid.Column="1" Classes="valueText" Classes.on="{Binding IsActive}" Text="{Binding ValueText}" IsHitTestVisible="False" />
                                          <Button Grid.Column="2" Classes="plain valueArrow" Command="{Binding StepOnCommand}" IsEnabled="{Binding CanIncrease}" ToolTip.Tip="Einschalten">
                                            <Path Classes="chevronRight" />
                                          </Button>
                                        </Grid>
                                      </Panel>
                                    </Border>
                                    <Border Classes="valuePill" IsVisible="{Binding !HasSwitch}" ToolTip.Tip="Nicht auf diesem PC installiert">
                                      <TextBlock Classes="valueText missing" Text="Nicht installiert" />
                                    </Border>
                                  </Panel>
                                </Grid>
                              </DataTemplate>
                              <DataTemplate x:DataType="settings:SettingsRowViewModel">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="20">
                            <!-- No local Data or Stroke: a local value would override the severity styles. -->
                            <Path Classes="statusIcon" Classes.info="{Binding IsInfo}" Classes.error="{Binding IsError}" IsVisible="{Binding HasSeverity}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock ctl:ButtonTextBlock.Text="{Binding Title}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" />
                                <!-- No local Fill: it would override the "active" style. -->
                                <Ellipse Classes="statusDot" Classes.active="{Binding IsLampOn}" Width="10" Height="10" VerticalAlignment="Center"
                                         IsVisible="{Binding HasLamp}" />
                              </StackPanel>
                              <TextBlock ctl:ButtonTextBlock.Text="{Binding Subtitle}" IsVisible="{Binding HasSubtitle}" FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                              <TextBlock Classes="rowProblem" Text="{Binding Problem}" IsVisible="{Binding HasProblem}" />
                            </StackPanel>
                            <ContentControl Grid.Column="2" Content="{Binding}" VerticalAlignment="Center">
                              <ContentControl.DataTemplates>
                                <!-- A text (#137): its value with a pencil; while it is written, the text with its caret. -->
                                <DataTemplate x:DataType="settings:TextRowViewModel">
                                  <Border Classes="textField" Classes.editing="{Binding IsEditing}" Classes.problem="{Binding HasProblem}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                      <StackPanel Orientation="Horizontal" ClipToBounds="True">
                                        <TextBlock Classes="fieldPrefix" Text="{Binding Prefix}" IsVisible="{Binding HasPrefix}" />
                                        <TextBlock Classes="fieldText" Text="{Binding ValueText}" IsVisible="{Binding !IsEditing}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="fieldText" Text="{Binding Editor?.TextBeforeCaret, TargetNullValue=''}" IsVisible="{Binding IsEditing}" />
                                        <Border Classes="caret fieldCaret" IsVisible="{Binding IsEditing}" />
                                        <TextBlock Classes="fieldText" Text="{Binding Editor?.TextAfterCaret, TargetNullValue=''}" IsVisible="{Binding IsEditing}" />
                                      </StackPanel>
                                      <Path Grid.Column="1" Classes="pencil" IsVisible="{Binding !IsEditing}" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="settings:SisrRowViewModel">
                                  <Panel>
                                    <Border Classes="valuePill" Classes.locked="{Binding IsLocked}" IsVisible="{Binding IsSwitch}">
                                      <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Button Classes="plain valueArrow" Command="{Binding StepBackCommand}" IsEnabled="{Binding IsOn}">
                                          <Path Classes="chevronLeft" />
                                        </Button>
                                        <TextBlock Grid.Column="1" Classes="valueText" Classes.on="{Binding IsOn}" Text="{Binding ValueText}" />
                                        <Button Grid.Column="2" Classes="plain valueArrow" Command="{Binding StepOnCommand}" IsEnabled="{Binding !IsOn}">
                                          <Path Classes="chevronRight" />
                                        </Button>
                                      </Grid>
                                    </Border>
                                    <!-- Not a button of its own: the whole row is the button, so A on the row installs. -->
                                    <Border Classes="rowAction" Classes.locked="{Binding IsLocked}" IsVisible="{Binding IsInstall}">
                                      <TextBlock Text="SISR installieren" />
                                    </Border>
                                  </Panel>
                                </DataTemplate>
                                <DataTemplate x:DataType="settings:SwitchRowViewModel">
                                  <Border Classes="valuePill">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <Button Classes="plain valueArrow" Command="{Binding StepBackCommand}" IsEnabled="{Binding CanDecrease}">
                                        <Path Classes="chevronLeft" />
                                      </Button>
                                      <TextBlock Grid.Column="1" Classes="valueText" Classes.on="{Binding IsOn}" Text="{Binding ValueText}" />
                                      <Button Grid.Column="2" Classes="plain valueArrow" Command="{Binding StepOnCommand}" IsEnabled="{Binding CanIncrease}">
                                        <Path Classes="chevronRight" />
                                      </Button>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="settings:ChoiceRowViewModel">
                                  <Border Classes="valuePill">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                      <Button Classes="plain valueArrow" Command="{Binding StepBackCommand}" IsEnabled="{Binding CanDecrease}">
                                        <Path Classes="chevronLeft" />
                                      </Button>
                                      <TextBlock Grid.Column="1" Classes="valueText" Text="{Binding ValueText}" />
                                      <Button Grid.Column="2" Classes="plain valueArrow" Command="{Binding StepOnCommand}" IsEnabled="{Binding CanIncrease}">
                                        <Path Classes="chevronRight" />
                                      </Button>
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="settings:ActionRowViewModel">
                                  <Border Classes="rowGo" Classes.primary="{Binding IsPrimary}" Classes.disabled="{Binding !IsEnabled}" IsVisible="{Binding HasAction}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                      <TextBlock Text="{Binding ActionText}" />
                                      <Path Grid.Column="1" Classes="chevronRight" />
                                    </Grid>
                                  </Border>
                                </DataTemplate>
                                <DataTemplate x:DataType="settings:InfoRowViewModel">
                                  <TextBlock Classes="rowValue" Text="{Binding ValueText}" IsVisible="{Binding HasValue}" />
                                </DataTemplate>
                              </ContentControl.DataTemplates>
                            </ContentControl>
                          </Grid>
                              </DataTemplate>
                            </ContentControl.DataTemplates>
                          </ContentControl>
                        </Button>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            </DockPanel>

            <!-- Beside the rows: a preview of what the focused row changes, if it has one (e.g. the launchers' tab strip,
                 #136), and below it the row explained. RS (or the wheel) scrolls it; the fades say there is more
                 (MainWindow.axaml.cs). -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="20">
              <Grid.DataTemplates>
                <DataTemplate x:DataType="settings:InfoText">
                  <TextBlock Classes="infoText" ctl:ButtonTextBlock.Text="{Binding Text}" />
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoHeading">
                  <TextBlock Classes="label" Text="{Binding Text}" Margin="0,8,0,0" />
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoBullet">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Ellipse Classes="infoBullet" />
                    <TextBlock Grid.Column="1" Classes="infoText" ctl:ButtonTextBlock.Text="{Binding Text}" />
                  </Grid>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoCard">
                  <Border Classes="modeCard">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" />
                      <TextBlock Classes="bullet" Text="{Binding Text}" />
                      <TextBlock Classes="modeDefault" Text="{Binding Note}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoKey">
                  <Grid ColumnDefinitions="170,*" ColumnSpacing="16">
                    <TextBlock ctl:ButtonTextBlock.Buttons="{Binding Input}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextStrong}" />
                    <TextBlock Grid.Column="1" Text="{Binding Effect}" FontSize="16" Foreground="{StaticResource TextSoft}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
                <!-- Its blocks find the templates of this ItemsControl, up the tree. -->
                <DataTemplate x:DataType="settings:InfoSection">
                  <Border Classes="infoSection">
                    <StackPanel Spacing="14">
                      <TextBlock Classes="label" Text="{Binding Title}" />
                      <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoStatus">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Panel Width="24" Height="24" VerticalAlignment="Top">
                      <Path Classes="spinner" IsVisible="{Binding IsInTransition}"><Path.RenderTransform><RotateTransform /></Path.RenderTransform></Path>
                      <!-- No local Fill: it would override the "active" style. -->
                      <Ellipse Classes="statusDot" Classes.active="{Binding IsHealthy}" Width="12" Height="12" IsVisible="{Binding ShowsDot}" />
                    </Panel>
                    <TextBlock Grid.Column="1" Classes="infoText" Text="{Binding Text}" />
                  </Grid>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoExample">
                  <Border Classes="infoExample">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Classes="exampleSample" Text="{Binding Sample}" />
                      <TextBlock Classes="exampleEffect" Text="{Binding Effect}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoError">
                  <TextBlock Text="{Binding Text}" FontSize="16" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
                </DataTemplate>
                <!-- The launcher settings (#136): a note, the tab strip in miniature, the launcher's head, its facts. -->
                <DataTemplate x:DataType="settings:InfoNote">
                  <Border Classes="infoNote">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                      <Path Classes="statusIcon" VerticalAlignment="Top" />
                      <TextBlock Grid.Column="1" Text="{Binding Text}" />
                    </Grid>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoTabBar">
                  <Border Classes="miniTabs">
                    <Panel>
                      <TextBlock Classes="launcherState" Text="Kein Launcher aktiv – die Bibliothek bleibt leer." IsVisible="{Binding IsEmpty}" />
                      <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="settings:InfoTab">
                            <Border Classes="miniTab" Classes.highlighted="{Binding IsHighlighted}" Margin="0,3,6,3">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <ctl:LauncherLogo Classes="launcherLogo" Badge="{Binding Badge}" Width="22" Height="22" VerticalAlignment="Center" />
                                <TextBlock Classes="miniTabName" Text="{Binding Name}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Panel>
                  </Border>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoLauncher">
                  <StackPanel Orientation="Horizontal" Spacing="18">
                    <ctl:LauncherLogo Classes="launcherLogo" Badge="{Binding Badge}" Width="64" Height="64" />
                    <StackPanel Spacing="4" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" FontSize="28" FontWeight="ExtraBold" Foreground="{StaticResource TextStrong}" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Classes="statusDot" Classes.active="{Binding IsActive}" Width="9" Height="9" VerticalAlignment="Center" />
                        <TextBlock Classes="launcherState" Classes.active="{Binding IsActive}" Text="{Binding StateText}" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoFacts">
                  <StackPanel Spacing="2">
                    <TextBlock Classes="label" Text="{Binding Title}" Margin="0,4,0,0" />
                    <ItemsControl ItemsSource="{Binding Facts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="settings:InfoFact">
                          <Border Classes="infoFact">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                              <TextBlock Classes="factLabel" Text="{Binding Label}" />
                              <TextBlock Grid.Column="1" Classes="factValue" Classes.muted="{Binding IsMuted}" Classes.good="{Binding IsGood}" Text="{Binding Value}"
                                         ToolTip.Tip="{Binding Value}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoFootnote">
                  <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" />
                </DataTemplate>
                <DataTemplate x:DataType="settings:InfoRelease">
                  <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <Border Background="{StaticResource VersionPill}" CornerRadius="10" Padding="10,3">
                        <TextBlock Text="{Binding VersionText}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentSoft}" />
                      </Border>
                      <TextBlock Text="{Binding DateText}" FontSize="14" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Changes}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="4,0,0,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Accent}" VerticalAlignment="Top" Margin="0,8,0,0" />
                            <TextBlock Grid.Column="1" Text="{Binding}" FontSize="15" Foreground="{StaticResource Text}" TextWrapping="Wrap" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </Grid.DataTemplates>
              <Border Classes="infoPanel" IsVisible="{Binding FocusedRow?.HasPreview, TargetNullValue=False}">
                <StackPanel Spacing="20" Margin="32,30">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" FontSize="14" Text="{Binding FocusedRow?.PreviewTitle, TargetNullValue=''}" />
                    <TextBlock Text="{Binding FocusedRow?.PreviewSubtitle, TargetNullValue=''}" IsVisible="{Binding FocusedRow?.HasPreviewSubtitle, TargetNullValue=False}" FontSize="14" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding FocusedRow?.Preview}" />
                </StackPanel>
              </Border>
              <Border Grid.Row="1" Classes="infoPanel">
                <Panel>
                  <ScrollViewer Name="InfoScroller" VerticalScrollBarVisibility="Hidden">
                    <StackPanel Spacing="20" Margin="32,30">
                      <TextBlock Classes="label" FontSize="14" Text="{Binding FocusedRow?.InfoTitle, TargetNullValue=''}" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding FocusedRow?.Info}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Spacing="16" />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                      </ItemsControl>
                    </StackPanel>
                  </ScrollViewer>
                  <Border Name="InfoFadeTop" Classes="listFade" Background="{StaticResource InfoFadeTop}" VerticalAlignment="Top" CornerRadius="20,20,0,0" />
                  <Border Name="InfoFadeBottom" Classes="listFade" Background="{StaticResource InfoFadeBottom}" VerticalAlignment="Bottom" CornerRadius="0,0,20,20" />
                </Panel>
              </Border>
            </Grid>
          </Grid>

          <!-- The on-screen keyboard while a text of the settings is written (#137), the same as the search's. -->
          <ctl:RevealPanel Grid.Row="1" Classes="keyboardDrawer bleed" Classes.out="{Binding Settings?.Selected.IsEditing, TargetNullValue=False}" VerticalAlignment="Bottom"
                           IsVisible="{Binding Settings?.Selected.IsEditing, TargetNullValue=False}">
            <Border Background="{StaticResource KeyboardSurface}" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,14">
              <views:OnScreenKeyboardView DataContext="{Binding Settings?.Selected.Editor?.Keyboard}" HorizontalAlignment="Center" />
            </Border>
          </ctl:RevealPanel>

          <!-- Footer: the buttons of the focused row and the page, for the input in use (#127). -->
          <Border Grid.Row="2" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Margin="-1920,0" Padding="2000,0"
                  DataContext="{Binding Settings}" x:DataType="settings:SettingsPageViewModel">
            <Panel>
            <!-- A change that couldn't be saved still applies until Arcadia closes. -->
            <TextBlock Text="{Binding Changes.Error}" IsVisible="{Binding Changes.Error, Converter={x:Static ObjectConverters.IsNotNull}}" MaxWidth="900"
                       HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="15" Foreground="{StaticResource Danger}" TextWrapping="Wrap" />
            <!-- A launcher lifted to be moved (#136): only what moves it, puts it down or cancels. -->
            <!-- A text being written (#137): the on-screen keyboard's buttons. -->
            <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding Selected.IsEditing}">
              <ctl:KeyHint Pad="A" Alt="Klick" Text="Eingeben" />
              <ctl:KeyHint Pad="X" Keys="⌫" Text="Löschen" />
              <ctl:KeyHint Pad="Y" Text="Leerzeichen" />
              <ctl:KeyHint Pad="LB|RB" Text="⇧ / AltGr" />
              <ctl:KeyHint Pad="≡" Keys="Enter" Text="Übernehmen" />
              <ctl:KeyHint Pad="B" Keys="Esc" Text="Verwerfen" />
            </StackPanel>
            <Panel IsVisible="{Binding !Selected.IsEditing}">
            <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding Selected.IsReordering}">
              <ctl:KeyHint Pad="▲▼" Keys="W|S" Alt="Ziehen" Text="Verschieben" />
              <ctl:KeyHint Pad="Y" Keys="V" Alt="Loslassen" Text="Ablegen" />
              <ctl:KeyHint Pad="B" Keys="Esc" Text="Abbrechen" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right" VerticalAlignment="Center" IsVisible="{Binding !Selected.IsReordering}">
              <ctl:KeyHint Pad="◀▶" Keys="A|D" Alt="Klick" Text="Ändern" IsVisible="{Binding FocusedRow?.CanChange, TargetNullValue=False}" />
              <ctl:KeyHint Pad="A" Keys="Leertaste" Alt="Klick" Text="{Binding FocusedRow?.ActivateText, TargetNullValue=''}" IsVisible="{Binding FocusedRow?.ShowsActivateHint, TargetNullValue=False}" />
              <ctl:KeyHint Pad="Y" Keys="V" Alt="Ziehen" Text="{Binding Selected.YActionText}" IsVisible="{Binding Selected.YActionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ctl:KeyHint Pad="X" Keys="F" Text="{Binding Selected.XActionText}" IsVisible="{Binding Selected.XActionText, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ctl:KeyHint Pad="RS" Keys="⇧ W|⇧ S" Alt="Mausrad" Text="Infotext" IsVisible="{Binding InfoOverflows}" />
              <ctl:KeyHint Pad="LT|RT" Keys="Q|E" Alt="Klick" Text="Launcher" IsVisible="{Binding Selected.Head, Converter={x:Static ObjectConverters.IsNotNull}}" />
              <ctl:KeyHint Pad="LB|RB" Keys="⇧ Q|⇧ E" Alt="Klick" Text="Kategorie" IsVisible="{Binding HasSeveralCategories}" />
              <ctl:KeyHint Pad="B" Keys="Esc" Text="Zurück" />
            </StackPanel>
            </Panel>
            </Panel>
          </Border>
        </Grid>

        <!-- A dialog of the shown category over the page, e.g. before "SISR installieren" goes on. -->
        <ContentControl Content="{Binding Settings?.Selected.Dialog, TargetNullValue={x:Null}}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="settings:ControllerSettingsViewModel">
              <!-- The page stays dimmed behind it. -->
              <Panel>
                <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Command="{Binding ClosePromptCommand}" />
                <Border Classes="prompt" Width="720" HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Panel>
                  <StackPanel Spacing="28">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                      <Border Classes="promptIcon" Classes.warning="{Binding IsWarningPrompt}">
                        <Panel>
                          <TextBlock Text="!" IsVisible="{Binding IsWarningPrompt}" />
                          <TextBlock Text="?" IsVisible="{Binding IsQuestionPrompt}" />
                        </Panel>
                      </Border>
                      <TextBlock Text="Steam-Spiel läuft" IsVisible="{Binding IsGamePrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                      <TextBlock Text="Steam beenden?" IsVisible="{Binding IsSteamStopPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding SteamStartFailedTitle}" IsVisible="{Binding IsSteamStartFailedPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                      <TextBlock Text="Steam-Eintrag für SISR anlegen?" IsVisible="{Binding IsMarkerPrompt}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsGamePrompt}">
                      <Border Classes="promptGame">
                        <TextBlock FontSize="20" TextWrapping="Wrap">
                          <Run Text="{Binding RunningGame}" FontWeight="ExtraBold" />
                          <Run Text=" läuft gerade über Steam." />
                        </TextBlock>
                      </Border>
                      <TextBlock Classes="promptBody" Text="Für die Installation muss Steam beendet und neu gestartet werden. Beende zuerst das Spiel und versuche es dann erneut." />
                    </StackPanel>
                    <StackPanel Spacing="14" IsVisible="{Binding IsSteamStopPrompt}">
                      <TextBlock Classes="promptBody" Text="Für die Installation muss Steam beendet werden. Arcadia startet Steam danach wieder im Hintergrund." />
                      <TextBlock Classes="promptBody" Text="Danach werden SISR und der usbip-Treiber installiert. Windows fragt dabei einmal nach Administratorrechten." />
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsSteamStartFailedPrompt}">
                      <TextBlock Classes="promptBody" Text="{Binding SteamStartFailedText}" />
                      <TextBlock Classes="promptBody" Text="{Binding SteamStartFailedHint}" />
                    </StackPanel>

                    <StackPanel Spacing="14" IsVisible="{Binding IsMarkerPrompt}">
                      <TextBlock Classes="promptBody" Text="SISR braucht in Steam einen Eintrag „SISR Marker“ als Nicht-Steam-Spiel. Er erscheint in der Steam-Bibliothek des Kontos. Ohne ihn lässt sich die Funktion nicht nutzen." />
                      <TextBlock Classes="promptBody" Text="Auf diesem PC gibt es mehrere Steam-Konten. Für welche soll der Eintrag angelegt werden? Mit anderen Konten bleibt die Funktion aus, bis der Eintrag dort angelegt ist." />
                      <ItemsControl ItemsSource="{Binding MarkerAccounts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="settings:MarkerAccountViewModel">
                            <Button Classes="plain settingRow" Classes.focused="{Binding IsFocused}" Classes.done="{Binding HasMarker}"
                                    Command="{Binding ToggleCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="16">
                                <Border Classes="checkbox" Classes.on="{Binding IsChecked}">
                                  <TextBlock Text="✓" IsVisible="{Binding IsChecked}" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Classes="hint" Text="bereits eingerichtet" IsVisible="{Binding HasMarker}" VerticalAlignment="Center" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsMarkerPrompt}">
                      <Button Classes="plain action primaryAction" Classes.focused="{Binding ConfirmMarkerAccountsItem.IsFocused}"
                              Command="{Binding ConfirmMarkerAccountsCommand}" IsEnabled="{Binding CanConfirmMarkerAccounts}" Content="Weiter" />
                      <Button Classes="plain action" Classes.focused="{Binding CancelMarkerAccountsItem.IsFocused}"
                              Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsGamePrompt}">
                      <Button Classes="plain action primaryAction" Classes.focused="{Binding RetryInstallItem.IsFocused}"
                              Command="{Binding RetryInstallCommand}" Content="Erneut versuchen" />
                      <Button Classes="plain action" Classes.focused="{Binding CloseGamePromptItem.IsFocused}"
                              Command="{Binding ClosePromptCommand}" Content="Schließen" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSteamStopPrompt}">
                      <Button Classes="plain action primaryAction" Classes.focused="{Binding ConfirmSteamStopItem.IsFocused}"
                              Command="{Binding ConfirmSteamStopCommand}" Content="Steam beenden und installieren" />
                      <Button Classes="plain action" Classes.focused="{Binding CancelSteamStopItem.IsFocused}"
                              Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding IsSteamStartFailedPrompt}">
                      <Button Classes="plain action primaryAction" Classes.focused="{Binding RetrySteamStartItem.IsFocused}"
                              Command="{Binding RetrySteamStartCommand}" Content="{Binding SteamStartFailedAction}" />
                      <Button Classes="plain action" Classes.focused="{Binding CancelSteamStartItem.IsFocused}"
                              Command="{Binding ClosePromptCommand}" Content="Abbrechen" />
                    </StackPanel>

                    <Border BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="28" HorizontalAlignment="Right">
                        <ctl:KeyHint Pad="A" Keys="Leertaste" Text="Auswählen" />
                        <ctl:KeyHint Pad="B" Keys="Esc" Text="{Binding PromptBackText}" />
                      </StackPanel>
                    </Border>
                  </StackPanel>
                  <Button Classes="plain dialogClose" Margin="0,-20,-28,0" ToolTip.Tip="Schließen"
                          IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ShowsCloseButtons, TargetNullValue=False}" Command="{Binding ClosePromptCommand}">
                    <Path Data="M1 1L13 13M13 1L1 13" StrokeThickness="2.5" StrokeLineCap="Round" Width="14" Height="14" Stretch="None" />
                  </Button>
                  </Panel>
                </Border>
              </Panel>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Panel>

      <!-- Toast: last, so it shows over every page, also the settings (e.g. "Alle Launcher sind neu eingelesen", #136). -->
      <Border Grid.Row="2" Grid.RowSpan="2" IsVisible="{Binding Toast.IsVisible}" Background="{StaticResource SurfaceRaised}" CornerRadius="14"
              Padding="24,14" Margin="0,0,0,96" HorizontalAlignment="Center" VerticalAlignment="Bottom" BoxShadow="{StaticResource ToastShadow}">
        <TextBlock Text="{Binding Toast.Text}" FontSize="18" FontWeight="SemiBold" />
      </Border>
    </Grid>
  </Viewbox>

  <Window.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="LetterSpacing" Value="1" />
      <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    </Style>
    <Style Selector="Ellipse.statusDot">
      <Setter Property="Fill" Value="{StaticResource TextFaint}" />
    </Style>
    <Style Selector="Ellipse.statusDot.active">
      <Setter Property="Fill" Value="{StaticResource Success}" />
    </Style>
    <!-- Status messages (owner, 2026-10-21): a warning by default, info a blue i in a circle, error a red X. -->
    <Style Selector="Path.statusIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Stretch" Value="None" />
      <Setter Property="StrokeThickness" Value="2" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Data" Value="M12 3.5L2.5 20h19z M12 10v4.5 M12 17.2v.3" />
      <Setter Property="Stroke" Value="{StaticResource Warning}" />
    </Style>
    <Style Selector="Path.statusIcon.info">
      <Setter Property="Data" Value="M2.5 12a9.5 9.5 0 1 0 19 0a9.5 9.5 0 1 0 -19 0z M12 11v5.5 M12 7.6v.3" />
      <Setter Property="Stroke" Value="{StaticResource Info}" />
    </Style>
    <Style Selector="Path.statusIcon.error">
      <Setter Property="Data" Value="M5.5 5.5l13 13 M18.5 5.5l-13 13" />
      <Setter Property="StrokeThickness" Value="2.6" />
      <Setter Property="Stroke" Value="{StaticResource Danger}" />
    </Style>
    <Style Selector="TextBlock.bullet">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.modeDefault">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.crumb">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.crumb.separator">
      <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>
    <Style Selector="TextBlock.crumb.current">
      <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
</Window>
