  <Style Selector="Border.artworkMiniFact">
    <Setter Property="Height" Value="60" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource Surface}" />
  </Style>
  <Style Selector="Border.artworkFacts">
    <Setter Property="Margin" Value="0,22,0,0" />
    <Setter Property="Padding" Value="20,14" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="DockPanel.artworkFact">
    <Setter Property="Margin" Value="0,6" />
  </Style>
  <Style Selector="TextBlock.artworkFactLabel">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.artworkFactValue">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="Margin" Value="20,0,0,0" />
  </Style>
  <Style Selector="Border.artworkFrame">
    <Setter Property="Width" Value="154" />
    <Setter Property="Height" Value="231" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="ItemsControl.hero Border.artworkFrame">
    <Setter Property="Width" Value="412" />
    <Setter Property="Height" Value="133" />
  </Style>
  <Style Selector="Button.artworkTile.focused Border.artworkFrame">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Border.artworkOwnEmpty">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineStrong}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="StackPanel.artworkOwnContent">
    <Setter Property="Spacing" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="ItemsControl.hero StackPanel.artworkOwnContent">
    <Setter Property="Orientation" Value="Horizontal" />
  </Style>
  <Style Selector="Path.artworkFolderIcon">
    <Setter Property="Data" Value="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2zM12 10v6M9 13h6" />
    <Setter Property="Stroke" Value="{StaticResource TextSoft}" />
    <Setter Property="StrokeThickness" Value="1.8" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.artworkOwnLabel">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.artworkTag">
    <Setter Property="Background" Value="{StaticResource LauncherBadgePlate}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Border.artworkTag TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="LetterSpacing" Value="0.5" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Border.artworkTick">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="CornerRadius" Value="15" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Background" Value="{StaticResource Accent}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Path.artworkTickMark">
    <Setter Property="Data" Value="M5 12l5 5 9-10" />
    <Setter Property="Stroke" Value="{StaticResource OnAccent}" />
    <Setter Property="StrokeThickness" Value="3.4" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.artworkCaption">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    <Setter Property="MaxWidth" Value="154" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="ItemsControl.hero TextBlock.artworkCaption">
    <Setter Property="MaxWidth" Value="412" />
  </Style>
  <Style Selector="Border.artworkNotice">
    <Setter Property="Width" Value="502" />
    <Setter Property="Height" Value="259" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="28,26" />
    <Setter Property="Background" Value="{StaticResource InfoNoteSurface}" />
  </Style>
  <Style Selector="ItemsControl.hero Border.artworkNotice">
    <Setter Property="Width" Value="852" />
    <Setter Property="Height" Value="NaN" />
  </Style>
  <Style Selector="TextBlock.artworkNoticeTitle">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="TextBlock.artworkNoticeText">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource InfoNoteText}" />
  </Style>
  <Style Selector="Button.artworkNoticeButton">
    <Setter Property="Height" Value="46" />
    <Setter Property="Padding" Value="22,0" />
    <Setter Property="CornerRadius" Value="23" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
  </Style>
  <Style Selector="Button.artworkNoticeButton.focused /template/ Border#Chrome">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Border.artworkFooter">
    <Setter Property="Height" Value="76" />
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
  </Style>
  <Style Selector="Button.artworkRestore.off">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>

  <!-- "Warten auf deine Auswahl" (#491, prototype in #13): the games left, the current game's hits right, four a row. -->
  <Style Selector="Path.waitingIcon">
    <Setter Property="Data" Value="M11 4.5a6.5 6.5 0 1 0 0 13a6.5 6.5 0 1 0 0-13M20 20l-4.2-4.2M11 8.5v3M11 13.8v.2" />
    <Setter Property="Stroke" Value="{StaticResource Warning}" />
    <Setter Property="StrokeThickness" Value="2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.waitingPosition">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.waitingGames">
    <Setter Property="Padding" Value="0,0,28,0" />
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>
  <Style Selector="Button.waitingGame">
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.waitingGame.current">
    <Setter Property="Background" Value="{StaticResource SurfaceRaised}" />
  </Style>
  <Style Selector="Border.waitingMonogram">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="66" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
  </Style>
  <Style Selector="Border.waitingMonogram > TextBlock">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="Black" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.waitingGameName">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.waitingGameLauncher">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="TextBlock.waitingCurrent">
    <Setter Property="FontSize" Value="24" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style Selector="TextBlock.waitingIntro">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="26" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <!-- #506: what Arcadia seeks for the game, above its hits. -->
  <Style Selector="TextBlock.waitingSought">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource AccentSoft}" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>
  <!-- The games list and the hit grid scroll like the settings rows: a thin bar where they don't fit. -->
  <Style Selector="ScrollViewer.waitingScroller">
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <!-- "Eigener Suchbegriff": the field of the text rows, as wide as the row, with the focus ring when focused. -->
  <Style Selector="Button.waitingTermButton">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Border.waitingTerm">
    <Setter Property="Width" Value="NaN" />
  </Style>
  <Style Selector="Border.waitingTerm.focused">
    <Setter Property="BoxShadow" Value="{StaticResource FocusRing}" />
  </Style>
  <Style Selector="Button.waitingReset.off">
    <Setter Property="Opacity" Value="0.4" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="TextBlock.waitingStatus">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- A hit without a year is shorter; its tile stays at the top of the row with the others. -->
  <Style Selector="Button.waitingHit">
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="0,0,22,18" />
  </Style>
  <!-- Five covers a row (WaitingHitsViewModel.CoverColumns), as wide as the pane allows, so names have room. -->
  <Style Selector="Button.waitingHit Border.artworkFrame">
    <Setter Property="Width" Value="166" />
    <Setter Property="Height" Value="249" />
  </Style>
  <!-- Three backgrounds a row (HeroColumns) when only the background is sought. -->
  <Style Selector="ItemsControl.hero Button.waitingHit Border.artworkFrame">
    <Setter Property="Width" Value="280" />
    <Setter Property="Height" Value="90" />
  </Style>
  <Style Selector="ItemsControl.hero TextBlock.waitingHitName">
    <Setter Property="MaxWidth" Value="280" />
  </Style>
  <Style Selector="TextBlock.waitingHitPlaceholder">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="Margin" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.waitingHitName">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="Margin" Value="0,8,0,0" />
    <Setter Property="MaxWidth" Value="166" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="MaxLines" Value="2" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <!-- Namesakes often differ only at the end of their names: the focused hit shows its name in full. -->
  <Style Selector="Button.waitingHit.focused TextBlock.waitingHitName">
    <Setter Property="MaxLines" Value="0" />
  </Style>
  <Style Selector="TextBlock.waitingHitYear">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
  </Style>
  <Style Selector="Border.waitingNote">
    <Setter Property="Margin" Value="0,24,0,0" />
    <Setter Property="Padding" Value="20,16" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Background" Value="{StaticResource SurfaceSunken}" />
    <Setter Property="BorderBrush" Value="{StaticResource SurfaceRaised}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.waitingNote > TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="LineHeight" Value="25" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
  </Style>
  <Style Selector="StackPanel.waitingDone">
    <Setter Property="Spacing" Value="16" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.waitingDoneTitle">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="ExtraBold" />
    <Setter Property="Foreground" Value="{StaticResource TextStrong}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.waitingDoneText">
    <Setter Property="FontSize" Value="20" />
    <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
</Styles>
