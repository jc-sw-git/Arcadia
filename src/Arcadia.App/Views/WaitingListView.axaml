<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Arcadia.App"
             xmlns:vm="using:Arcadia.App.ViewModels"
             xmlns:ctl="using:Arcadia.App.Controls"
             xmlns:views="using:Arcadia.App.Views"
             x:Class="Arcadia.App.Views.WaitingListView"
             x:DataType="vm:WaitingListViewModel">

  <!-- "Warten auf deine Auswahl" (#491, two levels since #506, metadata entries since #494): left the entries waiting, right the current entry's hits. -->
  <Panel>
    <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Command="{Binding CloseCommand}" />
    <Border Classes="artworkModal" Width="1520" Height="940" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Height="64" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="18">
          <Border Classes="promptIcon warning">
            <Path Classes="waitingIcon" />
          </Border>
          <TextBlock Grid.Column="1" Text="{x:Static vm:WaitingListViewModel.Title}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="artworkGame" Text="{x:Static vm:WaitingListViewModel.Question}" />
          <TextBlock Grid.Column="4" Classes="waitingPosition" Text="{Binding Position}" />
          <Button Grid.Column="5" Classes="plain dialogClose" Margin="8,0,-22,0" VerticalAlignment="Top" ToolTip.Tip="{x:Static app:AppTexts.Close}"
                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.Input.ShowsCloseButtons, TargetNullValue=False}" Command="{Binding CloseCommand}">
            <Path Data="M1 1L13 13M13 1L1 13" StrokeThickness="2.5" StrokeLineCap="Round" Width="14" Height="14" Stretch="None" />
          </Button>
        </Grid>

        <!-- Footer: what the buttons do on the level the focus is on; after the last game only B. -->
        <Border DockPanel.Dock="Bottom" Classes="artworkFooter">
          <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ctl:KeyHint Pad="D-Pad" Keys="WASD" Text="{Binding ChooseHint}" IsVisible="{Binding HasGames}" />
            <Button Classes="plain" Command="{Binding SkipCommand}" IsVisible="{Binding HasGames}">
              <ctl:KeyHint Pad="Y" Keys="V" Text="{x:Static app:AppTexts.WaitingSkipHint}" />
            </Button>
            <Button Classes="plain" Command="{Binding CloseCommand}">
              <ctl:KeyHint Pad="B" Keys="Esc" Text="{Binding BackHint}" />
            </Button>
            <Button Classes="plain" Command="{Binding AcceptCommand}" IsVisible="{Binding HasGames}">
              <ctl:KeyHint Pad="A" Keys="Leertaste" Text="{Binding AcceptHint}" />
            </Button>
          </StackPanel>
        </Border>

        <Panel>
          <Grid ColumnDefinitions="440,*" Margin="0,28,0,0" IsVisible="{Binding HasGames}">
            <!-- The games: a click makes one current. Scroll bar and fade as the settings rows when they don't fit. -->
            <Border Classes="waitingGames">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="artworkLabel" Text="{Binding GamesHeading}" />
                <Panel>
                  <ScrollViewer Name="GameScroller" Classes="waitingScroller" Padding="4">
                    <!-- Virtualised: a long list draws only the games in sight. -->
                    <ItemsControl Name="GameList" ItemsSource="{Binding Games}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:WaitingGameViewModel">
                          <Button Classes="plain waitingGame" Classes.current="{Binding IsCurrent}" Command="{Binding PickCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                              <Border Classes="waitingMonogram">
                                <TextBlock Text="{Binding Monogram}" />
                              </Border>
                              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Classes="waitingGameName" Text="{Binding Title}" ToolTip.Tip="{Binding Title}" />
                                <TextBlock Classes="waitingGameLauncher" Text="{Binding LauncherName}" />
                              </StackPanel>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <ctl:EdgeFade Name="GameFade" Size="64" FocusRoom="8" FadeColor="{StaticResource ModalSurfaceColor}" ScrollTarget="{Binding #GameScroller}" />
                </Panel>
              </DockPanel>
            </Border>

            <!-- The current game's hits: what is sought, the own search term, the grid of hits with an image. -->
            <DockPanel Grid.Column="1" Margin="40,0,0,0" DataContext="{Binding Hits}" x:DataType="vm:WaitingHitsViewModel">
              <StackPanel DockPanel.Dock="Top">
                <TextBlock Classes="waitingCurrent" Text="{Binding Title}" />
                <TextBlock Classes="waitingSought" Text="{Binding SoughtText}" />
                <TextBlock Classes="waitingIntro" Text="{Binding Intro}" IsVisible="{Binding HasIntro}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" Margin="0,0,0,20">
                  <Button Classes="plain waitingTermButton" Command="{Binding EditTermCommand}">
                    <Border Classes="textField waitingTerm" Classes.focused="{Binding IsTermFocused}" Classes.editing="{Binding IsEditing}"
                            Classes.problem="{Binding Editor?.HasProblem, TargetNullValue=False}">
                      <StackPanel Orientation="Horizontal" Spacing="14" ClipToBounds="True">
                        <TextBlock Classes="fieldPrefix" Text="{x:Static app:AppTexts.WaitingTerm}" />
                        <TextBlock Classes="fieldText" Text="{Binding Term}" IsVisible="{Binding !IsEditing}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" IsVisible="{Binding IsEditing}">
                          <TextBlock Classes="fieldText" Text="{Binding Editor?.TextBeforeCaret, TargetNullValue=''}" />
                          <Border Classes="caret fieldCaret" />
                          <TextBlock Classes="fieldText" Text="{Binding Editor?.TextAfterCaret, TargetNullValue=''}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </Button>
                  <Button Grid.Column="1" Classes="plain artworkNoticeButton waitingReset" Classes.focused="{Binding IsResetFocused}"
                          Classes.off="{Binding !CanReset}" Command="{Binding ResetCommand}" Content="{x:Static app:AppTexts.WaitingReset}" />
                </Grid>
              </StackPanel>

              <Border DockPanel.Dock="Bottom" Classes="waitingNote">
                <TextBlock Text="{Binding Note}" />
              </Border>

              <Panel>
                <ScrollViewer Name="HitScroller" Classes="waitingScroller" Padding="8">
                  <ItemsControl Name="HitGrid" ItemsSource="{Binding Hits}" Classes.hero="{Binding IsHero}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding $parent[ItemsControl].((vm:WaitingHitsViewModel)DataContext)?.Columns, TargetNullValue=6}" HorizontalAlignment="Left" VerticalAlignment="Top" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WaitingHitViewModel">
                        <Button Classes="plain artworkTile waitingHit" Classes.focused="{Binding IsFocused}" Command="{Binding PickCommand}"
                                ToolTip.Tip="{Binding Name}">
                          <StackPanel Spacing="4">
                            <Border Classes="artworkFrame">
                              <Panel>
                                <TextBlock Classes="waitingHitPlaceholder" Text="{Binding Name}" IsVisible="{Binding !#HitImage.IsShowing}" />
                                <ctl:ArtworkImage Name="HitImage" File="{Binding Image}" CornerRadius="12" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
                              </Panel>
                            </Border>
                            <TextBlock Classes="waitingHitName" Text="{Binding Name}" />
                            <TextBlock Classes="waitingHitYear" Text="{Binding YearText}" IsVisible="{Binding HasYear}" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <ctl:EdgeFade Name="HitFade" Size="48" FocusRoom="8" FadeColor="{StaticResource ModalSurfaceColor}" ScrollTarget="{Binding #HitScroller}" />
                <!-- Why the grid is empty, or that the hits are being checked. -->
                <TextBlock Classes="waitingStatus" Text="{x:Static app:AppTexts.WaitingChecking}" IsVisible="{Binding IsChecking}" />
                <TextBlock Classes="waitingStatus" Text="{Binding Message}" IsVisible="{Binding HasMessage}" />
              </Panel>
            </DockPanel>
          </Grid>

          <!-- After the last game. -->
          <StackPanel Classes="waitingDone" IsVisible="{Binding IsDone}">
            <TextBlock Classes="waitingDoneTitle" Text="{x:Static app:AppTexts.WaitingDoneTitle}" />
            <TextBlock Classes="waitingDoneText" Text="{x:Static app:AppTexts.WaitingDoneText}" />
          </StackPanel>
        </Panel>
      </DockPanel>
    </Border>

    <!-- The on-screen keyboard while "Eigener Suchbegriff" is written: the settings' keyboard, as in the settings. -->
    <ctl:RevealPanel Classes="keyboardDrawer bleed" Classes.out="{Binding Hits?.IsEditing, TargetNullValue=False}" VerticalAlignment="Bottom"
                     IsVisible="{Binding Hits?.IsEditing, TargetNullValue=False}">
      <Border Background="{StaticResource KeyboardSurface}" BorderBrush="{StaticResource SurfaceRaised}" BorderThickness="0,1,0,0" Padding="0,20,0,14">
        <views:OnScreenKeyboardView DataContext="{Binding Hits?.Editor?.Keyboard}" HorizontalAlignment="Center" />
      </Border>
    </ctl:RevealPanel>
  </Panel>
</UserControl>
