<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pan, Arcadia's guardian (#243): a small Windows service that gives the real controllers back to every program
    when Arcadia ends unexpectedly or hangs. Built as Native AOT (small, no runtime needed, nothing extracted to a
    temp folder) by tools/release/Pack.ps1 (dotnet publish -r win-x64); a plain build gives the framework-dependent exe the
    tests drive. The decisions are in Arcadia.Pan.Core, this project holds the Windows adapters and the commands.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Pan</AssemblyName>
    <RootNamespace>Arcadia.Pan</RootNamespace>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Arcadia Pan</Product>
    <AssemblyTitle>Pan - Arcadias Guardian</AssemblyTitle>
  </PropertyGroup>

  <!--
    Pan runs for hours beside a game, so it keeps its memory small (#360): the GC collects gen 0 after this many bytes.
    Without it the budget follows the CPU's L3 cache (about half of it, 16 MB with 32 MB of L3), so Pan's heartbeat
    garbage piled up to that size before the first collection; Pan's live data is tiny and a gen-0 collection of it
    costs microseconds. Read by Native AOT (a runtime knob) and by the framework-dependent Debug build (runtimeconfig).
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="2097152" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arcadia.Pan.Core\Arcadia.Pan.Core.csproj" />
  </ItemGroup>

</Project>
