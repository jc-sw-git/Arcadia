<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:Arcadia.App"
             xmlns:vm="using:Arcadia.App.ViewModels"
             xmlns:ctl="using:Arcadia.App.Controls"
             x:Class="Arcadia.App.Views.ChangeArtworkView"
             x:DataType="vm:ChangeArtworkViewModel">

  <!-- "Artwork ändern" (#490, prototype in #13): left the game as the detail page shows it with the part being changed
       marked and where its image came from, right the tiles to choose from. -->
  <Panel>
    <Button Classes="plain bleedAll" Background="{StaticResource Scrim}" Cursor="Arrow" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
            Command="{Binding CloseCommand}" />
    <Border Classes="artworkModal" Width="1600" Height="960" HorizontalAlignment="Center" VerticalAlignment="Center">
      <DockPanel>
        <!-- Header: icon, title, game, the tabs between LB and RB. -->
        <Grid DockPanel.Dock="Top" Height="64" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="18">
          <Border Classes="promptIcon">
            <Path Classes="artworkIcon" />
          </Border>
          <TextBlock Grid.Column="1" Text="{x:Static vm:ChangeArtworkViewModel.Title}" FontSize="30" FontWeight="ExtraBold" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Classes="artworkGame" Text="{Binding GameLine}" />
          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="plain glyphButton keycap" Classes.kbd="{Binding !$parent[Window].((vm:MainViewModel)DataContext)?.Input.UsesController, TargetNullValue=False}"
                    VerticalAlignment="Center" Command="{Binding OtherTabCommand}">
              <ctl:KeyText Pad="LB" Keys="⇧ Q" />
            </Button>
            <Button Classes="plain artworkTab" VerticalAlignment="Center" Classes.selected="{Binding IsCoverTab}" Content="{x:Static app:AppTexts.ArtworkTabCover}" Command="{Binding ShowCoverCommand}" />
            <Button Classes="plain artworkTab" VerticalAlignment="Center" Classes.selected="{Binding IsHeroTab}" Content="{x:Static app:AppTexts.ArtworkTabHero}" Command="{Binding ShowHeroCommand}" />
            <Button Classes="plain glyphButton keycap" Classes.kbd="{Binding !$parent[Window].((vm:MainViewModel)DataContext)?.Input.UsesController, TargetNullValue=False}"
                    VerticalAlignment="Center" Command="{Binding OtherTabCommand}">
              <ctl:KeyText Pad="RB" Keys="⇧ E" />
            </Button>
          </StackPanel>
          <Button Grid.Column="5" Classes="plain dialogClose" Margin="8,0,-22,0" VerticalAlignment="Top" ToolTip.Tip="{x:Static app:AppTexts.Close}"
                  IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.Input.ShowsCloseButtons, TargetNullValue=False}" Command="{Binding CloseCommand}">
            <Path Data="M1 1L13 13M13 1L1 13" StrokeThickness="2.5" StrokeLineCap="Round" Width="14" Height="14" Stretch="None" />
          </Button>
        </Grid>

        <!-- Footer: what the buttons do; X and Y only where they do something, Y greyed out while the image is automatic. -->
        <Border DockPanel.Dock="Bottom" Classes="artworkFooter">
          <StackPanel Orientation="Horizontal" Spacing="30" HorizontalAlignment="Right" VerticalAlignment="Center">
            <ctl:KeyHint Pad="LB|RB" Keys="⇧ Q|⇧ E" Text="{x:Static app:AppTexts.ArtworkTabsHint}" />
            <ctl:KeyHint Pad="D-Pad" Keys="WASD" Text="{x:Static app:AppTexts.ArtworkChooseHint}" />
            <ctl:KeyHint Pad="A" Keys="{x:Static app:AppTexts.KeySpace}" Text="{x:Static app:AppTexts.ArtworkUseHint}" />
            <Button Classes="plain" Command="{Binding PickOtherFileCommand}" IsVisible="{Binding CanPickOtherFile}">
              <ctl:KeyHint Pad="X" Keys="F" Text="{x:Static app:AppTexts.ArtworkOtherFileHint}" />
            </Button>
            <Button Classes="plain artworkRestore" Classes.off="{Binding !CanRestore}" Command="{Binding RestoreCommand}">
              <ctl:KeyHint Pad="Y" Keys="V" Text="{x:Static app:AppTexts.ArtworkRestoreHint}" />
            </Button>
            <Button Classes="plain" Command="{Binding CloseCommand}">
              <ctl:KeyHint Pad="B" Keys="{x:Static app:AppTexts.KeyEscape}" Text="{x:Static app:AppTexts.Close}" />
            </Button>
          </StackPanel>
        </Border>

        <Grid ColumnDefinitions="620,*" ColumnSpacing="48" Margin="0,28,0,0">
          <!-- The preview: the detail page in small, the part being changed marked. -->
          <StackPanel>
            <TextBlock Classes="artworkLabel" Text="{x:Static app:AppTexts.ArtworkPreviewHeading}" />
            <!-- Drawn in the detail page's own 1920 × 1080 places (GameDetailView) and scaled down, so it shows the page as
                 it is: the background over the whole page under its scrims, the cover beside title and buttons, the stacks
                 to the sides and the panel below. -->
            <Border Classes="artworkMini" Width="620" Height="349">
              <Viewbox Stretch="Uniform">
                <Canvas Width="1920" Height="1080" Background="{Binding HeroBackdrop}">
                  <ctl:ArtworkImage Width="1920" Height="1080" Fit="DetailPage" File="{Binding Tile.Hero}" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
                  <Border Width="1920" Height="440" Background="{StaticResource DetailScrimTitle}" />
                  <Border Width="1920" Height="110" Background="{StaticResource DetailScrimTop}" />
                  <Border Canvas.Top="1000" Width="1920" Height="80" Background="{StaticResource DetailScrimBottom}" />
                  <Border Classes="artworkMark hero" Width="1920" Height="1080" IsVisible="{Binding IsCurrentHeroMarked}" />

                  <Border Classes="artworkMiniStack" Canvas.Left="40" />
                  <Border Classes="artworkMiniStack" Canvas.Left="1736" />
                  <Border Classes="artworkMiniPanel" Canvas.Left="260" Canvas.Top="424" Width="1400" Height="572">
                    <StackPanel Margin="14" Spacing="12" Width="300" HorizontalAlignment="Left">
                      <Border Classes="artworkMiniRow selected" />
                      <Border Classes="artworkMiniRow" />
                      <Border Classes="artworkMiniRow" />
                      <Border Classes="artworkMiniRow" />
                    </StackPanel>
                  </Border>

                  <Border Classes="artworkMiniCover" Canvas.Left="280" Canvas.Top="116" Background="{Binding Tile.CoverBrush}">
                    <Panel>
                      <ctl:ArtworkImage Name="MiniCover" File="{Binding Tile.Cover}" CornerRadius="12" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
                      <TextBlock Classes="artworkMonogram" Text="{Binding Tile.Monogram}" Foreground="{Binding Tile.AccentBrush}" IsVisible="{Binding !#MiniCover.IsShowing}" />
                    </Panel>
                  </Border>
                  <Border Classes="artworkMark cover" Canvas.Left="262" Canvas.Top="98" IsVisible="{Binding IsCurrentCoverMarked}" />

                  <StackPanel Canvas.Left="496" Canvas.Top="116" Width="1164" Spacing="18">
                    <Border Classes="artworkMiniChip" />
                    <TextBlock Classes="artworkMiniTitle" Text="{Binding Tile.Title}" />
                    <Border Classes="artworkMiniLine" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,10,0,0">
                      <Border Classes="artworkMiniAction accent" Width="240" />
                      <Border Classes="artworkMiniAction" Width="230" />
                      <Border Classes="artworkMiniAction" Width="290" />
                    </StackPanel>
                  </StackPanel>
                </Canvas>
              </Viewbox>
            </Border>
            <Border Classes="artworkFacts">
              <ItemsControl ItemsSource="{Binding Facts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ArtworkFactViewModel">
                    <DockPanel Classes="artworkFact">
                      <TextBlock Classes="artworkFactLabel" Text="{Binding Label}" />
                      <TextBlock Classes="artworkFactValue" Text="{Binding Value}" />
                    </DockPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
          </StackPanel>

          <!-- The tiles: "Eigene Datei", the launcher's image, the suggestions, then the notice without a key. -->
          <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Classes="artworkLabel" Text="{Binding GridHeading}" />
            <Panel>
              <!-- While the images are looked for: frames that light up one after the other under a magnifier going to and
                   fro, and a text that changes at random. -->
              <StackPanel Classes="artworkLoading" IsVisible="{Binding IsLoading}">
                <Canvas Width="300" Height="150">
                  <Border Classes="artworkLoadingFrame first" Canvas.Left="0" Canvas.Top="20" />
                  <Border Classes="artworkLoadingFrame second" Canvas.Left="106" Canvas.Top="20" />
                  <Border Classes="artworkLoadingFrame third" Canvas.Left="212" Canvas.Top="20" />
                  <Path Classes="artworkLoadingGlass" Canvas.Top="40" />
                </Canvas>
                <TextBlock Classes="artworkLoadingText" Text="{Binding LoadingText}" />
              </StackPanel>
              <ScrollViewer Name="TileScroller" VerticalScrollBarVisibility="Hidden" Padding="8" Margin="-8">
                <ItemsControl Name="TileList" ItemsSource="{Binding GridItems}" Classes.hero="{Binding IsHeroTab}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel ItemSpacing="20" LineSpacing="22" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.DataTemplates>
                    <DataTemplate x:DataType="vm:ArtworkTileViewModel">
                      <Button Classes="plain artworkTile" Classes.focused="{Binding IsFocused}" Command="{Binding PickCommand}">
                        <StackPanel Spacing="8">
                          <Border Classes="artworkFrame">
                            <Panel>
                              <ctl:ArtworkImage File="{Binding File}" CornerRadius="12" Loader="{Binding $parent[Window].((vm:MainViewModel)DataContext)?.ArtworkLoader}" />
                              <Border Classes="artworkOwnEmpty" IsVisible="{Binding IsEmptyOwnFile}">
                                <StackPanel Classes="artworkOwnContent">
                                  <Path Classes="artworkFolderIcon" />
                                  <TextBlock Classes="artworkOwnLabel" Text="{x:Static vm:ArtworkTileViewModel.OwnFileLabel}" />
                                </StackPanel>
                              </Border>
                              <Border Classes="artworkTag" IsVisible="{Binding HasTag}">
                                <TextBlock Text="{Binding Tag}" />
                              </Border>
                              <Border Classes="artworkTick" IsVisible="{Binding IsInUse}">
                                <Path Classes="artworkTickMark" />
                              </Border>
                            </Panel>
                          </Border>
                          <TextBlock Classes="artworkCaption" Text="{Binding Caption}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                    <DataTemplate x:DataType="vm:ArtworkNoticeViewModel">
                      <Border Classes="artworkNotice">
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                          <TextBlock Classes="artworkNoticeTitle" Text="{Binding Title}" />
                          <TextBlock Classes="artworkNoticeText" Text="{Binding Text}" />
                          <Button Classes="plain artworkNoticeButton" Classes.focused="{Binding IsFocused}" HorizontalAlignment="Left"
                                  Content="{x:Static vm:ArtworkNoticeViewModel.ButtonText}" Command="{Binding OpenDataSourcesCommand}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.DataTemplates>
                </ItemsControl>
              </ScrollViewer>
              <!-- Where more tiles follow, the grid fades into the modal (docs/product/design.md → Scrolling). -->
              <ctl:EdgeFade Name="TileFade" Margin="-8" Size="48" FocusRoom="8" FadeColor="{StaticResource ModalSurfaceColor}" ScrollTarget="{Binding #TileScroller}" />
            </Panel>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
  </Panel>
</UserControl>
