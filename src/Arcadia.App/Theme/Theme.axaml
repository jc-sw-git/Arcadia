  <!-- "Artwork ändern" (#490, prototype in #13). Tiles fill the grid's 852 px: five covers (2 : 3) or two backgrounds
       (3.1 : 1) a row; the notice spans three covers or the whole row. -->
  <Style Selector="Border.artworkModal">
    <Setter Property="Background" Value="{StaticResource DetailSurface}" />
