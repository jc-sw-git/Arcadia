<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 test projects are programs of their own. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- SDL3 as a test sets it up, shared with the unit tests of the gamepad source. -->
    <Compile Include="..\Arcadia.Core.Tests\FakeSdlGamepads.cs" Link="FakeSdlGamepads.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeVirtualXboxPads.cs" Link="FakeVirtualXboxPads.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeEmulationGuardian.cs" Link="FakeEmulationGuardian.cs" />
    <Compile Include="..\Arcadia.Core.Tests\FakeSteamControllerHold.cs" Link="FakeSteamControllerHold.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Arcadia.App\Arcadia.App.csproj" />
  </ItemGroup>

</Project>
