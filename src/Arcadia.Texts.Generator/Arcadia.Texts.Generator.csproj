<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the typed access to a project's *Texts.resx (#480): a property per plain text, a method per text with
    placeholders, both reading through UiText. A Roslyn source generator, so it runs in every dotnet build on every
    platform, without a Visual Studio code generator.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <ImplicitUsings>disable</ImplicitUsings>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Release tracking is for analyzers shipped as packages; this one only runs inside the solution. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
